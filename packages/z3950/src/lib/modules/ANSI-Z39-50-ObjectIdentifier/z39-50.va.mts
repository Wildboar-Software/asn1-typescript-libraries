import {
    ObjectIdentifier as _OID,
    OBJECT_IDENTIFIER
} from "@wildboar/asn1";



/**
 * @summary z39_50
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * z39-50 OBJECT IDENTIFIER ::= { iso (1) member-body (2) us (840) ansi-standard-Z39-50 (10003)}
 * ```
 * 
 * @constant
 */
export
const z39_50: OBJECT_IDENTIFIER = _OID.fromParts([
    /* iso */ 1,
    /* member-body */ 2,
    /* us */ 840,
    /* ansi-standard-Z39-50 */ 10003,
]);

/* eslint-enable */
