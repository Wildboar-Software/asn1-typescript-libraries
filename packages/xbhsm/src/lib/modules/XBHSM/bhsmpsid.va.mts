import { OBJECT_IDENTIFIER, ObjectIdentifier as _OID } from "@wildboar/asn1";

/**
 * @summary bhsmpsid
 * @description
 *
 * ### ASN.1 Definition:
 *
 * ```asn1
 * bhsmpsid  OBJECT IDENTIFIER ::= {iso(1) standard(0) bhsm(17922) contentType(2) bhsmps(1)}
 * ```
 *
 * @constant
 */
export const bhsmpsid: OBJECT_IDENTIFIER = _OID.fromParts([
    /* iso */ 1,
    /* standard */ 0,
    /* bhsm */ 17922,
    /* contentType */ 2,
    /* bhsmps */ 1,
]);

/* eslint-enable */
