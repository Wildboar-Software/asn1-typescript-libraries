{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "types": [
      "node"
    ],
    "strict": true,
    "strictNullChecks": true,
    "rootDir": "."
  },
  "exclude": [
    "**/*.spec.mts",
    "**/*.test.mts",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts"
  ],
  "include": [
    "**/*.mts"
  ],
  "references": []
}
