{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "declaration": true,
    "types": [
      "node"
    ],
    "strictNullChecks": false,
    "rootDir": "."
  },
  "exclude": [
    "**/*.spec.mts",
    "**/*.test.mts",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts"
  ],
  "include": [
    "**/*.mts"
  ]
}
