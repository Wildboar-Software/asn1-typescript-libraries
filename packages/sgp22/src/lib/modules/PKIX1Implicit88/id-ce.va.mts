/* eslint-disable */
import {
    ObjectIdentifier as _OID,
    OBJECT_IDENTIFIER
} from "@wildboar/asn1";



/**
 * @summary id_ce
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * id-ce OBJECT IDENTIFIER ::= {joint-iso-ccitt(2) ds(5) 29}
 * ```
 * 
 * @constant
 */
export
const id_ce: OBJECT_IDENTIFIER = _OID.fromParts([
    /* joint-iso-ccitt */ 2,
    /* ds */ 5,
    29,
]);

/* eslint-enable */
