import {
    ObjectIdentifier as _OID,
    OBJECT_IDENTIFIER
} from "@wildboar/asn1";



/**
 * @summary id_rsp
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * id-rsp OBJECT IDENTIFIER ::= {joint-iso-itu-t(2) international-organizations(23) gsma(146) rsp(1)}
 * ```
 * 
 * @constant
 */
export
const id_rsp: OBJECT_IDENTIFIER = _OID.fromParts([
    /* joint-iso-itu-t */ 2,
    /* international-organizations */ 23,
    /* gsma */ 146,
    /* rsp */ 1,
]);

