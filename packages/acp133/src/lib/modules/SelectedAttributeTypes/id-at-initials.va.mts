/* eslint-disable */
import {
    ObjectIdentifier as _OID,
    OBJECT_IDENTIFIER
} from "@wildboar/asn1";



/**
 * @summary id_at_initials
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * id-at-initials                            OBJECT IDENTIFIER ::= {id-at 43}
 * ```
 * 
 * @constant
 */
export
const id_at_initials: OBJECT_IDENTIFIER = _OID.fromParts([
    43,
], id_at);

/* eslint-enable */
