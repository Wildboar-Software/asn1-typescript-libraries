import {
    ObjectIdentifier as _OID,
    OBJECT_IDENTIFIER
} from "@wildboar/asn1";



/**
 * @summary id_coat_uid
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * id-coat-uid                               OBJECT IDENTIFIER ::= {id-coat 1}
 * ```
