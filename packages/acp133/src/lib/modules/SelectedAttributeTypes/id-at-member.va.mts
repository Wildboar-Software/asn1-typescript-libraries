import {
    ObjectIdentifier as _OID,
    OBJECT_IDENTIFIER
} from "@wildboar/asn1";



/**
 * @summary id_at_member
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * id-at-member                              OBJECT IDENTIFIER ::= {id-at 31}
 * ```
 * 
 * @constant
 */
export
const id_at_member: OBJECT_IDENTIFIER = _OID.fromParts([
    31,
], id_at);

