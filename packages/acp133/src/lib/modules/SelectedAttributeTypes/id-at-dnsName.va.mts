/* eslint-disable */
import {
    ObjectIdentifier as _OID,
    OBJECT_IDENTIFIER
} from "@wildboar/asn1";



/**
 * @summary id_at_dnsName
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * id-at-dnsName                             OBJECT IDENTIFIER ::= {id-at 100}
 * ```
 * 
 * @constant
 */
export
const id_at_dnsName: OBJECT_IDENTIFIER = _OID.fromParts([
    100,
], id_at);

/* eslint-enable */
