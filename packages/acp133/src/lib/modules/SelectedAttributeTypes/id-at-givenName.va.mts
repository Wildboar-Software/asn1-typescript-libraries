import {
    ObjectIdentifier as _OID,
    OBJECT_IDENTIFIER
} from "@wildboar/asn1";



/**
 * @summary id_at_givenName
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * id-at-givenName                           OBJECT IDENTIFIER ::= {id-at 42}
 * ```
 * 
 * @constant
 */
export
const id_at_givenName: OBJECT_IDENTIFIER = _OID.fromParts([
    42,
], id_at);

