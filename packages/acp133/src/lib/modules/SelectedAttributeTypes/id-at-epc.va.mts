import {
    ObjectIdentifier as _OID,
    OBJECT_IDENTIFIER
} from "@wildboar/asn1";



/**
 * @summary id_at_epc
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * id-at-epc                                 OBJECT IDENTIFIER ::= {id-at 91}
 * ```
 * 
 * @constant
 */
export
const id_at_epc: OBJECT_IDENTIFIER = _OID.fromParts([
    91,
], id_at);

