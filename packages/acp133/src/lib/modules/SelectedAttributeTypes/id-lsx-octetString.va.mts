    OBJECT_IDENTIFIER
} from "@wildboar/asn1";



/**
 * @summary id_lsx_octetString
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * id-lsx-octetString                        OBJECT IDENTIFIER ::= {id-lsx 40}
 * ```
