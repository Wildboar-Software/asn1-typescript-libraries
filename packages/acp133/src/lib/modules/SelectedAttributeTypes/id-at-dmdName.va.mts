import {
    ObjectIdentifier as _OID,
    OBJECT_IDENTIFIER
} from "@wildboar/asn1";



/**
 * @summary id_at_dmdName
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * id-at-dmdName                             OBJECT IDENTIFIER ::= {id-at 54}
 * ```
 * 
 * @constant
 */
export
const id_at_dmdName: OBJECT_IDENTIFIER = _OID.fromParts([
    54,
], id_at);

