/* eslint-disable */
import { ObjectIdentifier as _OID, OBJECT_IDENTIFIER } from "@wildboar/asn1";

/**
 * @summary ansi_X9_62
 * @description
 *
 * Root of all OIDs defined in this Standard:
 * `{iso(1) member-body(2) us(840) 10045}`.
 * ANSI X9.62-1998 §6 (before §6.1).
 *
 * ### ASN.1 Definition:
 *
 * ```asn1
 * ansi-X9-62 OBJECT IDENTIFIER ::= { iso(1) member-body(2) us(840) 10045 }
 * ```
 *
 * @constant
 */
export const ansi_X9_62: OBJECT_IDENTIFIER = _OID.fromParts([
    /* iso */ 1,
    /* member-body */ 2,
    /* us */ 840,
    10045,
]);

/* eslint-enable */
