IPBinV6AddressWithPrefixLength ::= SEQUENCE {
   iPBinV6Address           OCTET STRING ( SIZE( 16 ) ),
   pDPAddressPrefixLength   INTEGER ( 1 .. 64 ) DEFAULT 64}

InterOperatorIdentifiers ::= SEQUENCE {
   originatingIOI   [0] IMPLICIT GraphicString OPTIONAL,
   terminatingIOI   [1] IMPLICIT GraphicString OPTIONAL}

AccessCorrelationID ::= CHOICE {
   gPRS-Charging-Id                    [2] IMPLICIT INTEGER ( 0 .. 4294967295 ),
   accessNetworkChargingIdentifier     [4] IMPLICIT GraphicString}

IPTextRepresentedAddress ::= CHOICE {
   iPTextV4Address     [2] IMPLICIT IA5String  ( SIZE( 7 .. 15 ) ),
   iPTextV6Address     [3] IMPLICIT IA5String  ( SIZE( 15 .. 45 ) )}

IPBinV6AddressWithOrWithoutPrefixLength ::= CHOICE {
   iPBinV6Address               [1] IMPLICIT OCTET STRING ( SIZE( 16 ) ),
   iPBinV6AddressWithPrefix     [4] IMPLICIT IPBinV6AddressWithPrefixLength}

IPBinaryAddress ::= CHOICE {
   iPBinV4Address     [0] IMPLICIT OCTET STRING ( SIZE( 4 ) ),
   iPBinV6Address     IPBinV6AddressWithOrWithoutPrefixLength}

IPAddress ::= CHOICE {
   iPBinaryAddress              IPBinaryAddress,
   iPTextRepresentedAddress     IPTextRepresentedAddress}

NodeAddress ::= CHOICE {
   iPAddress      [0] IPAddress,
   domainName     [1] IMPLICIT GraphicString}

InvolvedParty ::= CHOICE {
   sIP-URI       [0] IMPLICIT GraphicString,
   tEL-URI       [1] IMPLICIT GraphicString,
   uRN           [2] IMPLICIT GraphicString,
   iSDN-E164     [3] IMPLICIT GraphicString}

Incomplete-CDR-Indication ::= SET {
   aCRStartLost     [0] IMPLICIT BOOLEAN,
   aCRInterimLost   [1] IMPLICIT ENUMERATED {
      no          ( 0 ),
      yes         ( 1 ),
      unknown     ( 2 ) },
   aCRStopLost      [2] IMPLICIT BOOLEAN}

List-Of-Message-Bodies ::= SEQUENCE {
   content-Type          [0] IMPLICIT GraphicString,
   content-Disposition   [1] IMPLICIT GraphicString OPTIONAL,
   content-Length        [2] IMPLICIT INTEGER,
   originator            [3] InvolvedParty OPTIONAL}

ManagementExtension ::= SEQUENCE {
   identifier     DMI-EXTENSION.&id ({ManagementExtensionSet}) ,
   significance   [1] IMPLICIT BOOLEAN DEFAULT FALSE,
   information    [2] DMI-EXTENSION.&Value ({ManagementExtensionSet}{@.identifier}) }

SDP-Media-Components ::= SEQUENCE {
   sDP-Media-Name                 [0] IMPLICIT GraphicString OPTIONAL,
   sDP-Media-Descriptions         [1] IMPLICIT SEQUENCE  OF
      GraphicString OPTIONAL,
   accessCorrelationID            AccessCorrelationID OPTIONAL,
   localGWInsertedIndication      [5] IMPLICIT BOOLEAN OPTIONAL,
   iPRealmDefaultIndication       [6] IMPLICIT BOOLEAN OPTIONAL,
   transcoderInsertedIndication   [7] IMPLICIT BOOLEAN OPTIONAL}

List-Of-SDP-Media-Components ::= SEQUENCE {
   sIP-Request-Timestamp             [0] IMPLICIT OCTET STRING ( SIZE( 9 ) ) OPTIONAL,
   sIP-Response-Timestamp            [1] IMPLICIT OCTET STRING ( SIZE( 9 ) ) OPTIONAL,
   sDP-Media-Components              [2] IMPLICIT SEQUENCE  OF
      SDP-Media-Components OPTIONAL,
   mediaInitiatorFlag                [3] IMPLICIT NULL OPTIONAL,
   sDP-Session-Description           [4] IMPLICIT SEQUENCE  OF
      GraphicString OPTIONAL,
   mediaInitiatorParty               [5] InvolvedParty OPTIONAL,
   sIP-Request-Timestamp-Fraction    [6] IMPLICIT INTEGER ( 0 .. 999 ) OPTIONAL,
   sIP-Response-Timestamp-Fraction   [7] IMPLICIT INTEGER ( 0 .. 999 ) OPTIONAL,
   sDP-Type                          [8] IMPLICIT ENUMERATED {
      sDP-offer     ( 0 ),
      sDP-answer    ( 1 ) } OPTIONAL}

POCRecord  ::= CHOICE {
   pPFRecord     [80] IMPLICIT PPFRecord,
   cPFRecord     [81] IMPLICIT CPFRecord}

PPFRecord  ::= SET {
   recordType                      [0] IMPLICIT RecordType,
   retransmission                  [1] IMPLICIT NULL OPTIONAL,
   sIP-Method                      [2] IMPLICIT GraphicString OPTIONAL,
   nodeAddress                     [3] NodeAddress OPTIONAL,
   session-Id                      [4] IMPLICIT GraphicString OPTIONAL,
   calling-Party-Address           [5] InvolvedParty OPTIONAL,
   called-Party-Address            [6] InvolvedParty OPTIONAL,
   servedParty                     [7] IMPLICIT GraphicString OPTIONAL,
   serviceRequestTimeStamp         [8] IMPLICIT OCTET STRING ( SIZE( 9 ) ) OPTIONAL,
   serviceDeliveryStartTimeStamp   [9] IMPLICIT OCTET STRING ( SIZE( 9 ) ) OPTIONAL,
   serviceDeliveryEndTimeStamp     [10] IMPLICIT OCTET STRING ( SIZE( 9 ) ) OPTIONAL,
   recordOpeningTime               [11] IMPLICIT OCTET STRING ( SIZE( 9 ) ) OPTIONAL,
   recordClosureTime               [12] IMPLICIT OCTET STRING ( SIZE( 9 ) ) OPTIONAL,
   interOperatorIdentifiers        [13] IMPLICIT InterOperatorIdentifiers OPTIONAL,
   localRecordSequenceNumber       [14] IMPLICIT INTEGER ( 0 .. 4294967295 ) OPTIONAL,
   recordSequenceNumber            [15] IMPLICIT INTEGER OPTIONAL,
   causeForRecordClosing           [16] IMPLICIT CauseForRecordClosing OPTIONAL,
   incomplete-CDR-Indication       [17] IMPLICIT Incomplete-CDR-Indication OPTIONAL,
   iMS-Charging-Identifier         [18] IMPLICIT OCTET STRING OPTIONAL,
   list-Of-SDP-Media-Components    [19] IMPLICIT SEQUENCE  OF
      List-Of-SDP-Media-Components OPTIONAL,
   gGSNaddress                     [20] NodeAddress OPTIONAL,
   serviceReasonReturnCode         [21] IMPLICIT UTF8String OPTIONAL,
   list-Of-Message-Bodies          [22] IMPLICIT SEQUENCE  OF
      List-Of-Message-Bodies OPTIONAL,
   userLocationInfo                [23] IMPLICIT OCTET STRING OPTIONAL,
   poCInformation                  [24] IMPLICIT POCInformation OPTIONAL,
   recordExtensions                [25] IMPLICIT SET  OF
      ManagementExtension OPTIONAL,
   serviceContextID                [26] IMPLICIT UTF8String OPTIONAL}

CPFRecord  ::= SET {
   recordType                      [0] IMPLICIT RecordType,
   retransmission                  [1] IMPLICIT NULL OPTIONAL,
   sIP-Method                      [2] IMPLICIT GraphicString OPTIONAL,
   nodeAddress                     [3] NodeAddress OPTIONAL,
   session-Id                      [4] IMPLICIT GraphicString OPTIONAL,
   calling-Party-Address           [5] InvolvedParty OPTIONAL,
   called-Party-Address            [6] InvolvedParty OPTIONAL,
   servedParty                     [7] IMPLICIT GraphicString OPTIONAL,
   serviceRequestTimeStamp         [8] IMPLICIT OCTET STRING ( SIZE( 9 ) ) OPTIONAL,
   serviceDeliveryStartTimeStamp   [9] IMPLICIT OCTET STRING ( SIZE( 9 ) ) OPTIONAL,
   serviceDeliveryEndTimeStamp     [10] IMPLICIT OCTET STRING ( SIZE( 9 ) ) OPTIONAL,
   recordOpeningTime               [11] IMPLICIT OCTET STRING ( SIZE( 9 ) ) OPTIONAL,
   recordClosureTime               [12] IMPLICIT OCTET STRING ( SIZE( 9 ) ) OPTIONAL,
   interOperatorIdentifiers        [13] IMPLICIT InterOperatorIdentifiers OPTIONAL,
   localRecordSequenceNumber       [14] IMPLICIT INTEGER ( 0 .. 4294967295 ) OPTIONAL,
   recordSequenceNumber            [15] IMPLICIT INTEGER OPTIONAL,
   causeForRecordClosing           [16] IMPLICIT CauseForRecordClosing OPTIONAL,
   incomplete-CDR-Indication       [17] IMPLICIT Incomplete-CDR-Indication OPTIONAL,
   iMS-Charging-Identifier         [18] IMPLICIT OCTET STRING OPTIONAL,
   list-Of-SDP-Media-Components    [19] IMPLICIT SEQUENCE  OF
      List-Of-SDP-Media-Components OPTIONAL,
   gGSNaddress                     [20] NodeAddress OPTIONAL,
   serviceReasonReturnCode         [21] IMPLICIT UTF8String OPTIONAL,
   list-Of-Message-Bodies          [22] IMPLICIT SEQUENCE  OF
      List-Of-Message-Bodies OPTIONAL,
   userLocationInfo                [23] IMPLICIT OCTET STRING OPTIONAL,
   poCInformation                  [24] IMPLICIT POCInformation OPTIONAL,
   recordExtensions                [25] IMPLICIT SET  OF
      ManagementExtension OPTIONAL,
   serviceContextID                [26] IMPLICIT UTF8String OPTIONAL}

AccessPriority ::= ENUMERATED {
   pre-emptive    ( 0 ),
   high           ( 1 ),
   normal         ( 2 ),
   low            ( 3 ) }

CauseForRecordClosing ::= ENUMERATED {
   normalRelease             ( 0 ),
   abnormalRelease           ( 1 ),
   serviceChange             ( 2 ),
   volumeLimit               ( 3 ),
   timeLimit                 ( 4 ),
   numberofTalkBurstLimit    ( 5 ),
   maxChangeCond             ( 6 ),
   sessionTypeChange         ( 7 ),
   managementIntervention    ( 8 ) }

ChangeCondition ::= ENUMERATED {
   serviceChange                 ( 0 ),
   volumeLimit                   ( 1 ),
   timeLimit                     ( 2 ),
   numberofTalkBurstLimit        ( 3 ),
   numberofActiveParticipants    ( 4 ),
   tariffTime                    ( 5 ) }

ListofTalkBurstExchange ::= SET {
   number-Of-Talk-Bursts            [1] IMPLICIT INTEGER OPTIONAL,
   talk-Burst-Volume                [2] IMPLICIT INTEGER OPTIONAL,
   talk-Bursts-Time                 [3] IMPLICIT INTEGER OPTIONAL,
   number-Of-Received-Talk-Bursts   [4] IMPLICIT INTEGER OPTIONAL,
   received-Talk-Burst-Volume       [5] IMPLICIT INTEGER OPTIONAL,
   received-Talk-Burst-Time         [6] IMPLICIT INTEGER OPTIONAL,
   changeCondition                  [7] IMPLICIT ChangeCondition OPTIONAL,
   changeTime                       [8] IMPLICIT OCTET STRING ( SIZE( 9 ) ),
   numberofParticipants             [9] IMPLICIT INTEGER OPTIONAL}

ParticipatingType ::= ENUMERATED {
   normal        ( 0 ),
   nW-PoC-Box    ( 1 ),
   uE-PoC-Box    ( 2 ) }

POCEventType ::= ENUMERATED {
   normal                   ( 0 ),
   instantPersonalAlert     ( 1 ),
   pOCGroupAdvertisement    ( 2 ),
   earlySessionSettingup    ( 3 ),
   pOCTalkBurst             ( 4 ) }

POCInformation ::= SET {
   pOCSessionType             [1] IMPLICIT POCSessionType OPTIONAL,
   numberofParticipants       [2] IMPLICIT INTEGER OPTIONAL,
   listofParticipants         [3] IMPLICIT SEQUENCE  OF
      POCParticipant OPTIONAL,
   listofTalkBurstExchange    [4] IMPLICIT SEQUENCE  OF
      ListofTalkBurstExchange OPTIONAL,
   pOCControllingAddress      [5] IMPLICIT UTF8String OPTIONAL,
   pOCGroupName               [6] IMPLICIT UTF8String OPTIONAL,
   pOCSessionId               [7] IMPLICIT UTF8String OPTIONAL,
   pOCSessionInitiationType   [8] IMPLICIT POCSessionInitType OPTIONAL,
   pOCEventType               [9] IMPLICIT POCEventType OPTIONAL}

POCParticipant ::= SET {
   called-party-address          [1] InvolvedParty,
   participant-access-priority   [2] IMPLICIT AccessPriority OPTIONAL,
   user-participating-type       [3] IMPLICIT ParticipatingType OPTIONAL}

POCSessionInitType ::= ENUMERATED {
   pre-established    ( 0 ),
   on-demand          ( 1 ) }

POCSessionType ::= ENUMERATED {
   one-to-one-session            ( 0 ),
   chat-group-session            ( 1 ),
   pre-arranged-group-session    ( 2 ),
   ad-hoc-group-session          ( 3 ) }


-- X.721 DMI-EXTENSION. The set is the standard form of the original
-- extensible empty table constraint ({, ...}) and does not change BER.
DMI-EXTENSION ::= CLASS {
    &id     OBJECT IDENTIFIER UNIQUE,
    &Value
}
WITH SYNTAX {
    TYPE &Value
    ID &id
}

ManagementExtensionSet DMI-EXTENSION ::= {...}

END
