   unauthorizedCallSessionRelatedExternalClient      ( 7 ) }

IPBinV6AddressWithPrefixLength ::= SEQUENCE {
   iPBinV6Address           OCTET STRING ( SIZE( 16 ) ),
   pDPAddressPrefixLength   INTEGER ( 1 .. 64 ) DEFAULT 64}

IPTextRepresentedAddress ::= CHOICE {
   iPTextV4Address     [2] IMPLICIT IA5String  ( SIZE( 7 .. 15 ) ),
   iPTextV6Address     [3] IMPLICIT IA5String  ( SIZE( 15 .. 45 ) )}

SMAddressDomain ::= SEQUENCE {
   sMDomainName           [0] IMPLICIT GraphicString OPTIONAL,
   threeGPPIMSI-MCC-MNC   [1] IMPLICIT OCTET STRING ( SIZE( 3 ) ) OPTIONAL}

IPBinV6AddressWithOrWithoutPrefixLength ::= CHOICE {
   iPBinV6Address               [1] IMPLICIT OCTET STRING ( SIZE( 16 ) ),
   iPBinV6AddressWithPrefix     [4] IMPLICIT IPBinV6AddressWithPrefixLength}

IPBinaryAddress ::= CHOICE {
   iPBinV4Address     [0] IMPLICIT OCTET STRING ( SIZE( 4 ) ),
   iPBinV6Address     IPBinV6AddressWithOrWithoutPrefixLength}

IPAddress ::= CHOICE {
   iPBinaryAddress              IPBinaryAddress,
   iPTextRepresentedAddress     IPTextRepresentedAddress}

NodeAddress ::= CHOICE {
   iPAddress      [0] IPAddress,
   domainName     [1] IMPLICIT GraphicString}

InvolvedParty ::= CHOICE {
   sIP-URI       [0] IMPLICIT GraphicString,
   tEL-URI       [1] IMPLICIT GraphicString,
   uRN           [2] IMPLICIT GraphicString,
   iSDN-E164     [3] IMPLICIT GraphicString}

SubscriberEquipmentNumber ::= SET {
   subscriberEquipmentNumberType   [0] IMPLICIT ENUMERATED {
      iMEISV           ( 0 ),
      mAC              ( 1 ),
      eUI64            ( 2 ),
      modifiedEUI64    ( 3 ) },
   subscriberEquipmentNumberData   [1] IMPLICIT OCTET STRING}

SubscriptionID ::= SET {
   subscriptionIDType   [0] IMPLICIT ENUMERATED {
      eND-USER-E164       ( 0 ),
      eND-USER-IMSI       ( 1 ),
      eND-USER-SIP-URI    ( 2 ),
      eND-USER-NAI        ( 3 ),
      eND-USER-PRIVATE    ( 4 ) },
   subscriptionIDData   [1] IMPLICIT UTF8String}

ManagementExtension ::= SEQUENCE {
   identifier     DMI-EXTENSION.&id ({ManagementExtensionSet}) ,
   significance   [1] IMPLICIT BOOLEAN DEFAULT FALSE,
   information    [2] DMI-EXTENSION.&Value ({ManagementExtensionSet}{@.identifier}) }

SMAddress ::= SEQUENCE {
   sMAddressType     [0] IMPLICIT SMAddressType OPTIONAL,
   sMAddressData     [1] IMPLICIT GraphicString OPTIONAL,
   sMAddressDomain   [2] IMPLICIT SMAddressDomain OPTIONAL}

SMInterface ::= SEQUENCE {
   interfaceId     [0] IMPLICIT GraphicString OPTIONAL,
   interfaceText   [1] IMPLICIT GraphicString OPTIONAL,
   interfacePort   [2] IMPLICIT GraphicString OPTIONAL,
   interfaceType   [3] IMPLICIT ENUMERATED {
      unkown                    ( 0 ),
      mobileOriginating         ( 1 ),
      mobileTerminating         ( 2 ),
      applicationOriginating    ( 3 ),
      applicationTerminating    ( 4 ),
      deviceTrigger             ( 5 ) } OPTIONAL}

PresenceReportingAreaInfo ::= SEQUENCE {
   presenceReportingAreaIdentifier     [0] IMPLICIT OCTET STRING,
   presenceReportingAreaStatus         [1] IMPLICIT ENUMERATED {
      insideArea     ( 0 ),
      outsideArea    ( 1 ),
      inactive       ( 2 ),
      unknown        ( 3 ) } OPTIONAL,
   presenceReportingAreaElementsList   [2] IMPLICIT OCTET STRING OPTIONAL,
   presenceReportingAreaNode           [3] IMPLICIT BIT STRING {
      oCS  (0 ),
      pCRF  (1 )} OPTIONAL}

RecipientInfos ::= SEQUENCE {
   recipientIMSI              [0] IMPLICIT OCTET STRING ( SIZE( 3 .. 8 ) ) OPTIONAL,
   recipientMSISDN            [1] IMPLICIT OCTET STRING ( SIZE( 1 .. 20 ) ) ( SIZE( 1 .. 9 ) ) OPTIONAL,
   recipientOtherAddress      [2] IMPLICIT SMAddress OPTIONAL,
   recipientSCCPAddress       [3] IMPLICIT OCTET STRING ( SIZE( 1 .. 20 ) ) OPTIONAL,
   recipientReceivedAddress   [4] IMPLICIT SMAddress OPTIONAL,
   sMDestinationInterface     [5] IMPLICIT SMInterface OPTIONAL,
   sMRecipientProtocolID      [6] IMPLICIT OCTET STRING OPTIONAL}

OriginatorInfo ::= SEQUENCE {
   originatorIMSI              [0] IMPLICIT OCTET STRING ( SIZE( 3 .. 8 ) ) OPTIONAL,
   originatorMSISDN            [1] IMPLICIT OCTET STRING ( SIZE( 1 .. 20 ) ) ( SIZE( 1 .. 9 ) ) OPTIONAL,
   originatorOtherAddress      [2] IMPLICIT SMAddress OPTIONAL,
   originatorSCCPAddress       [3] IMPLICIT OCTET STRING ( SIZE( 1 .. 20 ) ) OPTIONAL,
   originatorReceivedAddress   [4] IMPLICIT SMAddress OPTIONAL,
   sMOriginatorInterface       [5] IMPLICIT SMInterface OPTIONAL,
   sMOriginatorProtocolID      [6] IMPLICIT OCTET STRING OPTIONAL}

Diagnostics ::= CHOICE {
   gsm0408Cause                                [0] IMPLICIT INTEGER,
   gsm0902MapErrorValue                        [1] IMPLICIT INTEGER,
   itu-tQ767Cause                              [2] IMPLICIT INTEGER,
   networkSpecificCause                        [3] IMPLICIT ManagementExtension,
   manufacturerSpecificCause                   [4] IMPLICIT ManagementExtension,
   positionMethodFailureCause                  [5] IMPLICIT PositionMethodFailure-Diagnostic,
   unauthorizedLCSClientCause                  [6] IMPLICIT UnauthorizedLCSClient-Diagnostic,
   diameterResultCodeAndExperimentalResult     [7] IMPLICIT INTEGER}

CHFRecord  ::= CHOICE {
   chargingFunctionRecord     [200] IMPLICIT ChargingRecord}

ChargingRecord ::= SET {
   recordType                        [0] IMPLICIT RecordType,
   recordingNetworkFunctionID        [1] IMPLICIT IA5String  ( SIZE( 1 .. 36 ) ),
   subscriberIdentifier              [2] IMPLICIT SubscriptionID OPTIONAL,
