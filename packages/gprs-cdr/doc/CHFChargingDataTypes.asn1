SMSChargingInformation ::= SET {
   sMSNodeAddress              [0] IMPLICIT OCTET STRING ( SIZE( 1 .. 20 ) ),
   originatorInfo              [1] IMPLICIT OriginatorInfo OPTIONAL,
   recipientInfos              [2] IMPLICIT SEQUENCE  OF
      RecipientInfos OPTIONAL,
   userEquipmentInfo           [3] IMPLICIT SubscriberEquipmentNumber OPTIONAL,
   userLocationInformation     [4] IMPLICIT OCTET STRING OPTIONAL,
   uETimeZone                  [5] IMPLICIT OCTET STRING ( SIZE( 2 ) ) OPTIONAL,
   rATType                     [6] IMPLICIT INTEGER ( 0 .. 255 ) OPTIONAL,
   sMSCAddress                 [7] IMPLICIT OCTET STRING ( SIZE( 1 .. 20 ) ) OPTIONAL,
   eventtimestamp              [8] IMPLICIT OCTET STRING ( SIZE( 9 ) ),
   sMDataCodingScheme          [20] IMPLICIT INTEGER OPTIONAL,
   sMMessageType               [21] IMPLICIT ENUMERATED {
      submission          ( 0 ),
      deliveryReport      ( 1 ),
      sMServiceRequest    ( 2 ),
      delivery            ( 3 ),
      t4DeviceTrigger     ( 4 ),
      sMDeviceTrigger     ( 5 ) } OPTIONAL,
   sMReplyPathRequested        [22] IMPLICIT SMReplyPathRequested OPTIONAL,
   sMUserDataHeader            [23] IMPLICIT OCTET STRING OPTIONAL,
   sMSStatus                   [24] IMPLICIT OCTET STRING ( SIZE( 1 ) ) OPTIONAL,
   sMDischargeTime             [25] IMPLICIT OCTET STRING ( SIZE( 9 ) ) OPTIONAL,
   sMTotalNumber               [26] IMPLICIT INTEGER OPTIONAL,
   sMServiceType               [27] IMPLICIT SMServiceType OPTIONAL,
   sMSequenceNumber            [28] IMPLICIT INTEGER OPTIONAL,
   sMSResult                   [29] Diagnostics OPTIONAL,
   submissionTime              [30] IMPLICIT OCTET STRING ( SIZE( 9 ) ) OPTIONAL,
   sMPriority                  [31] IMPLICIT ENUMERATED {
      low         ( 0 ),
      normal      ( 1 ),
      high        ( 2 ) } OPTIONAL,
   messageReference            [32] IMPLICIT OCTET STRING,
   messageSize                 [33] IMPLICIT INTEGER OPTIONAL,
   messageClass                [34] IMPLICIT ENUMERATED {
      personal               ( 0 ),
      advertisement          ( 1 ),
      information-service    ( 2 ),
      auto                   ( 3 ) } OPTIONAL,
   sMdeliveryReportRequested   [35] IMPLICIT SMdeliveryReportRequested OPTIONAL}

PDUContainerInformation ::= SEQUENCE {
   chargingRuleBaseName                 [0] IMPLICIT IA5String  OPTIONAL,
   aFCorrelationInformation             [1] IMPLICIT OCTET STRING OPTIONAL,
   timeOfFirstUsage                     [2] IMPLICIT OCTET STRING ( SIZE( 9 ) ) OPTIONAL,
   timeOfLastUsage                      [3] IMPLICIT OCTET STRING ( SIZE( 9 ) ) OPTIONAL,
   qoSInformation                       [4] IMPLICIT FiveGQoSInformation OPTIONAL,
   userLocationInformation              [5] IMPLICIT OCTET STRING OPTIONAL,
   presenceReportingAreaInfo            [6] IMPLICIT PresenceReportingAreaInfo OPTIONAL,
   rATType                              [7] IMPLICIT INTEGER ( 0 .. 255 ) OPTIONAL,
   sponsorIdentity                      [8] IMPLICIT OCTET STRING OPTIONAL,
   applicationServiceProviderIdentity   [9] IMPLICIT OCTET STRING OPTIONAL,
   servingNetworkFunctionID             [10] IMPLICIT SEQUENCE  OF
      ServingNetworkFunctionID OPTIONAL,
   uETimeZone                           [11] IMPLICIT OCTET STRING ( SIZE( 2 ) ) OPTIONAL,
   threeGPPPSDataOffStatus              [12] IMPLICIT ThreeGPPPSDataOffStatus OPTIONAL}

MultipleQFIContainer ::= SEQUENCE {
   qosFlowId                   [0] IMPLICIT INTEGER OPTIONAL,
   triggers                    [1] IMPLICIT SEQUENCE  OF
      Trigger,
   triggerTimeStamp            [2] IMPLICIT OCTET STRING ( SIZE( 9 ) ) OPTIONAL,
   dataTotalVolume             [3] IMPLICIT INTEGER OPTIONAL,
   dataVolumeUplink            [4] IMPLICIT INTEGER OPTIONAL,
   dataVolumeDownlink          [5] IMPLICIT INTEGER OPTIONAL,
   localSequenceNumber         [6] IMPLICIT INTEGER ( 0 .. 4294967295 ) OPTIONAL,
   timeOfFirstUsage            [8] IMPLICIT OCTET STRING ( SIZE( 9 ) ) OPTIONAL,
   timeOfLastUsage             [9] IMPLICIT OCTET STRING ( SIZE( 9 ) ) OPTIONAL,
   qoSInformation              [10] IMPLICIT FiveGQoSInformation OPTIONAL,
   userLocationInformation     [11] IMPLICIT OCTET STRING OPTIONAL,
   uETimeZone                  [12] IMPLICIT OCTET STRING ( SIZE( 2 ) ) OPTIONAL,
   presenceReportingAreaInfo   [13] IMPLICIT PresenceReportingAreaInfo OPTIONAL,
   rATType                     [14] IMPLICIT INTEGER ( 0 .. 255 ) OPTIONAL,
   reportTime                  [15] IMPLICIT OCTET STRING ( SIZE( 9 ) ),
   servingNetworkFunctionID    [16] IMPLICIT SEQUENCE  OF
      ServingNetworkFunctionID OPTIONAL,
   threeGPPPSDataOffStatus     [17] IMPLICIT ThreeGPPPSDataOffStatus OPTIONAL}

AllocationRetentionPriority ::= SEQUENCE {
   priorityLevel             [1] IMPLICIT INTEGER,
   preemptionCapability      [2] IMPLICIT PreemptionCapability,
   preemptionVulnerability   [3] IMPLICIT PreemptionVulnerability}

AMFID      ::= OCTET STRING ( SIZE( 6 ) )

AuthorizedQoSInformation ::= SEQUENCE {
   fiveQi            [1] IMPLICIT INTEGER,
   aRP               [2] IMPLICIT AllocationRetentionPriority,
   priorityLevel     [3] IMPLICIT INTEGER OPTIONAL,
   averWindow        [4] IMPLICIT INTEGER OPTIONAL,
   maxDataBurstVol   [5] IMPLICIT INTEGER OPTIONAL}

Bitrate    ::= OCTET STRING

ChargingSessionIdentifier ::= OCTET STRING

DataNetworkNameIdentifier ::= IA5String  ( SIZE( 1 .. 63 ) )

DNNSelectionMode ::= ENUMERATED {
   uEorNetworkProvidedSubscriptionVerified    ( 0 ),
   uEProvidedSubscriptionNotVerified          ( 1 ),
   networkProvidedSubscriptionNotVerified     ( 2 ) }

FiveGQoSInformation ::= SEQUENCE {
   fiveQi                   [1] IMPLICIT INTEGER,
   aRP                      [2] IMPLICIT AllocationRetentionPriority,
   qoSNotificationControl   [3] IMPLICIT BOOLEAN OPTIONAL,
   reflectiveQos            [4] IMPLICIT BOOLEAN OPTIONAL,
   maxbitrateUL             [5] IMPLICIT OCTET STRING OPTIONAL,
   maxbitrateDL             [6] IMPLICIT OCTET STRING OPTIONAL,
   guaranteedbitrateUL      [7] IMPLICIT OCTET STRING OPTIONAL,
   guaranteedbitrateDL      [8] IMPLICIT OCTET STRING OPTIONAL,
   priorityLevel            [9] IMPLICIT INTEGER OPTIONAL,
   averWindow               [10] IMPLICIT INTEGER OPTIONAL,
   maxDataBurstVol          [11] IMPLICIT INTEGER OPTIONAL,
   maxPacketLossRateDL      [12] IMPLICIT INTEGER OPTIONAL,
   maxPacketLossRateUL      [13] IMPLICIT INTEGER OPTIONAL}

MultipleUnitUsage ::= SEQUENCE {
   ratingGroup          [0] IMPLICIT INTEGER,
   usedUnitContainers   [1] IMPLICIT SEQUENCE  OF
      UsedUnitContainer OPTIONAL,
   uPFID                [2] IMPLICIT IA5String  ( SIZE( 1 .. 36 ) ) OPTIONAL}

NetworkFunctionality ::= ENUMERATED {
   cHF         ( 0 ),
   sMF         ( 1 ),
   aMF         ( 2 ),
   sMSF        ( 3 ) }

NetworkFunctionInformation ::= SEQUENCE {
   networkFunctionality            [0] IMPLICIT NetworkFunctionality,
   networkFunctionName             [1] IMPLICIT IA5String  ( SIZE( 1 .. 36 ) ) OPTIONAL,
   networkFunctionIPv4Address      [2] IPAddress OPTIONAL,
   networkFunctionPLMNIdentifier   [3] IMPLICIT OCTET STRING ( SIZE( 3 ) ) OPTIONAL,
   networkFunctionIPv6Address      [4] IPAddress,
   networkFunctionFQDN             [5] NodeAddress}

NetworkFunctionName ::= IA5String  ( SIZE( 1 .. 36 ) )

NetworkSliceInstanceID ::= SEQUENCE {
   sST        [0] IMPLICIT INTEGER ( 0 .. 255 ),
   sD         [1] IMPLICIT OCTET STRING ( SIZE( 3 ) ) OPTIONAL}

NGRANSecondaryRATType ::= OCTET STRING

NGRANSecondaryRATUsageReport ::= SEQUENCE {
   nGRANSecondaryRATType   [0] IMPLICIT OCTET STRING OPTIONAL,
   qosFlowsUsageReports    [1] IMPLICIT SEQUENCE  OF
      QosFlowsUsageReport OPTIONAL}

QoSFlowId  ::= INTEGER

QosFlowsUsageReport ::= SEQUENCE {
   qosFlowId            [0] IMPLICIT INTEGER OPTIONAL,
   startTime            [1] IMPLICIT OCTET STRING ( SIZE( 9 ) ),
   endTime              [2] IMPLICIT OCTET STRING ( SIZE( 9 ) ),
   dataVolumeDownlink   [3] IMPLICIT INTEGER,
   dataVolumeUplink     [4] IMPLICIT INTEGER}

PartialRecordMethod ::= ENUMERATED {
   default       ( 0 ),
   individual    ( 1 ) }

PDUAddress ::= SEQUENCE {
   pDUIPv4Address             [0] IPAddress OPTIONAL,
   pDUIPv6AddresswithPrefix   [1] IPAddress OPTIONAL,
   iPV4dynamicAddressFlag     [2] IMPLICIT BOOLEAN OPTIONAL,
   iPV6dynamicPrefixFlag      [3] IMPLICIT BOOLEAN OPTIONAL}

PDUSessionId ::= INTEGER ( 0 .. 255 )

PDUSessionType ::= ENUMERATED {
   iPv4v6          ( 0 ),
   iPv4            ( 1 ),
   iPv6            ( 2 ),
   unstructured    ( 3 ),
   ethernet        ( 4 ) }

PreemptionCapability ::= ENUMERATED {
   nOT-PREEMPT    ( 0 ),
   mAY-PREEMPT    ( 1 ) }

PreemptionVulnerability ::= ENUMERATED {
   nOT-PREEMPTABLE    ( 0 ),
   pREEMPTABLE        ( 1 ) }

RatingIndicator ::= BOOLEAN

RoamingChargingProfile ::= SEQUENCE {
   roamingTriggers       [0] IMPLICIT SEQUENCE  OF
      RoamingTrigger OPTIONAL,
   partialRecordMethod   [1] IMPLICIT PartialRecordMethod OPTIONAL}

RoamerInOut ::= ENUMERATED {
   roamerInBound     ( 0 ),
   roamerOutBound    ( 1 ) }

RoamingTrigger ::= SEQUENCE {
   trigger                   [0] IMPLICIT SMFTrigger OPTIONAL,
   triggerCategory           [1] IMPLICIT TriggerCategory OPTIONAL,
   timeLimit                 [2] IMPLICIT INTEGER OPTIONAL,
   volumeLimit               [3] IMPLICIT INTEGER OPTIONAL,
   maxNbChargingConditions   [4] IMPLICIT INTEGER OPTIONAL}

ServingNetworkFunctionID ::= SEQUENCE {
   servingNetworkFunctionInformation   [0] IMPLICIT NetworkFunctionInformation,
   aMFIdentifier                       [1] IMPLICIT OCTET STRING ( SIZE( 6 ) ) OPTIONAL}

SessionAMBR ::= SEQUENCE {
   ambrUL     [1] IMPLICIT OCTET STRING,
   ambrDL     [2] IMPLICIT OCTET STRING}

SliceDifferentiator ::= OCTET STRING ( SIZE( 3 ) )

SliceServiceType ::= INTEGER ( 0 .. 255 )

SMdeliveryReportRequested ::= ENUMERATED {
   yes         ( 0 ),
   no          ( 1 ) }

SMFTrigger ::= INTEGER {
   startOfPDUSession                           ( 1 ),
   startOfServiceDataFlowNoSession             ( 2 ),
   qoSChange                                   ( 100 ),
   userLocationChange                          ( 101 ),
   servingNodeChange                           ( 102 ),
   presenceReportingAreaChange                 ( 103 ),
   threeGPPPSDataOffStatusChange               ( 104 ),
   tariffTimeChange                            ( 105 ),
   uETimeZoneChange                            ( 106 ),
   pLMNChange                                  ( 107 ),
   rATTypeChange                               ( 108 ),
   sessionAMBRChange                           ( 109 ),
   additionOfUPF                               ( 110 ),
   removalOfUPF                                ( 111 ),
   gFBRGuaranteedStatusChange                  ( 115 ),
   pDUSessionExpiryDataTimeLimit               ( 200 ),
   pDUSessionExpiryDataVolumeLimit             ( 201 ),
   pDUSessionExpiryDataEventLimit              ( 202 ),
   pDUSessionExpiryChargingConditionChanges    ( 203 ),
   ratingGroupDataTimeLimit                    ( 300 ),
   ratingGroupDataVolumeLimit                  ( 301 ),
   ratingGroupDataEventLimit                   ( 302 ),
   timeThresholdReached                        ( 400 ),
   volumeThresholdReached                      ( 401 ),
   unitThresholdReached                        ( 402 ),
   timeQuotaExhausted                          ( 403 ),
   volumeQuotaExhausted                        ( 404 ),
   unitQuotaExhausted                          ( 405 ),
   expiryOfQuotaValidityTime                   ( 406 ),
   reAuthorizationRequest                      ( 407 ),
   startOfServiceDataFlowNoValidQuota          ( 408 ),
   otherQuotaType                              ( 409 ),
   terminationOfServiceDataFlow                ( 500 ),
   managementIntervention                      ( 501 ),
   unitCountInactivityTimer                    ( 502 ),
   endOfPDUSession                             ( 503 ),
   cHFResponseWithSessionTermination           ( 504 ),
   cHFAbortRequest                             ( 505 ),
   abnormalRelease                             ( 506 ),
   qoSFlowExpiryDataTimeLimit                  ( 600 ),
   qoSFlowExpiryDataVolumeLimit                ( 601 )}

SMReplyPathRequested ::= ENUMERATED {
   noReplyPathSet    ( 0 ),
   replyPathSet      ( 1 ) }

SMServiceType ::= INTEGER {
   contentProcessing                  ( 0 ),
   forwarding                         ( 1 ),
   forwardingMultipleSubscriptions    ( 2 ),
   filtering                          ( 3 ),
   receipt                            ( 4 ),
   networkStorage                     ( 5 ),
   toMultipleDestinations             ( 6 ),
   virtualPrivateNetwork              ( 7 ),
   autoreply                          ( 8 ),
   personalSignature                  ( 9 ),
   deferredDelivery                   ( 10 )}

SSCMode    ::= INTEGER {
   sSCMode1    ( 1 ),
   sSCMode2    ( 2 ),
   sSCMode3    ( 3 )}

SubscribedQoSInformation ::= SEQUENCE {
   fiveQi          [1] IMPLICIT INTEGER,
   aRP             [2] IMPLICIT AllocationRetentionPriority OPTIONAL,
   priorityLevel   [3] IMPLICIT INTEGER OPTIONAL}

Trigger    ::= CHOICE {
   sMFTrigger     [0] IMPLICIT SMFTrigger}

TriggerCategory ::= ENUMERATED {
   immediateReport    ( 0 ),
   deferredReport     ( 1 ) }

UsedUnitContainer ::= SEQUENCE {
   serviceIdentifier          [0] IMPLICIT INTEGER ( 0 .. 4294967295 ) OPTIONAL,
   time                       [1] IMPLICIT INTEGER OPTIONAL,
   triggers                   [2] IMPLICIT SEQUENCE  OF
      Trigger,
   triggerTimeStamp           [3] IMPLICIT OCTET STRING ( SIZE( 9 ) ) OPTIONAL,
   dataTotalVolume            [4] IMPLICIT INTEGER OPTIONAL,
   dataVolumeUplink           [5] IMPLICIT INTEGER OPTIONAL,
   dataVolumeDownlink         [6] IMPLICIT INTEGER OPTIONAL,
   serviceSpecificUnits       [7] IMPLICIT INTEGER OPTIONAL,
   eventTimeStamp             [8] IMPLICIT OCTET STRING ( SIZE( 9 ) ) OPTIONAL,
   localSequenceNumber        [9] IMPLICIT INTEGER ( 0 .. 4294967295 ) OPTIONAL,
   ratingIndicator            [10] IMPLICIT BOOLEAN OPTIONAL,
   pDUContainerInformation    [11] IMPLICIT PDUContainerInformation OPTIONAL,
   quotaManagementIndicator   [12] IMPLICIT BOOLEAN OPTIONAL}

UserLocationInformation ::= OCTET STRING


-- X.721 DMI-EXTENSION. The set is the standard form of the original
-- extensible empty table constraint ({, ...}) and does not change BER.
DMI-EXTENSION ::= CLASS {
    &id     OBJECT IDENTIFIER UNIQUE,
    &Value
}
WITH SYNTAX {
    TYPE &Value
    ID &id
}

ManagementExtensionSet DMI-EXTENSION ::= {...}

END
