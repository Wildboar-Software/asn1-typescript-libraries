OriginatorInfo ::= SEQUENCE {
   originatorIMSI              [0] IMPLICIT OCTET STRING ( SIZE( 3 .. 8 ) ) OPTIONAL,
   originatorMSISDN            [1] IMPLICIT OCTET STRING ( SIZE( 1 .. 20 ) ) ( SIZE( 1 .. 9 ) ) OPTIONAL,
   originatorOtherAddress      [2] IMPLICIT SMAddressInfo OPTIONAL,
   originatorSCCPAddress       [3] IMPLICIT OCTET STRING ( SIZE( 1 .. 20 ) ) OPTIONAL,
   originatorReceivedAddress   [4] IMPLICIT SMAddressInfo OPTIONAL,
   sMOriginatorInterface       [5] IMPLICIT SMInterface OPTIONAL,
   sMOriginatorProtocolID      [6] IMPLICIT OCTET STRING OPTIONAL}

RecipientInfo ::= SEQUENCE {
   recipientIMSI              [0] IMPLICIT OCTET STRING ( SIZE( 3 .. 8 ) ) OPTIONAL,
   recipientMSISDN            [1] IMPLICIT OCTET STRING ( SIZE( 1 .. 20 ) ) ( SIZE( 1 .. 9 ) ) OPTIONAL,
   recipientOtherAddress      [2] IMPLICIT SMAddressInfo OPTIONAL,
   recipientSCCPAddress       [3] IMPLICIT OCTET STRING ( SIZE( 1 .. 20 ) ) OPTIONAL,
   recipientReceivedAddress   [4] IMPLICIT SMAddressInfo OPTIONAL,
   sMDestinationInterface     [5] IMPLICIT SMInterface OPTIONAL,
   sMRecipientProtocolID      [6] IMPLICIT OCTET STRING OPTIONAL}

SMAddressDomain ::= SEQUENCE {
   sMDomainName           [0] IMPLICIT GraphicString OPTIONAL,
   threeGPPIMSI-MCC-MNC   [1] IMPLICIT OCTET STRING ( SIZE( 3 ) ) OPTIONAL}

SMAddressInfo ::= SEQUENCE {
   sMAddressType     [0] IMPLICIT SMAddressType OPTIONAL,
   sMAddressData     [1] IMPLICIT GraphicString OPTIONAL,
   sMAddressDomain   [2] IMPLICIT SMAddressDomain OPTIONAL}

SMAddressType ::= ENUMERATED {
   emailAddress             ( 0 ),
   mSISDN                   ( 1 ),
   iPv4Address              ( 2 ),
   iPv6Address              ( 3 ),
   numericShortCode         ( 4 ),
   alphanumericShortCode    ( 5 ),
   other                    ( 6 ),
   iMSI                     ( 7 ) }

SMDeviceTriggerIndicator ::= ENUMERATED {
   notDeviceTrigger        ( 0 ),
   deviceTriggerRequest    ( 1 ),
   deviceTriggerReplace    ( 2 ),
   deviceTriggerRecall     ( 3 ) }

SMDeviceTriggerInformation ::= SEQUENCE {
   mTCIWFAddress            [0] NodeAddress OPTIONAL,
   sMDTReferenceNumber      [1] IMPLICIT INTEGER OPTIONAL,
   sMServingNode            [2] IMPLICIT SMServingNode OPTIONAL,
   sMDTValidityPeriod       [3] IMPLICIT INTEGER OPTIONAL,
   sMDTPriorityIndication   [4] IMPLICIT SMDTPriorityIndication OPTIONAL,
   sMSApplicationPortID     [5] IMPLICIT INTEGER OPTIONAL}

SMDTPriorityIndication ::= ENUMERATED {
   nonpriority    ( 0 ),
   priority       ( 1 ) }

SMInterface ::= SEQUENCE {
   interfaceId     [0] IMPLICIT GraphicString OPTIONAL,
   interfaceText   [1] IMPLICIT GraphicString OPTIONAL,
   interfacePort   [2] IMPLICIT GraphicString OPTIONAL,
   interfaceType   [3] IMPLICIT SMInterfaceType OPTIONAL}

SMInterfaceType ::= ENUMERATED {
   unkown                    ( 0 ),
   mobileOriginating         ( 1 ),
   mobileTerminating         ( 2 ),
   applicationOriginating    ( 3 ),
   applicationTerminating    ( 4 ),
   deviceTrigger             ( 5 ) }

SMMessageType ::= ENUMERATED {
   submission          ( 0 ),
   deliveryReport      ( 1 ),
   sMServiceRequest    ( 2 ),
   delivery            ( 3 ),
   t4DeviceTrigger     ( 4 ),
   sMDeviceTrigger     ( 5 ) }

SMServingNode ::= SEQUENCE {
   sGSNName            [0] IMPLICIT OCTET STRING OPTIONAL,
   sGSNRealm           [1] IMPLICIT OCTET STRING OPTIONAL,
   sGSNNumber          [2] IMPLICIT OCTET STRING ( SIZE( 1 .. 20 ) ) OPTIONAL,
   mMEName             [3] IMPLICIT OCTET STRING OPTIONAL,
   mMERealm            [4] IMPLICIT OCTET STRING OPTIONAL,
   mMENumberForMTSMS   [5] IMPLICIT OCTET STRING ( SIZE( 1 .. 20 ) ) OPTIONAL,
   mSCNumber           [6] IMPLICIT OCTET STRING ( SIZE( 1 .. 20 ) ) OPTIONAL,
   iPSMGWNumber        [7] IMPLICIT OCTET STRING ( SIZE( 1 .. 20 ) ) OPTIONAL,
   iPSMGWName          [8] IMPLICIT OCTET STRING OPTIONAL}

SMSStatus  ::= OCTET STRING ( SIZE( 1 ) )


-- X.721 DMI-EXTENSION. The set is the standard form of the original
-- extensible empty table constraint ({, ...}) and does not change BER.
DMI-EXTENSION ::= CLASS {
    &id     OBJECT IDENTIFIER UNIQUE,
    &Value
}
WITH SYNTAX {
    TYPE &Value
    ID &id
}

ManagementExtensionSet DMI-EXTENSION ::= {...}

END
