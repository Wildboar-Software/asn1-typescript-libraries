PriorityType ::= ENUMERATED {
   low         ( 0 ),
   normal      ( 1 ),
   high        ( 2 ) }

MessageClass ::= ENUMERATED {
   personal               ( 0 ),
   advertisement          ( 1 ),
   information-service    ( 2 ),
