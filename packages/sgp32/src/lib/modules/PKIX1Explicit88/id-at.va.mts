/* eslint-disable */
import {
    ObjectIdentifier as _OID,
    OBJECT_IDENTIFIER
} from "@wildboar/asn1";



/**
 * @summary id_at
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * id-at OBJECT IDENTIFIER ::= { joint-iso-ccitt(2) ds(5) 4 }
 * ```
 * 
 * @constant
 */
export
const id_at: OBJECT_IDENTIFIER = _OID.fromParts([
    /* joint-iso-ccitt */ 2,
    /* ds */ 5,
    4,
]);

/* eslint-enable */
