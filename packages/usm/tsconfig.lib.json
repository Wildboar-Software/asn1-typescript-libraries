{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "isolatedDeclarations": true,
    "erasableSyntaxOnly": true,
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "types": [
      "node"
    ],
    "strictNullChecks": true,
    "rootDir": "."
  },
  "exclude": ["**/*.spec.mts"],
  "include": ["**/*.mts"]
}
