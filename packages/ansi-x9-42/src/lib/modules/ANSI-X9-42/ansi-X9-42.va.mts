import { ObjectIdentifier as _OID, OBJECT_IDENTIFIER } from "@wildboar/asn1";


/**
 * @summary ansi_X9_42
 * @description
 *
 * Root OID `{iso(1) member-body(2) us(840) ansi-x942(10046)}` for
 * every object identifier defined in this standard. ANS X9.42-2003
 * Annex A.
 *
 * ### ASN.1 Definition:
 *
 * ```asn1
 * ansi-X9-42 OBJECT IDENTIFIER ::= {
 * iso(1) member-body(2) us(840) ansi-x942(10046) }
 * ```
 *
 * @constant
 */
export const ansi_X9_42: OBJECT_IDENTIFIER = _OID.fromParts([
    /* iso */ 1,
    /* member-body */ 2,
    /* us */ 840,
    /* ansi-x942 */ 10046,
]);

