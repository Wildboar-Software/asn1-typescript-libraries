/* eslint-disable */
import {
    ObjectIdentifier as _OID,
    iso,
    OBJECT_IDENTIFIER
} from "@wildboar/asn1";



/**
 * @summary rsl_fg
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * rsl-fg   OBJECT IDENTIFIER ::= {iso 3 112 4 3 1 2 38}
 * ```
 * 
 * @constant
 */
export
const rsl_fg: OBJECT_IDENTIFIER = _OID.fromParts([
    3,
    112,
    4,
    3,
    1,
    2,
    38,
], iso);

/* eslint-enable */
