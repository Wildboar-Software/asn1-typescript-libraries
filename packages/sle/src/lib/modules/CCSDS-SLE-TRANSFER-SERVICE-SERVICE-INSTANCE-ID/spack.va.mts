/* eslint-disable */
import {
    ObjectIdentifier as _OID,
    iso,
    OBJECT_IDENTIFIER
} from "@wildboar/asn1";



/**
 * @summary spack
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * spack    OBJECT IDENTIFIER ::= {iso 3 112 4 3 1 2 53}
 * ```
 * 
 * @constant
 */
export
const spack: OBJECT_IDENTIFIER = _OID.fromParts([
    3,
    112,
    4,
    3,
    1,
    2,
    53,
], iso);

/* eslint-enable */
