/* eslint-disable */
import {
    ObjectIdentifier as _OID,
    iso,
    OBJECT_IDENTIFIER
} from "@wildboar/asn1";



/**
 * @summary fsl_fg
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * fsl-fg   OBJECT IDENTIFIER ::= {iso 3 112 4 3 1 2 14}
 * ```
 * 
 * @constant
 */
export
const fsl_fg: OBJECT_IDENTIFIER = _OID.fromParts([
    3,
    112,
    4,
    3,
    1,
    2,
    14,
], iso);

/* eslint-enable */
