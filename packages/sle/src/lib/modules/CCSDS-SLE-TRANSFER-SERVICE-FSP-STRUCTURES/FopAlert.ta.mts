/* eslint-disable */
import {
    INTEGER
} from "@wildboar/asn1";
import * as $ from "@wildboar/asn1/functional";



/**
 * @summary FopAlert
 * @description
 * 
 * FOP alert generated by the FSP production process, in accordance with CCSDS
 * 232.1-B-2, indicating termination of the sequence-controlled service
 * guarantee. Present on a transmission mode capability change and on a negative
 * confirm response to a directive. Other notifications omit it.
 * 
 * CCSDS 912.3-B-3, section 3.7.2.7. FOP is a term of CCSDS 232.0-B-3, cited in
 * section 1.6.1.4.
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * FopAlert                 ::=    INTEGER
 * {  noAlert                       (0)
 * ,  limit                         (1)
 * ,  lockOutDetected               (2)
 * ,  synch                         (3)
 * ,  invalidNR                     (4)
 * ,  clcw                          (5)
 * ,  lowerLayerOutOfSync           (6)
 * ,  terminateADService            (7)
 * }
 * ```
 */
export
type FopAlert = INTEGER;

/**
 * @summary FopAlert_noAlert
 * @description
 * 
 * The notified transmission-mode capability change did not terminate the
 * sequence-controlled service guarantee.
 * 
 * CCSDS 912.3-B-3, section 3.7.2.7.1.
 * @constant
 * @type {number}
 */
export
const FopAlert_noAlert: FopAlert = 0; /* LONG_NAMED_INTEGER_VALUE */

/**
 * @summary FopAlert_noAlert
 * @description
 * 
 * The capability change left the sequence-controlled guarantee in place
 * (CCSDS 912.3-B-3, section 3.7.2.7.1).
 * @constant
 * @type {number}
 */
export
const noAlert: FopAlert = FopAlert_noAlert; /* SHORT_NAMED_INTEGER_VALUE */

/**
 * @summary FopAlert_limit
 * @description
 * 
 * Alert `limit`. The allowed number of transmissions was exhausted for a
 * Type-AD frame, or for a Type-BC frame derived from a directive such as
 * Initiate AD Service with Unlock or with Set V(R).
 * 
 * CCSDS 912.3-B-3, section 3.7.2.7.1.
 * @constant
 * @type {number}
 */
export
const FopAlert_limit: FopAlert = 1; /* LONG_NAMED_INTEGER_VALUE */

/**
 * @summary FopAlert_limit
 * @description
 * 
 * The transmission limit was exhausted for an AD or directive BC frame
 * (CCSDS 912.3-B-3, section 3.7.2.7.1).
 * @constant
 * @type {number}
 */
export
const limit: FopAlert = FopAlert_limit; /* SHORT_NAMED_INTEGER_VALUE */

/**
 * @summary FopAlert_lockOutDetected
 * @description
 * 
 * Alert `lockout`: lockout detected.
 * 
 * CCSDS 912.3-B-3, section 3.7.2.7.1.
 * @constant
 * @type {number}
 */
export
const FopAlert_lockOutDetected: FopAlert = 2; /* LONG_NAMED_INTEGER_VALUE */

/**
 * @summary FopAlert_lockOutDetected
 * @description
 * 
 * Lockout detected (CCSDS 912.3-B-3, section 3.7.2.7.1).
 * @constant
 * @type {number}
 */
export
const lockOutDetected: FopAlert = FopAlert_lockOutDetected; /* SHORT_NAMED_INTEGER_VALUE */

/**
 * @summary FopAlert_synch
 * @description
 * 
 * Alert `synch`. A CLCW arrived with Retransmit 0 and N(R) equal to NN(R) when
 * the previous CLCW had Retransmit 1; or every sent frame is acknowledged and
 * Retransmit is 1; or an attempt is made to acknowledge frames during the
 * initializing phase that corresponds to FOP state S4.
 * 
 * CCSDS 912.3-B-3, section 3.7.2.7.1.
 * @constant
 * @type {number}
 */
export
const FopAlert_synch: FopAlert = 3; /* LONG_NAMED_INTEGER_VALUE */

/**
 * @summary FopAlert_synch
 * @description
 * 
 * CLCW retransmission state or an acknowledgement during FOP state S4
 * (CCSDS 912.3-B-3, section 3.7.2.7.1).
 * @constant
 * @type {number}
 */
export
const synch: FopAlert = FopAlert_synch; /* SHORT_NAMED_INTEGER_VALUE */

/**
 * @summary FopAlert_invalidNR
 * @description
 * 
 * Alert `NN(R)`. A CLCW with an invalid N(R) has arrived. Annex A names this
 * code `invalidNR`.
 * 
 * CCSDS 912.3-B-3, section 3.7.2.7.1 and annex A2.5.
 * @constant
 * @type {number}
 */
export
const FopAlert_invalidNR: FopAlert = 4; /* LONG_NAMED_INTEGER_VALUE */

/**
 * @summary FopAlert_invalidNR
 * @description
 * 
 * A CLCW with an invalid N(R) arrived (CCSDS 912.3-B-3, section 3.7.2.7.1).
 * @constant
 * @type {number}
 */
export
const invalidNR: FopAlert = FopAlert_invalidNR; /* SHORT_NAMED_INTEGER_VALUE */

/**
 * @summary FopAlert_clcw
 * @description
 * 
 * Alert `CLCW`. A CLCW arrived with Wait 1 and Retransmit 0, or a CLCW arrived
 * with an invalid pattern of bits.
 * 
 * CCSDS 912.3-B-3, section 3.7.2.7.1.
 * @constant
 * @type {number}
 */
export
const FopAlert_clcw: FopAlert = 5; /* LONG_NAMED_INTEGER_VALUE */

/**
 * @summary FopAlert_clcw
 * @description
 * 
 * A CLCW had Wait set without Retransmit, or an invalid bit pattern
 * (CCSDS 912.3-B-3, section 3.7.2.7.1).
 * @constant
 * @type {number}
 */
export
const clcw: FopAlert = FopAlert_clcw; /* SHORT_NAMED_INTEGER_VALUE */

/**
 * @summary FopAlert_lowerLayerOutOfSync
 * @description
 * 
 * Alert `LLIF`. FOP-1 and the lower layer are out of synchronization. Annex A
 * names this code `lowerLayerOutOfSync`.
 * 
 * CCSDS 912.3-B-3, section 3.7.2.7.1 and annex A2.5.
 * @constant
 * @type {number}
 */
export
const FopAlert_lowerLayerOutOfSync: FopAlert = 6; /* LONG_NAMED_INTEGER_VALUE */

/**
 * @summary FopAlert_lowerLayerOutOfSync
 * @description
 * 
 * FOP-1 and the lower layer are out of synchronization (CCSDS 912.3-B-3,
 * section 3.7.2.7.1).
 * @constant
 * @type {number}
 */
export
const lowerLayerOutOfSync: FopAlert = FopAlert_lowerLayerOutOfSync; /* SHORT_NAMED_INTEGER_VALUE */

/**
 * @summary FopAlert_terminateADService
 * @description
 * 
 * Alert `term`. A Terminate AD Service directive has arrived. Annex A names
 * this code `terminateADService`.
 * 
 * CCSDS 912.3-B-3, section 3.7.2.7.1 and annex A2.5.
 * @constant
 * @type {number}
 */
export
const FopAlert_terminateADService: FopAlert = 7; /* LONG_NAMED_INTEGER_VALUE */

/**
 * @summary FopAlert_terminateADService
 * @description
 * 
 * A Terminate AD Service directive arrived (CCSDS 912.3-B-3, section
 * 3.7.2.7.1).
 * @constant
 * @type {number}
 */
export
const terminateADService: FopAlert = FopAlert_terminateADService; /* SHORT_NAMED_INTEGER_VALUE */
export const _decode_FopAlert: $.ASN1Decoder<FopAlert> = $._decodeInteger;
export const _encode_FopAlert: $.ASN1Encoder<FopAlert> = $._encodeInteger;


/* eslint-enable */
