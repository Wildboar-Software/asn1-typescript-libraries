{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "isolatedDeclarations": true,
    "rootDir": "src",
    "outDir": "../../dist/packages/extra-ldap-schema",
    "tsBuildInfoFile": "../../dist/packages/extra-ldap-schema/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitOverride": true,
    "importHelpers": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.mts"
  ],
  "references": [],
  "exclude": [
    "src/**/*.test.mts",
    "src/**/*.spec.mts",
    "vitest.config.mts"
  ]
}
