                              | iplanetXMLKeyValue
                              | description }
  LDAP-NAME                 {"iplanetOrgService"}
  LDAP-DESC                 "service information specific to organizations"
  ID                        id-oc-iplanetOrgService }

-- X-ORIGIN: "iPlanet Service Management"
iplanetServiceComponent OBJECT-CLASS ::= {
