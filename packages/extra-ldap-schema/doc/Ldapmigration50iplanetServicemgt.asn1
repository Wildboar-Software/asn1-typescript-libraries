  ID                        id-at-iplanetXMLKeyValue }

-- Object classes

-- X-ORIGIN: "iPlanet Service Management"
iplanetService OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { organizationalUnitName }
  MAY CONTAIN               { labeledURI
                              | iplanetServiceSchema
                              | iplanetKeyValue
                              | iplanetXMLKeyValue
                              | iplanetPluginSchema
                              | description }
  LDAP-NAME                 {"iplanetService"}
  LDAP-DESC                 "object containing service information"
  ID                        id-oc-iplanetService }

-- X-ORIGIN: "iPlanet Service Management"
iplanetOrgService OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { organizationalUnitName }
