-- X-ORIGIN: "iPlanet Service Management"
iplanetXMLKeyValue ATTRIBUTE ::= {
  WITH SYNTAX               IA5String
  LDAP-SYNTAX               ia5String.&id
  LDAP-NAME                 {"iplanetXMLKeyValue"}
