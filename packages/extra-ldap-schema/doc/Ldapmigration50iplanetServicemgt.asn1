-- Attribute types

-- X-ORIGIN: "iPlanet Service Management"
iplanetServiceSchema ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"iplanetServiceSchema"}
  LDAP-DESC                 "XML schema of a particular service"
  ID                        id-at-iplanetServiceSchema }

-- X-ORIGIN: "iPlanet Service Management"
iplanetServiceID ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"iplanetServiceID"}
  LDAP-DESC                 "reference to an inherited service object"
  ID                        id-at-iplanetServiceID }

-- X-ORIGIN: "iPlanet Service Management"
iplanetPluginID ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"iplanetPluginID"}
  LDAP-DESC                 "reference to the service plugin configuration"
  ID                        id-at-iplanetPluginID }

-- X-ORIGIN: "iPlanet Service Management"
iplanetSMSPriority ATTRIBUTE ::= {
  WITH SYNTAX               INTEGER
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               integer.&id
  LDAP-NAME                 {"iplanetSMSPriority"}
  LDAP-DESC                 "priority of a service with respect to its siblings"
  ID                        id-at-iplanetSMSPriority }

-- X-ORIGIN: "iPlanet Service Management"
iplanetPluginSchema ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"iplanetPluginSchema"}
  LDAP-DESC                 "service plugin schema information"
  ID                        id-at-iplanetPluginSchema }

-- X-ORIGIN: "iPlanet Service Management"
iplanetKeyValue ATTRIBUTE ::= {
  WITH SYNTAX               IA5String
