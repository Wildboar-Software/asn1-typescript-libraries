  EQUALITY MATCHING RULE    caseExactMatch
  SUBSTRINGS MATCHING RULE  caseExactSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"GLUE2ComputingActivityOtherMessages"}
  LDAP-DESC                 "Optional job messages provided by either the Grid Layer or the Computing Manager"
  ID                        id-at-gLUE2ComputingActivityOtherMessages }

-- initial capital of "GLUE2ComputingActivityComputingEndpointForeignKey" lowercased so the assignment is a valuereference.
gLUE2ComputingActivityComputingEndpointForeignKey ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseExactMatch
  SUBSTRINGS MATCHING RULE  caseExactSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"GLUE2ComputingActivityComputingEndpointForeignKey"}
  LDAP-DESC                 "ForeignKey"
  ID                        id-at-gLUE2ComputingActivityComputingEndpointForeignKey }

