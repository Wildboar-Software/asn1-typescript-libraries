                              | gotoXdmcpServer
                              | gotoXMethod
                              | gotoSndModule
                              | gotoLastUser
                              | gotoXMonitor
                              | gotoXHsync
                              | gotoXVsync
                              | gotoXResolution
                              | gotoXColordepth
                              | gotoXMouseport
