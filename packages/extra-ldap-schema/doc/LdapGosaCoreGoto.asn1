gotoDevice OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { commonName }
  MAY CONTAIN               { gotoHotplugDevice
                              | description }
  LDAP-NAME                 {"gotoDevice"}
  LDAP-DESC                 "GOto - contains environment settings (v2.7)"
  ID                        id-oc-gotoDevice }
END