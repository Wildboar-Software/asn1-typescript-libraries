  LDAP-DESC                 "NAB SpecificLogical Backed ID"
  ID                        id-at-nabStore }

-- Object classes

-- X-ORIGIN: "JES Calendar"
-- SUP was absent. RFC 4512 treats that as a subclass of top, so SUBCLASS OF { top } was added.
davEntity OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MAY CONTAIN               { mail
                              | davStore
                              | davAllowedServices
                              | davEventNotification
                              | davEventNotificationDestination
                              | davTimezone
                              | davUniqueId }
  LDAP-NAME                 {"davEntity"}
  LDAP-DESC                 "Common dav object"
  ID                        id-oc-davEntity }

-- X-ORIGIN: "OCUCS NAB"
-- SUP was absent. RFC 4512 treats that as a subclass of top, so SUBCLASS OF { top } was added.
nabUser OBJECT-CLASS ::= {
