nabStatus ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"nabStatus"}
  LDAP-DESC                 "NAB Entry status"
  ID                        id-at-nabStatus }

-- X-ORIGIN: "OCUCS NAB"
nabDomainAcl ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
