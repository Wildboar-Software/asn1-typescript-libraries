-- This module is a container for LDAP schema. It has no module identifier.
-- X- extension fields from the LDAP schema are comments. USAGE userApplications and structural KIND are omitted because they are the defaults.
-- 23 elements were omitted because another source file in this corpus defines the same OID.
-- Object classes with no SUP were subclassed from top, the LDAP default (RFC 4512).
Ldapmigration60iplanetCalendar DEFINITIONS ::=
BEGIN

IMPORTS

  ATTRIBUTE, DistinguishedName, distinguishedNameMatch, OBJECT-CLASS, top
    FROM InformationFramework
      {joint-iso-itu-t ds(5) module(1) informationFramework(1) 9} WITH SUCCESSORS

  caseExactMatch, caseIgnoreMatch, commonName, description, directoryString,
    dn, facsimileTelephoneNumber, givenName, integer, owner, postalAddress,
    surname, telephoneNumber, uid, UnboundedDirectoryString
    FROM SelectedAttributeTypes
      {joint-iso-itu-t ds(5) module(1) selectedAttributeTypes(5) 9} WITH SUCCESSORS

  userPassword
    FROM AuthenticationFramework
      {joint-iso-itu-t ds(5) module(1) authenticationFramework(7) 9} WITH SUCCESSORS

  preferredLanguage
    FROM InetOrgPerson
      {iso(1) identified-organization(3) dod(6) internet(1) private(4) enterprise(1) wildboar(56490) module(1) inetorgperson(5)} WITH SUCCESSORS

  mailAlternateAddress
    FROM QMailSchema
      {iso(1) identified-organization(3) dod(6) internet(1) private(4) enterprise(1) wildboar(56490) module(1) qmail-schema(55)} WITH SUCCESSORS

  icsExtendedUserPrefs
    FROM Ldapmigration55imsIcal

  aclGroupAddr, groupid
    FROM Ldapmigration56imsSchema

  nswcalDisallowAccess
    FROM LdapNsWcal

  mail
    FROM LdapSchema2ldifCore ;

