  MAY CONTAIN               { commonName
                              | givenName
                              | mail
                              | mailAlternateAddress
                              | preferredLanguage
                              | surname
                              | uid
                              | userPassword
                              | nabStatus
                              | nabStore }
  LDAP-NAME                 {"nabUser"}
  LDAP-DESC                 "NAB Entry Object Class"
  ID                        id-oc-nabUser }

-- X-ORIGIN: "OCUCS NAB"
