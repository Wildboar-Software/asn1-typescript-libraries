  LDAP-NAME                 {"nabDomainAcl"}
  LDAP-DESC                 "ACL string for NAB domain"
  ID                        id-at-nabDomainAcl }

-- X-ORIGIN: "OCUCS NAB"
nabDomainNames ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseIgnoreMatch
