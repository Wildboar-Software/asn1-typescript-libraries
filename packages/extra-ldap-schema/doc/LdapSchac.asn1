-- Attribute types

-- OID written as schacAttributeType:1 and expanded with this file's objectidentifier macros.
schacMotherTongue ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseExactMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"schacMotherTongue"}
  LDAP-DESC                 "RFC 3066 code for prefered language of communication"
  ID                        id-at-schacMotherTongue }

-- OID written as schacAttributeType:2 and expanded with this file's objectidentifier macros.
schacGender ATTRIBUTE ::= {
  WITH SYNTAX               INTEGER
  EQUALITY MATCHING RULE    integerMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               integer.&id
  LDAP-NAME                 {"schacGender"}
  LDAP-DESC                 "Representation of human sex (see ISO 5218)"
  ID                        id-at-schacGender }

-- OID written as schacAttributeType:3 and expanded with this file's objectidentifier macros.
schacDateOfBirth ATTRIBUTE ::= {
  WITH SYNTAX               NumericString
  EQUALITY MATCHING RULE    numericStringMatch
  ORDERING MATCHING RULE    numericStringOrderingMatch
  SUBSTRINGS MATCHING RULE  numericStringSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               numericString.&id
  LDAP-NAME                 {"schacDateOfBirth"}
  LDAP-DESC                 "Date of birth (format YYYYMMDD, only numeric chars)"
  ID                        id-at-schacDateOfBirth }

-- OID written as schacAttributeType:4 and expanded with this file's objectidentifier macros.
schacPlaceOfBirth ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
