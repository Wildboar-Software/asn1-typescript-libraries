-- Object classes

-- OID written as schacObjectClass:1 and expanded with this file's objectidentifier macros.
-- SUP was absent. RFC 4512 treats that as a subclass of top, so SUBCLASS OF { top } was added.
schacPersonalCharacteristics OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MAY CONTAIN               { schacMotherTongue
                              | schacGender
                              | schacDateOfBirth
                              | schacPlaceOfBirth
                              | schacCountryOfCitizenship
                              | schacSn1
                              | schacSn2
                              | schacPersonalTitle }
  LDAP-NAME                 {"schacPersonalCharacteristics"}
  LDAP-DESC                 "Personal characteristics describe the individual person represented by the entry"
  ID                        id-oc-schacPersonalCharacteristics }

-- OID written as schacObjectClass:2 and expanded with this file's objectidentifier macros.
-- SUP was absent. RFC 4512 treats that as a subclass of top, so SUBCLASS OF { top } was added.
schacContactLocation OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MAY CONTAIN               { schacHomeOrganization
                              | schacHomeOrganizationType
                              | schacCountryOfResidence
                              | schacUserPresenceID }
  LDAP-NAME                 {"schacContactLocation"}
  LDAP-DESC                 "Primary means of locating and contacting potential collaborators and other persons-of-interest at peer institutions"
  ID                        id-oc-schacContactLocation }

-- OID written as schacObjectClass:3 and expanded with this file's objectidentifier macros.
-- SUP was absent. RFC 4512 treats that as a subclass of top, so SUBCLASS OF { top } was added.
schacEmployeeInfo OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MAY CONTAIN               { schacPersonalPosition }
  LDAP-NAME                 {"schacEmployeeInfo"}
  LDAP-DESC                 "Employee information includes attributes that have relevance to the employee role, such as position, office hours, and job title"
  ID                        id-oc-schacEmployeeInfo }

-- OID written as schacObjectClass:4 and expanded with this file's objectidentifier macros.
-- SUP was absent. RFC 4512 treats that as a subclass of top, so SUBCLASS OF { top } was added.
schacLinkageIdentifiers OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MAY CONTAIN               { schacPersonalUniqueCode
                              | schacPersonalUniqueID }
  LDAP-NAME                 {"schacLinkageIdentifiers"}
  LDAP-DESC                 "Used to link a directory entry with records in external data stores or other directory entries"
  ID                        id-oc-schacLinkageIdentifiers }

-- OID written as schacObjectClass:5 and expanded with this file's objectidentifier macros.
-- SUP was absent. RFC 4512 treats that as a subclass of top, so SUBCLASS OF { top } was added.
schacEntryMetadata OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MAY CONTAIN               { schacExpiryDate }
  LDAP-NAME                 {"schacEntryMetadata"}
  LDAP-DESC                 "Used to contain information about the entry itself, often its status, birth, and death"
  ID                        id-oc-schacEntryMetadata }

-- OID written as schacObjectClass:6 and expanded with this file's objectidentifier macros.
-- SUP was absent. RFC 4512 treats that as a subclass of top, so SUBCLASS OF { top } was added.
schacEntryConfidentiality OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MAY CONTAIN               { schacUserPrivateAttribute }
  LDAP-NAME                 {"schacEntryConfidentiality"}
  LDAP-DESC                 "Used to indicate whether an entry is visible publicly, visible only to affiliates of the institution, or not visible at all"
  ID                        id-oc-schacEntryConfidentiality }

-- OID written as schacObjectClass:7 and expanded with this file's objectidentifier macros.
-- SUP was absent. RFC 4512 treats that as a subclass of top, so SUBCLASS OF { top } was added.
schacUserEntitlements OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
