      {iso(1) identified-organization(3) dod(6) internet(1) private(4) enterprise(1) wildboar(56490) module(1) openldap(28)} WITH SUCCESSORS ;

-- Object identifiers

id-at-phpscheduleitAccountLogin OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 22262 1 1 1 3 1 }
id-oc-phpscheduleitAccount OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 22262 1 1 2 3 1 }

-- Attribute types

phpscheduleitAccountLogin ATTRIBUTE ::= {
  WITH SYNTAX               IA5String
