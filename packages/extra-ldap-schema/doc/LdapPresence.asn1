-- Attribute types

-- X-ORIGIN: "Netscape Directory Server"
nsAIMid ATTRIBUTE ::= {
  WITH SYNTAX               OCTET STRING
  LDAP-SYNTAX               { 2 16 840 1 113730 3 7 1 }
  LDAP-NAME                 {"nsAIMid"}
  LDAP-DESC                 "Netscape defined attribute type"
  ID                        id-at-nsAIMid }

