  LDAP-DESC                 "Whether this zimlet is an extension"
  ID                        id-at-zimbraZimletIsExtension }

zimbraZimletJspEnabled ATTRIBUTE ::= {
  WITH SYNTAX               BOOLEAN
  EQUALITY MATCHING RULE    booleanMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               boolean.&id
  LDAP-NAME                 {"zimbraZimletJspEnabled"}
  LDAP-DESC                 "Whether to enable JSP compilation for Zimlets (i.e. for /zimlet webapp)"
  ID                        id-at-zimbraZimletJspEnabled }

-- LDAP syntax length {256} rendered as DirectoryString{256}.
zimbraZimletKeyword ATTRIBUTE ::= {
  WITH SYNTAX               DirectoryString{256}
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraZimletKeyword"}
  LDAP-DESC                 "Server side object keyword used for indexing and search for this Zimlet"
  ID                        id-at-zimbraZimletKeyword }

zimbraZimletLoadSynchronously ATTRIBUTE ::= {
  WITH SYNTAX               BOOLEAN
  EQUALITY MATCHING RULE    booleanMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               boolean.&id
  LDAP-NAME                 {"zimbraZimletLoadSynchronously"}
  LDAP-DESC                 "Whether to load zimlets synchronously in the web client. If set to TRUE, users are not allowed to use the core app before zimlets are loaded. If set to FALSE, zimlets are loaded in the background and users are allowed to use the core app before all zimlets finish loading."
  ID                        id-at-zimbraZimletLoadSynchronously }

-- LDAP syntax length {10240} rendered as DirectoryString{10240}.
zimbraZimletPanelItem ATTRIBUTE ::= {
  WITH SYNTAX               DirectoryString{10240}
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraZimletPanelItem"}
  LDAP-DESC                 "The panel item section in the Zimlet description"
  ID                        id-at-zimbraZimletPanelItem }

-- LDAP syntax length {32} rendered as DirectoryString{32}.
zimbraZimletPriority ATTRIBUTE ::= {
  WITH SYNTAX               DirectoryString{32}
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraZimletPriority"}
  LDAP-DESC                 "Object match priority"
  ID                        id-at-zimbraZimletPriority }

-- LDAP syntax length {256} rendered as DirectoryString{256}.
zimbraZimletScript ATTRIBUTE ::= {
  WITH SYNTAX               DirectoryString{256}
  EQUALITY MATCHING RULE    caseExactMatch
  SUBSTRINGS MATCHING RULE  caseExactSubstringsMatch
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraZimletScript"}
  LDAP-DESC                 "URL of extra scripts used by the Zimlet"
  ID                        id-at-zimbraZimletScript }

-- LDAP syntax length {256} rendered as DirectoryString{256}.
zimbraZimletServerIndexRegex ATTRIBUTE ::= {
  WITH SYNTAX               DirectoryString{256}
  EQUALITY MATCHING RULE    caseExactMatch
  SUBSTRINGS MATCHING RULE  caseExactSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraZimletServerIndexRegex"}
  LDAP-DESC                 "Regex of content object"
  ID                        id-at-zimbraZimletServerIndexRegex }

zimbraZimletStoreMatched ATTRIBUTE ::= {
  WITH SYNTAX               BOOLEAN
  EQUALITY MATCHING RULE    booleanMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               boolean.&id
  LDAP-NAME                 {"zimbraZimletStoreMatched"}
  LDAP-DESC                 "Whether store is matched for this type"
  ID                        id-at-zimbraZimletStoreMatched }

-- LDAP syntax length {1024} rendered as DirectoryString{1024}.
zimbraZimletTarget ATTRIBUTE ::= {
  WITH SYNTAX               DirectoryString{1024}
  EQUALITY MATCHING RULE    caseExactMatch
  SUBSTRINGS MATCHING RULE  caseExactSubstringsMatch
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraZimletTarget"}
