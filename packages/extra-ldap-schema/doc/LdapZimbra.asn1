-- Derived from data/ldap-schema/zimbra.schema
-- This module is a container for LDAP schema. It has no module identifier.
-- X- extension fields from the LDAP schema are comments. USAGE userApplications and structural KIND are omitted because they are the defaults.
-- 1 elements were omitted because their OIDs are already defined. See CONVERSION-REPORT.txt.
-- LDAP {length} bounds on directory strings are DirectoryString{n}. Bounds on IA5String, PrintableString, NumericString, and OCTET STRING are SIZE (1..n). Other bounds stay comments because the LDAP figure is an encoded-length hint.
LdapZimbra DEFINITIONS ::=
BEGIN

IMPORTS

  ATTRIBUTE, OBJECT-CLASS, top
    FROM InformationFramework
      {joint-iso-itu-t ds(5) module(1) informationFramework(1) 9} WITH SUCCESSORS

  boolean, booleanMatch, caseExactMatch, caseExactSubstringsMatch,
    caseIgnoreIA5Match, caseIgnoreMatch, caseIgnoreSubstringsMatch, commonName,
    countryName, description, destinationIndicator, directoryString,
    DirectoryString, facsimileTelephoneNumber, generalizedTime,
    generalizedTimeMatch, generalizedTimeOrderingMatch, givenName, ia5String,
    initials, integer, integerMatch, integerOrderingMatch,
    internationalISDNNumber, localityName, octetString, octetStringMatch,
    organizationalUnitName, organizationName, physicalDeliveryOfficeName,
    postalAddress, postalCode, postOfficeBox, preferredDeliveryMethod,
    registeredAddress, stateOrProvinceName, streetAddress, surname,
    telephoneNr, telephoneNumber, TelephoneNumber, telephoneNumberMatch,
    telephoneNumberSubstringsMatch, telexNumber, title, uid,
    UnboundedDirectoryString, x121Address
    FROM SelectedAttributeTypes
      {joint-iso-itu-t ds(5) module(1) selectedAttributeTypes(5) 9} WITH SUCCESSORS

  userCertificate, userPassword
    FROM AuthenticationFramework
      {joint-iso-itu-t ds(5) module(1) authenticationFramework(7) 9} WITH SUCCESSORS

  memberURL
    FROM DynGroup
      {iso(1) identified-organization(3) dod(6) internet(1) private(4) enterprise(1) wildboar(56490) module(1) dyngroup(24)} WITH SUCCESSORS

  userSMIMECertificate
    FROM H323-X500-Schema
      {iso(1) identified-organization(3) dod(6) internet(1) private(4) enterprise(1) wildboar(56490) module(1) h323-x500-schema(1000)} WITH SUCCESSORS

  displayName
    FROM InetOrgPerson
      {iso(1) identified-organization(3) dod(6) internet(1) private(4) enterprise(1) wildboar(56490) module(1) inetorgperson(5)} WITH SUCCESSORS

  company
    FROM MSUser
      {iso(1) identified-organization(3) dod(6) internet(1) private(4) enterprise(1) wildboar(56490) module(1) msuser(26)} WITH SUCCESSORS

  mail, teletexTerminalIdentifier
    FROM LdapSchema2ldifCore

  co, homePhone, mobile, pager
    FROM LdapSchema2ldifCosine ;

