  ID                        id-at-zimbraReverseProxySendPop3Xoip }

zimbraReverseProxyUpstreamConnectTimeout ATTRIBUTE ::= {
  WITH SYNTAX               INTEGER
  EQUALITY MATCHING RULE    integerMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               integer.&id
  LDAP-NAME                 {"zimbraReverseProxyUpstreamConnectTimeout"}
  LDAP-DESC                 "The connect timeout is the time interval after which NGINX will disconnect while establishing an upstream HTTP connection. Measured in seconds, should not be more than 75 seconds."
  ID                        id-at-zimbraReverseProxyUpstreamConnectTimeout }

zimbraReverseProxyUpstreamEwsServers ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraReverseProxyUpstreamEwsServers"}
  LDAP-DESC                 "The servers running mailbox with EWS functionality to be included in the ""ews"" block in the nginx web proxy config file"
  ID                        id-at-zimbraReverseProxyUpstreamEwsServers }

zimbraReverseProxyUpstreamLoginServers ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraReverseProxyUpstreamLoginServers"}
  LDAP-DESC                 "The servers to be included in the login block in the nginx web proxy config file. The servers configured here will only affect the proxy of login URL requests."
  ID                        id-at-zimbraReverseProxyUpstreamLoginServers }

zimbraReverseProxyUpstreamPollingTimeout ATTRIBUTE ::= {
  WITH SYNTAX               IA5String(SIZE (1..32))
  EQUALITY MATCHING RULE    caseIgnoreIA5Match
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               ia5String.&id
  LDAP-NAME                 {"zimbraReverseProxyUpstreamPollingTimeout"}
  LDAP-DESC                 "The read timeout for long polling support by proxy, e.g. ActiveSync for mobile devices. . Must be in valid duration format: {digits}{time-unit}. digits: 0-9, time-unit: [hmsd]|ms. h - hours, m - minutes, s - seconds, d - days, ms - milliseconds. If time unit is not specified, the default is s(seconds)."
  ID                        id-at-zimbraReverseProxyUpstreamPollingTimeout }

zimbraReverseProxyUpstreamReadTimeout ATTRIBUTE ::= {
  WITH SYNTAX               IA5String(SIZE (1..32))
  EQUALITY MATCHING RULE    caseIgnoreIA5Match
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               ia5String.&id
  LDAP-NAME                 {"zimbraReverseProxyUpstreamReadTimeout"}
  LDAP-DESC                 "The read timeout for the response of upstream server, which determines how long nginx will wait to get the response to a request. . Must be in valid duration format: {digits}{time-unit}. digits: 0-9, time-unit: [hmsd]|ms. h - hours, m - minutes, s - seconds, d - days, ms - milliseconds. If time unit is not specified, the default is s(seconds)."
  ID                        id-at-zimbraReverseProxyUpstreamReadTimeout }

zimbraReverseProxyUpstreamSendTimeout ATTRIBUTE ::= {
  WITH SYNTAX               IA5String(SIZE (1..32))
  EQUALITY MATCHING RULE    caseIgnoreIA5Match
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               ia5String.&id
  LDAP-NAME                 {"zimbraReverseProxyUpstreamSendTimeout"}
  LDAP-DESC                 "The send timeout of transfering a request to the upstream server. If after this time the upstream server doesn't take new data, proxy will close the connection. . Must be in valid duration format: {digits}{time-unit}. digits: 0-9, time-unit: [hmsd]|ms. h - hours, m - minutes, s - seconds, d - days, ms - milliseconds. If time unit is not specified, the default is s(seconds)."
  ID                        id-at-zimbraReverseProxyUpstreamSendTimeout }

zimbraReverseProxyUpstreamServers ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraReverseProxyUpstreamServers"}
  LDAP-DESC                 "The servers to be included in the ""upstream"" block in the nginx web proxy config file. The servers configured here will only affect the proxy of pre-login requests. Leaving empty means using all the servers whose zimbraReverseProxyLookupTarget is TRUE."
  ID                        id-at-zimbraReverseProxyUpstreamServers }

zimbraReverseProxyUseExternalRoute ATTRIBUTE ::= {
  WITH SYNTAX               BOOLEAN
  EQUALITY MATCHING RULE    booleanMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               boolean.&id
  LDAP-NAME                 {"zimbraReverseProxyUseExternalRoute"}
  LDAP-DESC                 "There is a deployment scenario for migrations where all of the customers users are pointed at the zimbra POP IMAP reverse proxy. We then want their connections proxied back to the legacy system for not-yet-non-migrated users. If this attribute is TRUE, reverse proxy lookup servlet should check to see if zimbraExternal* is set on the domain. If so it is used. If not, lookup proceeds as usual."
  ID                        id-at-zimbraReverseProxyUseExternalRoute }

zimbraReverseProxyUseExternalRouteIfAccountNotExist ATTRIBUTE ::= {
  WITH SYNTAX               BOOLEAN
  EQUALITY MATCHING RULE    booleanMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               boolean.&id
  LDAP-NAME                 {"zimbraReverseProxyUseExternalRouteIfAccountNotExist"}
  LDAP-DESC                 "Use external route configured on domain if account cannot be found. Also see zimbraReverseProxyUseExternalRoute."
  ID                        id-at-zimbraReverseProxyUseExternalRouteIfAccountNotExist }

zimbraReverseProxyUserLoginLimit ATTRIBUTE ::= {
  WITH SYNTAX               INTEGER
  EQUALITY MATCHING RULE    integerMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               integer.&id
  LDAP-NAME                 {"zimbraReverseProxyUserLoginLimit"}
  LDAP-DESC                 "Limit how many times a user can login via the proxy. Setting limit to 100 and time to 3600 means: allow maximum 100 logins per hour for any user. As with the ip counterparts, the user hit counter and timeout are cumulative for all protocols. Also, for a given users login, both counters are checked in succession, with the IP counter being checked first. A login may be rejected (throttled) because the IP is over-usage, or because the login name itself is over-usage. A value of 0 indicates that no throttling will take place for any user."
  ID                        id-at-zimbraReverseProxyUserLoginLimit }

zimbraReverseProxyUserLoginLimitTime ATTRIBUTE ::= {
  WITH SYNTAX               INTEGER
  EQUALITY MATCHING RULE    integerMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               integer.&id
  LDAP-NAME                 {"zimbraReverseProxyUserLoginLimitTime"}
  LDAP-DESC                 "Sets the time-to-live for the hit counter for per user login throttling."
  ID                        id-at-zimbraReverseProxyUserLoginLimitTime }

zimbraReverseProxyUserNameAttribute ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraReverseProxyUserNameAttribute"}
  LDAP-DESC                 "LDAP attribute that contains user name for the principal"
  ID                        id-at-zimbraReverseProxyUserNameAttribute }

zimbraReverseProxyUserThrottleMsg ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraReverseProxyUserThrottleMsg"}
  LDAP-DESC                 "The error message with which a login attempt by a user will be throttled, if the attempt count exceeds the configured limit"
  ID                        id-at-zimbraReverseProxyUserThrottleMsg }

zimbraReverseProxyWorkerConnections ATTRIBUTE ::= {
  WITH SYNTAX               INTEGER
  EQUALITY MATCHING RULE    integerMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               integer.&id
  LDAP-NAME                 {"zimbraReverseProxyWorkerConnections"}
  LDAP-DESC                 "Maximum number of connections that an NGINX Proxy worker process is allowed to handle"
  ID                        id-at-zimbraReverseProxyWorkerConnections }

zimbraReverseProxyWorkerProcesses ATTRIBUTE ::= {
  WITH SYNTAX               INTEGER
  EQUALITY MATCHING RULE    integerMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               integer.&id
  LDAP-NAME                 {"zimbraReverseProxyWorkerProcesses"}
  LDAP-DESC                 "Number of worker processes of NGINX Proxy"
  ID                        id-at-zimbraReverseProxyWorkerProcesses }

-- LDAP syntax length {256} rendered as DirectoryString{256}.
zimbraSMIMELdapAttribute ATTRIBUTE ::= {
  WITH SYNTAX               DirectoryString{256}
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraSMIMELdapAttribute"}
  LDAP-DESC                 "LDAP attribute(s) for public key lookup for S/MIME via external LDAP. Multiple attributes can be separated by comma. All SMIME attributes are in the format of {config-name}:{value}. A 'SMIME config' is a set of SMIME attribute values with the same {config-name}. Multiple SMIME configs can be configured on a domain or on globalconfig. Note: SMIME attributes on domains do not inherited values from globalconfig, they are not domain-inherited attributes. During SMIME public key lookup, if there are any SMIME config on the domain of the account, they are used. SMIME configs on globalconfig will be used only when there is no SMIME config on the domain. SMIME attributes cannot be modified directly with zmprov md/mcf commands. Use zmprov gcsc/gdsc/mcsc/mdsc/rcsc/rdsc command instead."
  ID                        id-at-zimbraSMIMELdapAttribute }

-- LDAP syntax length {256} rendered as DirectoryString{256}.
zimbraSMIMELdapBindDn ATTRIBUTE ::= {
  WITH SYNTAX               DirectoryString{256}
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraSMIMELdapBindDn"}
  LDAP-DESC                 "LDAP bind DN for public key lookup for S/MIME via external LDAP. Can be empty for anonymous bind. All SMIME attributes are in the format of {config-name}:{value}. A 'SMIME config' is a set of SMIME attribute values with the same {config-name}. Multiple SMIME configs can be configured on a domain or on globalconfig. Note: SMIME attributes on domains do not inherited values from globalconfig, they are not domain-inherited attributes. During SMIME public key lookup, if there are any SMIME config on the domain of the account, they are used. SMIME configs on globalconfig will be used only when there is no SMIME config on the domain. SMIME attributes cannot be modified directly with zmprov md/mcf commands. Use zmprov gcsc/gdsc/mcsc/mdsc/rcsc/rdsc command instead."
  ID                        id-at-zimbraSMIMELdapBindDn }

-- LDAP syntax length {256} rendered as DirectoryString{256}.
zimbraSMIMELdapBindPassword ATTRIBUTE ::= {
  WITH SYNTAX               DirectoryString{256}
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraSMIMELdapBindPassword"}
  LDAP-DESC                 "LDAP bind password for public key lookup for S/MIME via external LDAP. Can be empty for anonymous bind. All SMIME attributes are in the format of {config-name}:{value}. A 'SMIME config' is a set of SMIME attribute values with the same {config-name}. Multiple SMIME configs can be configured on a domain or on globalconfig. Note: SMIME attributes on domains do not inherited values from globalconfig, they are not domain-inherited attributes. During SMIME public key lookup, if there are any SMIME config on the domain of the account, they are used. SMIME configs on globalconfig will be used only when there is no SMIME config on the domain. SMIME attributes cannot be modified directly with zmprov md/mcf commands. Use zmprov gcsc/gdsc/mcsc/mdsc/rcsc/rdsc command instead."
  ID                        id-at-zimbraSMIMELdapBindPassword }

-- LDAP syntax length {32} rendered as DirectoryString{32}.
zimbraSMIMELdapDiscoverSearchBaseEnabled ATTRIBUTE ::= {
  WITH SYNTAX               DirectoryString{32}
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraSMIMELdapDiscoverSearchBaseEnabled"}
  LDAP-DESC                 "Whether or not to discover search base DNs if zimbraSMIMELdapSearchBase is not set. Allowed values are TRUE or FALSE. If zimbraSMIMELdapSearchBase is set for a config, this attribute is ignored for the config. If not set, default for the config is FALSE. In that case, if zimbraSMIMELdapSearchBase is not set, the search will default to the rootDSE. If multiple DNs are discovered, the ldap search will use them one by one until a hit is returned. All SMIME attributes are in the format of {config-name}:{value}. A 'SMIME config' is a set of SMIME attribute values with the same {config-name}. Multiple SMIME configs can be configured on a domain or on globalconfig. Note: SMIME attributes on domains do not inherited values from globalconfig, they are not domain-inherited attributes. During SMIME public key lookup, if there are any SMIME config on the domain of the account, they are used. SMIME configs on globalconfig will be used only when there is no SMIME config on the domain. SMIME attributes cannot be modified directly with zmprov md/mcf commands. Use zmprov gcsc/gdsc/mcsc/mdsc/rcsc/rdsc command instead."
  ID                        id-at-zimbraSMIMELdapDiscoverSearchBaseEnabled }

-- LDAP syntax length {1024} rendered as DirectoryString{1024}.
zimbraSMIMELdapFilter ATTRIBUTE ::= {
  WITH SYNTAX               DirectoryString{1024}
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraSMIMELdapFilter"}
  LDAP-DESC                 "LDAP search filter for public key lookup for S/MIME via external LDAP. Can contain the following conversion variables for expansion: %n - search key with @ (or without, if no @ was specified) %u - with @ removed e.g. (mail=%n) All SMIME attributes are in the format of {config-name}:{value}. A 'SMIME config' is a set of SMIME attribute values with the same {config-name}. Multiple SMIME configs can be configured on a domain or on globalconfig. Note: SMIME attributes on domains do not inherited values from globalconfig, they are not domain-inherited attributes. During SMIME public key lookup, if there are any SMIME config on the domain of the account, they are used. SMIME configs on globalconfig will be used only when there is no SMIME config on the domain. SMIME attributes cannot be modified directly with zmprov md/mcf commands. Use zmprov gcsc/gdsc/mcsc/mdsc/rcsc/rdsc command instead."
  ID                        id-at-zimbraSMIMELdapFilter }

-- LDAP syntax length {256} rendered as DirectoryString{256}.
zimbraSMIMELdapSearchBase ATTRIBUTE ::= {
  WITH SYNTAX               DirectoryString{256}
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraSMIMELdapSearchBase"}
  LDAP-DESC                 "LDAP search base for public key lookup for S/MIME via external LDAP. All SMIME attributes are in the format of {config-name}:{value}. A 'SMIME config' is a set of SMIME attribute values with the same {config-name}. Multiple SMIME configs can be configured on a domain or on globalconfig. Note: SMIME attributes on domains do not inherited values from globalconfig, they are not domain-inherited attributes. During SMIME public key lookup, if there are any SMIME config on the domain of the account, they are used. SMIME configs on globalconfig will be used only when there is no SMIME config on the domain. SMIME attributes cannot be modified directly with zmprov md/mcf commands. Use zmprov gcsc/gdsc/mcsc/mdsc/rcsc/rdsc command instead."
  ID                        id-at-zimbraSMIMELdapSearchBase }

zimbraSMIMELdapStartTlsEnabled ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraSMIMELdapStartTlsEnabled"}
  LDAP-DESC                 "Whether to use startTLS for public key lookup for S/MIME via external LDAP. All SMIME attributes are in the format of {config-name}:{value}. A 'SMIME config' is a set of SMIME attribute values with the same {config-name}. Multiple SMIME configs can be configured on a domain or on globalconfig. Note: SMIME attributes on domains do not inherited values from globalconfig, they are not domain-inherited attributes. During SMIME public key lookup, if there are any SMIME config on the domain of the account, they are used. SMIME configs on globalconfig will be used only when there is no SMIME config on the domain. SMIME attributes cannot be modified directly with zmprov md/mcf commands. Use zmprov gcsc/gdsc/mcsc/mdsc/rcsc/rdsc command instead."
  ID                        id-at-zimbraSMIMELdapStartTlsEnabled }

-- LDAP syntax length {256} rendered as DirectoryString{256}.
