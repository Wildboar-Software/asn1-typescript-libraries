  ID                        id-at-zimbraMobileItemsToTrackPerFolderMaxSize }

zimbraMobileMaxMessageSize ATTRIBUTE ::= {
  WITH SYNTAX               INTEGER
  EQUALITY MATCHING RULE    integerMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               integer.&id
  LDAP-NAME                 {"zimbraMobileMaxMessageSize"}
