zimbraZookeeperClientServerList ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraZookeeperClientServerList"}
  LDAP-DESC                 "list of host:port for zookeeper servers; set to empty value to disable the use of zookeeper"
  ID                        id-at-zimbraZookeeperClientServerList }

-- Object classes

zimbraMailRecipient OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MAY CONTAIN               { zimbraHideInGal
                              | zimbraLocale
                              | zimbraMailAddress
                              | zimbraMailAlias
                              | zimbraMailCanonicalAddress
                              | zimbraMailCatchAllAddress
                              | zimbraMailCatchAllCanonicalAddress
                              | zimbraMailCatchAllForwardingAddress
                              | zimbraMailDeliveryAddress
                              | zimbraMailForwardingAddress
                              | zimbraMailHost
                              | zimbraMailStatus
                              | zimbraMailTransport }
  LDAP-NAME                 {"zimbraMailRecipient"}
  LDAP-DESC                 "Mail recipient object"
  ID                        id-oc-zimbraMailRecipient }

-- MAY gn: LDAP name "gn" was taken as givenName. schema2ldif/core.schema lists it on 2.5.4.42, which is already givenName in SelectedAttributeTypes.
