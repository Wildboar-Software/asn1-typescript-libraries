  LDAP-NAME                 {"zimbraMailSSLBindAddress"}
  LDAP-DESC                 "interface address on which HTTPS server should listen; if empty, binds to all interfaces"
  ID                        id-at-zimbraMailSSLBindAddress }

-- LDAP syntax length {128} rendered as DirectoryString{128}.
zimbraMailSSLClientCertBindAddress ATTRIBUTE ::= {
  WITH SYNTAX               DirectoryString{128}
  EQUALITY MATCHING RULE    caseIgnoreMatch
