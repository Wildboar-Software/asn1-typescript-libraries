  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraDomainType"}
  LDAP-DESC                 "should be one of: local, alias"
  ID                        id-at-zimbraDomainType }

