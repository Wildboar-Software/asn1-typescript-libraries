zimbraReverseProxyRouteLookupTimeout ATTRIBUTE ::= {
  WITH SYNTAX               IA5String(SIZE (1..32))
  EQUALITY MATCHING RULE    caseIgnoreIA5Match
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               ia5String.&id
  LDAP-NAME                 {"zimbraReverseProxyRouteLookupTimeout"}
  LDAP-DESC                 "Time interval after which NGINX will fail over to the next route lookup handler, if a handler does not respond to the route lookup request within this time. Must be in valid duration format: {digits}{time-unit}. digits: 0-9, time-unit: [hmsd]|ms. h - hours, m - minutes, s - seconds, d - days, ms - milliseconds. If time unit is not specified, the default is s(seconds)."
  ID                        id-at-zimbraReverseProxyRouteLookupTimeout }

zimbraReverseProxyRouteLookupTimeoutCache ATTRIBUTE ::= {
  WITH SYNTAX               IA5String(SIZE (1..32))
  EQUALITY MATCHING RULE    caseIgnoreIA5Match
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               ia5String.&id
  LDAP-NAME                 {"zimbraReverseProxyRouteLookupTimeoutCache"}
  LDAP-DESC                 "Time interval (ms) given to mail route lookup handler to cache a failed response to route a previous lookup request (after this time elapses, Proxy retries this host). Must be in valid duration format: {digits}{time-unit}. digits: 0-9, time-unit: [hmsd]|ms. h - hours, m - minutes, s - seconds, d - days, ms - milliseconds. If time unit is not specified, the default is s(seconds)."
  ID                        id-at-zimbraReverseProxyRouteLookupTimeoutCache }

zimbraReverseProxySSLCiphers ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraReverseProxySSLCiphers"}
  LDAP-DESC                 "permitted ciphers for reverse proxy. Ciphers are in the formats supported by OpenSSL e.g. ALL:!ADH:!EXPORT56:RC4+RSA:+HIGH:+MEDIUM:+LOW:+SSLv2:+EXP; if not set, default ciphers permitted by nginx will apply"
  ID                        id-at-zimbraReverseProxySSLCiphers }

zimbraReverseProxySSLECDHCurve ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseIgnoreMatch
