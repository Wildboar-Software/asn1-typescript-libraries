zimbraAlias OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { zimbraAliasTargetId
                              | zimbraId }
  MAY CONTAIN               { commonName
                              | uid
                              | zimbraCreateTimestamp
                              | zimbraLocale }
  LDAP-NAME                 {"zimbraAlias"}
  LDAP-DESC                 "An alias to another zimbra object"
  ID                        id-oc-zimbraAlias }

zimbraDistributionList OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { uid
                              | zimbraId }
  MAY CONTAIN               { commonName
                              | description
                              | displayName
                              | mail
                              | zimbraACE
                              | zimbraAdminConsoleUIComponents
                              | zimbraCreateTimestamp
                              | zimbraDistributionListSendShareMessageFromAddress
                              | zimbraDistributionListSendShareMessageToNewMembers
                              | zimbraDistributionListSubscriptionPolicy
                              | zimbraDistributionListUnsubscriptionPolicy
                              | zimbraGroupId
