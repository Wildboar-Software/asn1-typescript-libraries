  ID                        id-at-zimbraMailPurgeBatchSize }

zimbraMailPurgeSleepInterval ATTRIBUTE ::= {
  WITH SYNTAX               IA5String(SIZE (1..32))
  EQUALITY MATCHING RULE    caseIgnoreIA5Match
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               ia5String.&id
  LDAP-NAME                 {"zimbraMailPurgeSleepInterval"}
  LDAP-DESC                 "Sleep time between subsequent mailbox purges. 0 means that mailbox purging is disabled. . Must be in valid duration format: {digits}{time-unit}. digits: 0-9, time-unit: [hmsd]|ms. h - hours, m - minutes, s - seconds, d - days, ms - milliseconds. If time unit is not specified, the default is s(seconds)."
  ID                        id-at-zimbraMailPurgeSleepInterval }

zimbraMailPurgeSystemPolicy ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraMailPurgeSystemPolicy"}
  LDAP-DESC                 "System purge policy, encoded as metadata. Users can apply these policy elements to their folders and tags. If the system policy changes, user settings are automatically updated with the change."
  ID                        id-at-zimbraMailPurgeSystemPolicy }

zimbraMailPurgeUseChangeDateForSpam ATTRIBUTE ::= {
