-- Attribute types

zimbraACE ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraACE"}
  LDAP-DESC                 "Zimbra access control list"
  ID                        id-at-zimbraACE }

-- LDAP syntax length {32} rendered as DirectoryString{32}.
zimbraAccountCalendarUserType ATTRIBUTE ::= {
  WITH SYNTAX               DirectoryString{32}
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraAccountCalendarUserType"}
  LDAP-DESC                 "calendar user type - USER (default) or RESOURCE"
  ID                        id-at-zimbraAccountCalendarUserType }

-- LDAP syntax length {1024} rendered as DirectoryString{1024}.
zimbraAccountClientAttr ATTRIBUTE ::= {
  WITH SYNTAX               DirectoryString{1024}
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraAccountClientAttr"}
  LDAP-DESC                 "Deprecated since: 5.0. deprecated in favor of the accountInfo flag. Orig desc: additional account attrs that get returned to a client"
  ID                        id-at-zimbraAccountClientAttr }

-- LDAP syntax length {256} rendered as DirectoryString{256}.
zimbraAccountExtraObjectClass ATTRIBUTE ::= {
  WITH SYNTAX               DirectoryString{256}
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraAccountExtraObjectClass"}
  LDAP-DESC                 "Object classes to add when creating a zimbra account object. Useful if you want to add sambaSamAccount etc to zimbra accounts."
  ID                        id-at-zimbraAccountExtraObjectClass }

-- LDAP syntax length {32} rendered as DirectoryString{32}.
zimbraAccountStatus ATTRIBUTE ::= {
  WITH SYNTAX               DirectoryString{32}
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraAccountStatus"}
  LDAP-DESC                 "account status. active - active lockout - no login until lockout duration is over, mail delivery OK. locked - no login, mail delivery OK. maintenance - no login, no delivery(lmtp server returns 4.x.x Persistent Transient Failure). pending - no login, no delivery(lmtp server returns 5.x.x Permanent Failure), Account behavior is like closed, except that when the status is being set to pending, account addresses are not removed from distribution lists. The use case is for hosted. New account creation based on invites that are not completed until user accepts TOS on account creation confirmation page. closed - no login, no delivery(lmtp server returns 5.x.x Permanent Failure), all addresses (account main email and all aliases) of the account are removed from all distribution lists."
  ID                        id-at-zimbraAccountStatus }

-- LDAP syntax length {32} rendered as DirectoryString{32}.
zimbraAdminAccessControlMech ATTRIBUTE ::= {
  WITH SYNTAX               DirectoryString{32}
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraAdminAccessControlMech"}
  LDAP-DESC                 "access control mechanism for admin access acl: ACL based access control (a.k.a. delegated admin). global: allows only global admins."
  ID                        id-at-zimbraAdminAccessControlMech }

zimbraAdminAuthTokenLifetime ATTRIBUTE ::= {
  WITH SYNTAX               IA5String(SIZE (1..32))
  EQUALITY MATCHING RULE    caseIgnoreIA5Match
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               ia5String.&id
  LDAP-NAME                 {"zimbraAdminAuthTokenLifetime"}
  LDAP-DESC                 "lifetime of newly created admin auth tokens. Must be in valid duration format: {digits}{time-unit}. digits: 0-9, time-unit: [hmsd]|ms. h - hours, m - minutes, s - seconds, d - days, ms - milliseconds. If time unit is not specified, the default is s(seconds)."
  ID                        id-at-zimbraAdminAuthTokenLifetime }

-- LDAP syntax length {128} rendered as DirectoryString{128}.
zimbraAdminBindAddress ATTRIBUTE ::= {
  WITH SYNTAX               DirectoryString{128}
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraAdminBindAddress"}
  LDAP-DESC                 "interface address on which Admin HTTPS server should listen; if empty, binds to all interfaces"
  ID                        id-at-zimbraAdminBindAddress }

zimbraAdminConsoleCatchAllAddressEnabled ATTRIBUTE ::= {
  WITH SYNTAX               BOOLEAN
  EQUALITY MATCHING RULE    booleanMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               boolean.&id
  LDAP-NAME                 {"zimbraAdminConsoleCatchAllAddressEnabled"}
  LDAP-DESC                 "whether to show catchall addresses in admin console"
  ID                        id-at-zimbraAdminConsoleCatchAllAddressEnabled }

zimbraAdminConsoleDNSCheckEnabled ATTRIBUTE ::= {
  WITH SYNTAX               BOOLEAN
  EQUALITY MATCHING RULE    booleanMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               boolean.&id
  LDAP-NAME                 {"zimbraAdminConsoleDNSCheckEnabled"}
  LDAP-DESC                 "enable MX check feature for domain"
  ID                        id-at-zimbraAdminConsoleDNSCheckEnabled }

zimbraAdminConsoleLDAPAuthEnabled ATTRIBUTE ::= {
  WITH SYNTAX               BOOLEAN
  EQUALITY MATCHING RULE    booleanMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               boolean.&id
  LDAP-NAME                 {"zimbraAdminConsoleLDAPAuthEnabled"}
  LDAP-DESC                 "whether configuring external LDAP auth is enabled in admin console"
  ID                        id-at-zimbraAdminConsoleLDAPAuthEnabled }

zimbraAdminConsoleLoginMessage ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraAdminConsoleLoginMessage"}
  LDAP-DESC                 "admin console login message"
  ID                        id-at-zimbraAdminConsoleLoginMessage }

-- LDAP syntax length {256} rendered as DirectoryString{256}.
zimbraAdminConsoleLoginURL ATTRIBUTE ::= {
  WITH SYNTAX               DirectoryString{256}
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraAdminConsoleLoginURL"}
  LDAP-DESC                 "login URL for admin console to send the user to upon explicit logging in"
  ID                        id-at-zimbraAdminConsoleLoginURL }

-- LDAP syntax length {256} rendered as DirectoryString{256}.
zimbraAdminConsoleLogoutURL ATTRIBUTE ::= {
  WITH SYNTAX               DirectoryString{256}
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraAdminConsoleLogoutURL"}
  LDAP-DESC                 "logout URL for admin console to send the user to upon explicit logging out"
  ID                        id-at-zimbraAdminConsoleLogoutURL }

zimbraAdminConsoleSkinEnabled ATTRIBUTE ::= {
  WITH SYNTAX               BOOLEAN
  EQUALITY MATCHING RULE    booleanMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               boolean.&id
  LDAP-NAME                 {"zimbraAdminConsoleSkinEnabled"}
  LDAP-DESC                 "whether to allow skin management in admin console"
  ID                        id-at-zimbraAdminConsoleSkinEnabled }

zimbraAdminConsoleUIComponents ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"zimbraAdminConsoleUIComponents"}
  LDAP-DESC                 "UI components available for the authed admin in admin console"
  ID                        id-at-zimbraAdminConsoleUIComponents }

zimbraAdminExtDisableUIUndeploy ATTRIBUTE ::= {
  WITH SYNTAX               BOOLEAN
  EQUALITY MATCHING RULE    booleanMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               boolean.&id
  LDAP-NAME                 {"zimbraAdminExtDisableUIUndeploy"}
  LDAP-DESC                 "Zimlet Util will set this attribute based on the value in zimlet definition XML file"
  ID                        id-at-zimbraAdminExtDisableUIUndeploy }

zimbraAdminImapImportNumThreads ATTRIBUTE ::= {
  WITH SYNTAX               INTEGER
  EQUALITY MATCHING RULE    integerMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               integer.&id
  LDAP-NAME                 {"zimbraAdminImapImportNumThreads"}
  LDAP-DESC                 "number of admin initiated imap import handler threads"
  ID                        id-at-zimbraAdminImapImportNumThreads }

zimbraAdminLocalBind ATTRIBUTE ::= {
  WITH SYNTAX               BOOLEAN
  EQUALITY MATCHING RULE    booleanMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               boolean.&id
  LDAP-NAME                 {"zimbraAdminLocalBind"}
  LDAP-DESC                 "Specifies whether the admin server should bound to localhost or not. This is an immutable property and is generated based on zimbraAdminBindAddress."
  ID                        id-at-zimbraAdminLocalBind }

zimbraAdminPort ATTRIBUTE ::= {
  WITH SYNTAX               INTEGER
  EQUALITY MATCHING RULE    integerMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               integer.&id
  LDAP-NAME                 {"zimbraAdminPort"}
