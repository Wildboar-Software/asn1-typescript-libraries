-- Derived from data/ldap-schema/ldapmigration/56ims-schema.ldif
-- This module is a container for LDAP schema. It has no module identifier.
-- X- extension fields from the LDAP schema are comments. USAGE userApplications and structural KIND are omitted because they are the defaults.
-- 3 elements were omitted because their OIDs are already defined. See CONVERSION-REPORT.txt.
-- 20 elements were omitted because another source file in this corpus defines the same OID.
Ldapmigration56imsSchema DEFINITIONS ::=
BEGIN

IMPORTS

  ATTRIBUTE, DistinguishedName, OBJECT-CLASS, top
    FROM InformationFramework
      {joint-iso-itu-t ds(5) module(1) informationFramework(1) 9} WITH SUCCESSORS

  caseIgnoreMatch, commonName, directoryString, dn, ia5String, integer,
    UnboundedDirectoryString
    FROM SelectedAttributeTypes
      {joint-iso-itu-t ds(5) module(1) selectedAttributeTypes(5) 9} WITH SUCCESSORS

  preferredLanguage
    FROM InetOrgPerson
      {iso(1) identified-organization(3) dod(6) internet(1) private(4) enterprise(1) wildboar(56490) module(1) inetorgperson(5)} WITH SUCCESSORS

  mailForwardingAddress, mailMessageStore
    FROM QMailSchema
      {iso(1) identified-organization(3) dod(6) internet(1) private(4) enterprise(1) wildboar(56490) module(1) qmail-schema(55)} WITH SUCCESSORS

  multiLineDescription
    FROM LdapCore389

  mailQuota
    FROM LdapDbmail

  mailAutoReplyMode, mailAutoReplyText, mailDeliveryOption,
    mailProgramDeliveryInfo, mgrpAddHeader, mgrpAllowedBroadcaster,
    mgrpAllowedDomain, mgrpBroadcasterPolicy, mgrpDeliverTo, mgrpErrorsTo,
    mgrpModerator, mgrpMsgMaxSize, mgrpMsgRejectAction, mgrpMsgRejectText,
    mgrpNoDuplicateChecks, mgrpRemoveHeader, nswmExtendedUserPrefs
    FROM Ldapmigration50nsMail

  mail
    FROM LdapSchema2ldifCore

  mailSieveRuleSource
    FROM LdapSchema2ldifPostfixBook

  mgrpRFC822MailMember
    FROM LdapSolaris ;

