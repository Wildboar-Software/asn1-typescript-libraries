BEGIN

IMPORTS

  ATTRIBUTE, DistinguishedName, OBJECT-CLASS, top
    FROM InformationFramework
      {joint-iso-itu-t ds(5) module(1) informationFramework(1) 9} WITH SUCCESSORS

  boolean, commonName, countryName, description, directoryString, dn,
    facsimileTelephoneNumber, generalizedTime, generalizedTimeMatch,
    generalizedTimeOrderingMatch, integer, localityName, name,
    organizationalUnitName, seeAlso, telephoneNr, telephoneNumber,
    TelephoneNumber, uid, UnboundedDirectoryString
