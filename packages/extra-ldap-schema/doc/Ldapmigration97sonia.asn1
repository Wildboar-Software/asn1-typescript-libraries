                              | soniaPermissionAdmin
                              | soniaPermissionMaxAssignments
                              | soniaPermissionAssignmentFilter }
  LDAP-NAME                 {"soniaPermissions"}
  ID                        id-oc-soniaPermissions }

-- X-ORIGIN: "SONIA"
soniaOrganizationalAccount OBJECT-CLASS ::= {
