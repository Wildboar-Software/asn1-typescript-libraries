                              | localityName }
  LDAP-NAME                 {"soniaOrganizationalAccount"}
  ID                        id-oc-soniaOrganizationalAccount }

-- X-ORIGIN: "SONIA"
soniaMailGroup OBJECT-CLASS ::= {
