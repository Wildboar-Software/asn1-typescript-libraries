  ID                        id-oc-soniaMapping }

-- X-ORIGIN: "SONIA"
soniaMailAccount OBJECT-CLASS ::= {
  SUBCLASS OF               { inetMailUser }
  MUST CONTAIN              { uid
                              | mail }
  MAY CONTAIN               { soniaMailDelegatedAddress }
  LDAP-NAME                 {"soniaMailAccount"}
  ID                        id-oc-soniaMailAccount }

