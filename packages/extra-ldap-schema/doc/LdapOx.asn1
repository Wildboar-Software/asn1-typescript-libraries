-- Attribute types

-- X-ORIGIN: "Gluu created attribute"
oxAssociatedClient ATTRIBUTE ::= {
  WITH SYNTAX               DistinguishedName
  EQUALITY MATCHING RULE    distinguishedNameMatch
  LDAP-SYNTAX               dn.&id
  LDAP-NAME                 {"oxAssociatedClient", "associatedClient"}
  LDAP-DESC                 "Associate the dn of an OAuth2 client with a person or UMA Resource Set."
  ID                        id-at-oxAssociatedClient }

-- X-ORIGIN: "Gluu created attribute"
associatedPerson ATTRIBUTE ::= {
  WITH SYNTAX               DistinguishedName
  EQUALITY MATCHING RULE    distinguishedNameMatch
  LDAP-SYNTAX               dn.&id
  LDAP-NAME                 {"associatedPerson"}
  LDAP-DESC                 "Reference the dn of a person."
  ID                        id-at-associatedPerson }

-- X-ORIGIN: "Gluu created attribute"
blowfishPassword ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"blowfishPassword"}
  LDAP-DESC                 "Blowfish crypted text"
  ID                        id-at-blowfishPassword }

-- X-ORIGIN: "Gluu created attribute"
county ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"county"}
  LDAP-DESC                 "ISO 3166-1 Alpha-2 Country Code"
  ID                        id-at-county }

-- X-ORIGIN: "Gluu created attribute"
creationDate ATTRIBUTE ::= {
  WITH SYNTAX               GeneralizedTime
  EQUALITY MATCHING RULE    generalizedTimeMatch
  ORDERING MATCHING RULE    generalizedTimeOrderingMatch
  LDAP-SYNTAX               generalizedTime.&id
  LDAP-NAME                 {"creationDate"}
  LDAP-DESC                 "Creation Date used for password reset requests"
  ID                        id-at-creationDate }

-- X-ORIGIN: "Gluu created attribute"
defaultScope ATTRIBUTE ::= {
  WITH SYNTAX               BOOLEAN
  EQUALITY MATCHING RULE    booleanMatch
