apple-preset-group OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { commonName }
  MAY CONTAIN               { memberUid
                              | gidNumber
                              | description
                              | apple-group-homeurl
                              | apple-group-homeowner
                              | apple-mcxflags
                              | apple-mcxsettings
                              | apple-group-realname
                              | apple-keyword
                              | apple-group-nestedgroup
                              | apple-group-memberguid
                              | ttl }
  LDAP-NAME                 {"apple-preset-group"}
  LDAP-DESC                 "preset group"
  ID                        id-oc-apple-preset-group }

apple-preset-user OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { commonName }
  MAY CONTAIN               { uid
                              | memberUid
                              | gidNumber
                              | homeDirectory
                              | apple-user-homeurl
                              | apple-user-homequota
                              | apple-user-homesoftquota
                              | apple-user-mailattribute
                              | apple-user-printattribute
                              | apple-mcxflags
                              | apple-mcxsettings
                              | apple-user-adminlimits
                              | apple-user-passwordpolicy
                              | userPassword
                              | apple-user-picture
                              | apple-keyword
                              | loginShell
                              | description
                              | shadowLastChange
                              | shadowExpire
                              | authAuthority
                              | homeDrive
                              | scriptPath
                              | profilePath
                              | smbHome
                              | apple-preset-user-is-admin }
  LDAP-NAME                 {"apple-preset-user"}
  LDAP-DESC                 "preset user"
  ID                        id-oc-apple-preset-user }

authAuthorityObject OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MAY CONTAIN               { authAuthority }
  LDAP-NAME                 {"authAuthorityObject"}
  ID                        id-oc-authAuthorityObject }

apple-serverassistant-config OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { commonName }
  MAY CONTAIN               { apple-xmlplist }
  LDAP-NAME                 {"apple-serverassistant-config"}
  ID                        id-oc-apple-serverassistant-config }

apple-location OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MUST CONTAIN              { commonName }
  MAY CONTAIN               { apple-dns-domain
                              | apple-dns-nameserver }
  LDAP-NAME                 {"apple-location"}
  ID                        id-oc-apple-location }

apple-service OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { commonName
                              | apple-service-type }
  MAY CONTAIN               { ipHostNumber
                              | description
                              | apple-service-location
                              | apple-service-url
                              | apple-service-port
                              | apple-dnsname
                              | apple-keyword }
  LDAP-NAME                 {"apple-service"}
  ID                        id-oc-apple-service }

apple-neighborhood OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { commonName }
  MAY CONTAIN               { description
                              | apple-generateduid
                              | apple-category
                              | apple-nodepathxml
                              | apple-neighborhoodalias
                              | apple-computeralias
                              | apple-keyword
                              | apple-realname
                              | apple-xmlplist
                              | ttl }
  LDAP-NAME                 {"apple-neighborhood"}
  ID                        id-oc-apple-neighborhood }

apple-acl OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { commonName
                              | apple-acl-entry }
  LDAP-NAME                 {"apple-acl"}
  ID                        id-oc-apple-acl }
END