-- Commented out in apple.schema while live classes still listed authAuthority. The definition at 1.3.6.1.4.1.63.1000.1.1.2.16.1 was restored. A second block at 1.3.6.1.4.1.63.1000.1.1.2.16.2 was left commented because it gives the same name another OID.
authAuthority ATTRIBUTE ::= {
  WITH SYNTAX               IA5String
  EQUALITY MATCHING RULE    caseExactIA5Match
  SUBSTRINGS MATCHING RULE  caseExactIA5SubstringsMatch
  LDAP-SYNTAX               ia5String.&id
  LDAP-NAME                 {"authAuthority"}
  LDAP-DESC                 "password server authentication authority"
  ID                        id-at-authAuthority }

