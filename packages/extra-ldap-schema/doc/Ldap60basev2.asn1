-- X-ORIGIN: "IPA v2"
-- SUP was absent. RFC 4512 treats that as a subclass of top, so SUBCLASS OF { top } was added.
ipaAssociation OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      abstract
  MUST CONTAIN              { ipaUniqueID
                              | commonName }
  MAY CONTAIN               { memberUser
                              | userCategory
                              | memberHost
                              | hostCategory
                              | ipaEnabledFlag
                              | description }
  LDAP-NAME                 {"ipaAssociation"}
  ID                        id-oc-ipaAssociation }

-- X-ORIGIN: "IPA v2"
ipaHBACRule OBJECT-CLASS ::= {
