-- Derived from data/ldap-schema/60basev2.ldif
-- Upstream: https://github.com/freeipa/freeipa/blob/master/install/share/60basev2.ldif
-- This module is a container for LDAP schema. It has no module identifier.
-- X- extension fields from the LDAP schema are comments. USAGE userApplications and structural KIND are omitted because they are the defaults.
-- 2 elements were omitted because their OIDs are already defined. See CONVERSION-REPORT.txt.
-- 3 elements were omitted because another source file in this corpus defines the same OID.
-- Object classes with no SUP were subclassed from top, the LDAP default (RFC 4512).
Ldap60basev2 DEFINITIONS ::=
BEGIN

IMPORTS

  ATTRIBUTE, DistinguishedName, distinguishedNameMatch, OBJECT-CLASS, top
    FROM InformationFramework
      {joint-iso-itu-t ds(5) module(1) informationFramework(1) 9} WITH SUCCESSORS

  boolean, booleanMatch, caseExactMatch, caseIgnoreMatch,
    caseIgnoreOrderingMatch, caseIgnoreSubstringsMatch, commonName,
    description, directoryString, distinguishedName, dn, integer, integerMatch,
    member, UnboundedDirectoryString
    FROM SelectedAttributeTypes
      {joint-iso-itu-t ds(5) module(1) selectedAttributeTypes(5) 9} WITH SUCCESSORS

  groupOfNames
    FROM SelectedObjectClasses
      {joint-iso-itu-t ds(5) module(1) selectedObjectClasses(6) 9} WITH SUCCESSORS

  userCertificate, userPassword
    FROM AuthenticationFramework
      {joint-iso-itu-t ds(5) module(1) authenticationFramework(7) 9} WITH SUCCESSORS

  memberOf
    FROM OrganizationAndGroupSchema
      {iso(1) identified-organization(3) dod(6) internet(1) private(4) enterprise(1) wildboar(56490) module(1) org-group-schema(166)} WITH SUCCESSORS

  userPKCS12
    FROM PKCS-9
      {iso(1) member-body(2) us(840) rsadsi(113549) pkcs(1) pkcs-9(9) modules(0) pkcs-9(1)} WITH SUCCESSORS

  passwordGraceLimit
    FROM LdapCommon389

  userClass
    FROM LdapSchema2ldifCosine ;

