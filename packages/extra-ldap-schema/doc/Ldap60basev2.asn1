  MAY CONTAIN               { ipaPermissionType }
  LDAP-NAME                 {"ipaPermission"}
  LDAP-DESC                 "IPA Permission objectclass"
  ID                        id-oc-ipaPermission }

-- X-ORIGIN: "IPA v2"
-- SUP was absent. RFC 4512 treats that as a subclass of top, so SUBCLASS OF { top } was added.
ipaService OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MAY CONTAIN               { memberOf
                              | managedBy
                              | ipaKrbAuthzData }
  LDAP-NAME                 {"ipaService"}
  LDAP-DESC                 "IPA service objectclass"
  ID                        id-oc-ipaService }

-- X-ORIGIN: "IPA v2"
nestedGroup OBJECT-CLASS ::= {
  SUBCLASS OF               { groupOfNames }
