  LDAP-NAME                 {"nestedGroup"}
  LDAP-DESC                 "Group that supports nesting"
  ID                        id-oc-nestedGroup }

-- X-ORIGIN: "IPA v2"
ipaUserGroup OBJECT-CLASS ::= {
