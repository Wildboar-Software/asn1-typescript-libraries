-- Object classes

-- X-ORIGIN: "IPA v2"
-- SUP was absent. RFC 4512 treats that as a subclass of top, so SUBCLASS OF { top } was added.
ipaHost OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MUST CONTAIN              { fqdn }
  MAY CONTAIN               { userPassword
                              | ipaClientVersion
                              | enrolledBy
                              | memberOf
                              | userClass
                              | ipaAssignedIDView }
  LDAP-NAME                 {"ipaHost"}
  ID                        id-oc-ipaHost }

-- X-ORIGIN: "IPA v2"
-- SUP was absent. RFC 4512 treats that as a subclass of top, so SUBCLASS OF { top } was added.
ipaObject OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MUST CONTAIN              { ipaUniqueID }
  LDAP-NAME                 {"ipaObject"}
  LDAP-DESC                 "IPA objectclass"
  ID                        id-oc-ipaObject }

-- X-ORIGIN: "IPA v2"
-- SUP was absent. RFC 4512 treats that as a subclass of top, so SUBCLASS OF { top } was added.
ipaEntitlement OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MUST CONTAIN              { ipaEntitlementId }
  MAY CONTAIN               { userPKCS12
                              | userCertificate }
  LDAP-NAME                 {"ipaEntitlement"}
  LDAP-DESC                 "IPA Entitlement object"
  ID                        id-oc-ipaEntitlement }

-- X-ORIGIN: "IPA v2"
-- SUP was absent. RFC 4512 treats that as a subclass of top, so SUBCLASS OF { top } was added.
ipaPermission OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
