-- Derived from data/ldap-schema/schema2ldif/microsoft.schema
-- This module is a container for LDAP schema. It has no module identifier.
-- X- extension fields from the LDAP schema are comments. USAGE userApplications and structural KIND are omitted because they are the defaults.
-- 12 elements were omitted because another source file in this corpus defines the same OID.
-- 6 elements share a numeric OID with another element that was also kept. See the comments on those elements.
-- 5 elements were kept even though an existing module uses their numeric OID under a different name.
LdapSchema2ldifMicrosoft DEFINITIONS ::=
BEGIN

IMPORTS

  ATTRIBUTE, OBJECT-CLASS, top
    FROM InformationFramework
      {joint-iso-itu-t ds(5) module(1) informationFramework(1) 9} WITH SUCCESSORS

  commonName, dc, description, serialNumber, telephoneNumber
    FROM SelectedAttributeTypes
      {joint-iso-itu-t ds(5) module(1) selectedAttributeTypes(5) 9} WITH SUCCESSORS

  locality, organizationalPerson
    FROM SelectedObjectClasses
      {joint-iso-itu-t ds(5) module(1) selectedObjectClasses(6) 9} WITH SUCCESSORS

  cACertificate, userCertificate
    FROM AuthenticationFramework
      {joint-iso-itu-t ds(5) module(1) authenticationFramework(7) 9} WITH SUCCESSORS

  userSMIMECertificate
    FROM H323-X500-Schema
      {iso(1) identified-organization(3) dod(6) internet(1) private(4) enterprise(1) wildboar(56490) module(1) h323-x500-schema(1000)} WITH SUCCESSORS

  managedBy
    FROM Ldap60basev2

  sAMAccountName
    FROM LdapSamaccountname

  textEncodedORAddress
    FROM LdapSchema2ldifCosine

  connectionPoint, leaf, serviceConnectionPoint
    FROM LdapSchema2ldifFmserver ;

