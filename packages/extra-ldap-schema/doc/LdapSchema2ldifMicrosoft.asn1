                              | dhcpUpdateTime }
  LDAP-NAME                 {"dHCPClass"}
  ID                        id-oc-dHCPClass }

ipsecBase OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      abstract
