-- Object classes

-- OID 1.2.840.113556.1.5.24 is also used by remoteMailRecipient (CONTENT-RULE) in schema2ldif/microsoft.ext.schema. The names match, but the element kinds differ, so each definition was kept.
remoteMailRecipient OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MAY CONTAIN               { remoteSource
                              | remoteSourceType
                              | managedBy }
  LDAP-NAME                 {"remoteMailRecipient"}
  ID                        id-oc-remoteMailRecipient }

packageRegistration OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MAY CONTAIN               { msiScriptPath
                              | cOMClassID
                              | cOMInterfaceID
                              | cOMProgID
                              | localeID
                              | machineArchitecture
                              | iconPath
                              | cOMTypelibId
                              | vendor
                              | packageType
                              | setupCommand
                              | packageName
                              | packageFlags
                              | versionNumberHi
                              | versionNumberLo
                              | lastUpdateSequence
                              | managedBy
                              | msiFileList
                              | categories
                              | upgradeProductCode
                              | msiScript
                              | canUpgradeScript
                              | fileExtPriority
                              | productCode
                              | msiScriptName
                              | msiScriptSize
                              | installUiLevel }
  LDAP-NAME                 {"packageRegistration"}
  ID                        id-oc-packageRegistration }

mSMQQueue OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MAY CONTAIN               { mSMQQueueType
                              | mSMQJournal
                              | mSMQBasePriority
                              | mSMQLabel
                              | mSMQAuthenticate
                              | mSMQPrivacyLevel
                              | mSMQOwnerID
                              | mSMQTransactional
                              | mSMQQueueQuota
                              | mSMQQueueJournalQuota
                              | mSMQQueueNameExt }
  LDAP-NAME                 {"mSMQQueue"}
  ID                        id-oc-mSMQQueue }

rpcServer OBJECT-CLASS ::= {
  SUBCLASS OF               { rpcEntry }
  MAY CONTAIN               { rpcNsObjectID
                              | rpcNsCodeset
                              | rpcNsEntryFlags }
  LDAP-NAME                 {"rpcServer"}
  ID                        id-oc-rpcServer }

samServer OBJECT-CLASS ::= {
  SUBCLASS OF               { securityObject }
  LDAP-NAME                 {"samServer"}
  ID                        id-oc-samServer }

rRASAdministrationDictionary OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MAY CONTAIN               { msRRASVendorAttributeEntry }
  LDAP-NAME                 {"rRASAdministrationDictionary"}
  ID                        id-oc-rRASAdministrationDictionary }

aCSSubnet OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MAY CONTAIN               { aCSMaxTokenRatePerFlow
                              | aCSMaxPeakBandwidthPerFlow
                              | aCSMaxDurationPerFlow
                              | aCSAllocableRSVPBandwidth
                              | aCSMaxPeakBandwidth
                              | aCSEnableRSVPMessageLogging
