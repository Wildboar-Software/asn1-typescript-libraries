    LDAP-DESC				    "Cumulative Number of Applicants over all time"
    ID						    id-at-applicantsCount
}

applicantsCountTTM ATTRIBUTE ::= {
    WITH SYNTAX				    INTEGER (0..MAX)
    EQUALITY MATCHING RULE	    integerMatch
    ORDERING MATCHING RULE	    integerOrderingMatch
    LDAP-SYNTAX				    integer.&id
    LDAP-NAME				    {"applicantsCountTTM"}
    LDAP-DESC				    "Number of Applicants over the Last Twelve Months"
    ID						    id-at-applicantsCountTTM
}

meanMemberAge ATTRIBUTE ::= {
    WITH SYNTAX                 REAL (0.0..1.0)
    EQUALITY MATCHING RULE      realMatch
    ORDERING MATCHING RULE      realOrderingMatch
    LDAP-SYNTAX				    real.&id
    LDAP-NAME				    {"meanMemberAge"}
    LDAP-DESC				    "Mean Member Age"
    ID						    id-at-meanMemberAge
}

medianMemberAge ATTRIBUTE ::= {
    WITH SYNTAX                 REAL (0.0..1.0)
    EQUALITY MATCHING RULE      realMatch
    ORDERING MATCHING RULE      realOrderingMatch
    LDAP-SYNTAX				    real.&id
    LDAP-NAME				    {"medianMemberAge"}
    LDAP-DESC				    "Median Member Age"
    ID						    id-at-medianMemberAge
}

highestMemberAge ATTRIBUTE ::= {
    WITH SYNTAX                 REAL (0.0..1.0)
    EQUALITY MATCHING RULE      realMatch
    ORDERING MATCHING RULE      realOrderingMatch
    LDAP-SYNTAX				    real.&id
    LDAP-NAME				    {"highestMemberAge"}
    LDAP-DESC				    "Highest Member Age"
    ID						    id-at-highestMemberAge
}

lowestMemberAge ATTRIBUTE ::= {
    WITH SYNTAX                 REAL (0.0..1.0)
    EQUALITY MATCHING RULE      realMatch
    ORDERING MATCHING RULE      realOrderingMatch
    LDAP-SYNTAX				    real.&id
    LDAP-NAME				    {"lowestMemberAge"}
    LDAP-DESC				    "Lowest Member Age"
    ID						    id-at-lowestMemberAge
}

vettingRequirements ATTRIBUTE ::= {
    WITH SYNTAX				    VettingRequirements
    EQUALITY MATCHING RULE	    objectIdentifierMatch
    LDAP-SYNTAX				    oid.&id
    LDAP-NAME				    {"vettingRequirements"}
    LDAP-DESC				    "The object identifier of a category of vetting procedures required"
    ID						    id-at-vettingRequirements
}

-- Attribute Sets

MembershipStatsAttributes ATTRIBUTE ::= {
    membersCount
    | activeMembersCount
    | dormantMembersCount
    | formerMembersCount
}

MembershipTermsAttributes ATTRIBUTE ::= {
    membershipTerm
    | memberNoun
    | memberSingularNoun
    | memberPluralNoun
    | memberSlangNoun
}

MembershipLifecycleProcedureDescriptions ATTRIBUTE ::= {
    vettingProcedureDescription
    | onboardingProcedureDescription
    | offboardingProcedureDescription
    | renewalProcedureDescription
    | vettingRequirements
}

RacialRequirements ATTRIBUTE ::= {
    requiredContinentalRace
    | requiredCountryRace
    | requiredRegionalRace
}

RacialExclusions ATTRIBUTE ::= {
    forbiddenContinentalRace
    | forbiddenCountryRace
    | forbiddenRegionalRace
}

MembershipRequirementsAttributes ATTRIBUTE ::= {
    minAgeToJoin
    | maxAgeToJoin
    | allowsMen
    | allowsWomen
    | allowsHeterosexuals
    | allowsAltSexuals
    | allowsForeigners
    | requiresReligion
    | forbidsReligion
    | RacialRequirements
    | RacialExclusions
    | drugTestRequired
    | forbidsMembershipWithDN
    | eligibilityFilter
    | eligibilityNoSubtypesFilter
    | ideologicalRequirementsDescription
    | healthRequirementsDescription
    | requiredVaccinationAgainst
}

OrganizationBylawsAttributes ATTRIBUTE ::= {
    hasDrugTestingRequirement
    | hasNonDisclosureRequirement
    | membershipIsSecret
    | ownMembershipIsSecret
    | membershipOath
    | bylawsUrl
    | bylawsText
}

CLevelLeadershipAttributes ATTRIBUTE ::= {
    chiefExecutiveOfficerDN
    | chiefFinancialOfficerDN
    | chiefOperationsOfficerDN
    | chiefInformationOfficerDN
    | chiefTechnologyOfficerDN
    | chiefMarketingOfficerDN
    | chiefHumanResourcesOfficerDN
    | chiefInformationSecurityOfficerDN
    | chiefLegalOfficerDN
    | chiefDiversityOfficerDN
}

LeadershipAttributes ATTRIBUTE ::= {
    leaderDN
    | presidentDN
    | vicePresidentDN
    | treasurerDN
    | secretaryDN
    | historianDN
}

MemberAndSubtypes ATTRIBUTE ::= {
    member
    | publicMemberDN
    | privateMemberDN
}

UniqueMemberAndSubtypes ATTRIBUTE ::= {
    uniqueMember
    | publicUniqueMember
    | privateUniqueMember
}

MemberOfAndSubtypes ATTRIBUTE ::= {
    memberOf
    | publicMemberOf
    | privateMemberOf
}

MembershipRelationAttributes ATTRIBUTE ::= {
    MemberAndSubtypes
    | UniqueMemberAndSubtypes
    | MemberOfAndSubtypes
}

OrganizationalFinanceAttributes ATTRIBUTE ::= {
    BasicBalanceSheetAttributes
    | BasicIncomeStatementAttributes
    | FinanceAttributes
    | AccountingAttributes
    | topDonorDN
}

ContributionAttributes ATTRIBUTE ::= {contributorDN | topContributorDN}

OrganizationalRelationAttributes ATTRIBUTE ::= {
    affiliateDN
    | subsidiaryDN
    | parentOrganizationDN
    | shellCorporationDN
    | frontOrganizationDN
}

AdmissionRateStatAttributes ATTRIBUTE ::= {
    admissionRate
    | admissionRateForMales
    | admissionRateForFemales
    | admissionRateForCollegeEducated
    | admissionRateForMarried
    | admissionRateForNonCollegeEducated
    | admissionRateForNonMarried,
    ...
}

MembershipStatAttributes ATTRIBUTE ::= {
    AdmissionRateStatAttributes
    | applicantsCount
    | applicantsCountTTM
    | malePopulationPercentage
    | meanSalary
    | medianSalary
    | highestSalary
    | lowestSalary
    | collegeEducatedMembersPercentage
    | marriedMembersPercentage
    | meanMemberAge
    | medianMemberAge
    | highestMemberAge
    | lowestMemberAge,
    ...
}

ExtOrganizationOrGroupAttributes ATTRIBUTE ::= {
    MembershipStatsAttributes
    | MembershipTermsAttributes
    | MembershipLifecycleProcedureDescriptions
    | MembershipRequirementsAttributes
    | OrganizationBylawsAttributes
    | MembershipRelationAttributes
    | OrganizationalDescriptionAttributes
    | FundingAttributes
    | OrganizationalFinanceAttributes
    | PositiveComplianceAttributes
    | CreationAttributes
    | BusinessCategoryTypes
    | ThemeColorAttributes
    | VerbalContentAttributes
    | ContributionAttributes
    | MembershipStatAttributes
    | missionStatement
    | faviconPNG
    | symbolUrl
    | symbolDescription
    | anthemName
    | timeToLiveDuration -- Controls client caching of the group membership
    | associatedDomain
    | dnsName
    | category
    | rules
    | keyword
    | url
}

-- Attributes for organizations, but not groups / roles
ExtOrganizationalAttributes ATTRIBUTE ::= {
    ExtOrganizationOrGroupAttributes
    | OrganizationIdentifierTypes
    | BillingPostalAttributeSet
    | HeadquartersPostalAttributeSet
    | MailingPostalAttributeSet
    | PrincipalPostalAttributeSet
    | OrganizationalPhoneAttributeSet
    | OrganizationalFaxAttributeSet
    | OrganizationalEmailAttributeSet
    | OrganizationalUrls
    | LeadershipAttributes
    | TaxpayerAttributes
    | CLevelLeadershipAttributes
    | OrganizationalRelationAttributes
    | owner
    | organizationIdentifier
    | taxIdentifier
    | stakeholderDN
    | beneficiaryDN
    | directorDN
}

-- Object Classes

organizationExt OBJECT-CLASS ::= {
    SUBCLASS OF			{organization}
    KIND				structural
    MAY CONTAIN			{ExtOrganizationalAttributes}
    LDAP-NAME			{"organizationExt"}
    LDAP-DESC			"An organization"
    ID					id-oc-organizationExt
}

organizationalUnitExt OBJECT-CLASS ::= {
    SUBCLASS OF         {organizationalUnit}
    KIND                structural
    MAY CONTAIN         {ExtOrganizationalAttributes}
    LDAP-NAME           {"organizationalUnitExt"}
    LDAP-DESC           "An organizational unit"
    ID                  id-oc-organizationalUnitExt
}

organizationalRoleExt OBJECT-CLASS ::= {
    SUBCLASS OF         {organizationalRole}
    KIND                structural
    MAY CONTAIN         {ExtOrganizationOrGroupAttributes}
    LDAP-NAME           {"organizationalRoleExt"}
    LDAP-DESC           "An organizational role"
    ID                  id-oc-organizationalRoleExt
}

groupOfNamesExt OBJECT-CLASS ::= {
    SUBCLASS OF         {groupOfNames}
    KIND                structural
    MAY CONTAIN         {ExtOrganizationOrGroupAttributes}
    LDAP-NAME           {"groupOfNamesExt"}
    LDAP-DESC           "A group of names"
    ID                  id-oc-groupOfNamesExt
}

groupOfUniqueNamesExt OBJECT-CLASS ::= {
    SUBCLASS OF         {groupOfUniqueNames}
    KIND                structural
    MAY CONTAIN         {ExtOrganizationOrGroupAttributes}
    LDAP-NAME           {"groupOfUniqueNamesExt"}
    LDAP-DESC           "A group of unique names"
    ID                  id-oc-groupOfUniqueNamesExt
}

-- // TODO: Fill these in

boardOfDirectors OBJECT-CLASS ::= {
    SUBCLASS OF			{top}
    KIND				auxiliary
    MUST CONTAIN		{}
    MAY CONTAIN			{}
    LDAP-NAME			{"boardOfDirectors"}
    LDAP-DESC			"Board of Directors"
    ID					id-oc-boardOfDirectors
}

vorstand OBJECT-CLASS ::= {
    SUBCLASS OF			{top}
    KIND				auxiliary
    MUST CONTAIN		{}
    MAY CONTAIN			{}
    LDAP-NAME			{"vorstand"}
    LDAP-DESC			"Vorstand"
    ID					id-oc-vorstand
}

committee OBJECT-CLASS ::= {
    SUBCLASS OF			{top}
    KIND				auxiliary
    MUST CONTAIN		{}
    MAY CONTAIN			{
        committeeType -- executive, conference, standing, nominating, steering, special
    }
    LDAP-NAME			{"committee"}
    LDAP-DESC			"Committee"
    ID					id-oc-committee
}

caucus OBJECT-CLASS ::= {
    SUBCLASS OF			{top}
    KIND				auxiliary
    MUST CONTAIN		{}
    MAY CONTAIN			{}
    LDAP-NAME			{"caucus"}
    LDAP-DESC			"Caucus"
    ID					id-oc-caucus
}

