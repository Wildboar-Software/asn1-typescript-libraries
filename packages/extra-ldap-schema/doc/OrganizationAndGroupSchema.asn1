-- Value Sets

VettingRequirements OBJECT IDENTIFIER ::= {
    id-vetreq-backgroundCheck
    | id-vetreq-creditCheck
    | id-vetreq-criminalHistoryCheck
    | id-vetreq-employmentHistoryCheck
    | id-vetreq-drugTest
    | id-vetreq-medicalRecordsCheck
    | id-vetreq-familyBackgroundCheck
    | id-vetreq-letterOfRecommendation
    | id-vetreq-intelligenceTest
    | id-vetreq-medicalInspection
    | id-vetreq-physicalFitness
    | id-vetreq-residentialHistoryCheck
    | id-vetreq-relationshipHistoryCheck
    | id-vetreq-oath
    | id-vetreq-nonDisclsoureAgreement
    | id-vetreq-polygraph
    | id-vetreq-demonstrativeAct
    | id-vetreq-incomeVerification
    | id-vetreq-academicHistoryCheck,
    ...
}

-- Attribute Types

membersCount ATTRIBUTE ::= {
    WITH SYNTAX				    INTEGER (0..MAX)
    EQUALITY MATCHING RULE	    integerMatch
    ORDERING MATCHING RULE	    integerOrderingMatch
    LDAP-SYNTAX				    integer.&id
    LDAP-NAME				    {"membersCount"}
    LDAP-DESC				    "The number of members in a group, organization, unit, team, etc."
    ID						    id-at-membersCount
}

activeMembersCount ATTRIBUTE ::= {
    SUBTYPE OF                  membersCount
    LDAP-SYNTAX				    integer.&id
    LDAP-NAME				    {"activeMembersCount"}
    LDAP-DESC				    "The active number of members, in contrast to dormant, reserve, retired, etc. members"
    ID						    id-at-activeMembersCount
}

dormantMembersCount ATTRIBUTE ::= {
    SUBTYPE OF                  membersCount
    LDAP-SYNTAX				    integer.&id
    LDAP-NAME				    {"dormantMembersCount"}
    LDAP-DESC				    "The number of members that have memberships that have lapsed, but which did not formally leave"
    ID						    id-at-dormantMembersCount
}

formerMembersCount ATTRIBUTE ::= {
    SUBTYPE OF                  membersCount
    LDAP-SYNTAX				    integer.&id
    LDAP-NAME				    {"formerMembersCount"}
    LDAP-DESC				    "The number of former members of a group, organization, unit, team, etc."
    ID						    id-at-formerMembersCount
}

minAgeToJoin ATTRIBUTE ::= {
    WITH SYNTAX				    INTEGER (0..MAX)
    EQUALITY MATCHING RULE	    integerMatch
    ORDERING MATCHING RULE	    integerOrderingMatch
    LDAP-SYNTAX				    integer.&id
    LDAP-NAME				    {"minAgeToJoin"}
    LDAP-DESC				    "The minimum age (inclusively) required to be a member of a group, organization, unit, team, etc."
    ID						    id-at-minAgeToJoin
}

maxAgeToJoin ATTRIBUTE ::= {
    WITH SYNTAX				    INTEGER (0..MAX)
    EQUALITY MATCHING RULE      integerMatch
    ORDERING MATCHING RULE      integerOrderingMatch
    LDAP-SYNTAX				    integer.&id
    LDAP-NAME				    {"maxAgeToJoin"}
    LDAP-DESC				    "The maximum age (inclusively) allowed to be a member of a group, organization, unit, team, etc."
    ID						    id-at-maxAgeToJoin
}

membershipTerm ATTRIBUTE ::= {
    WITH SYNTAX				    UnboundedDirectoryString
    EQUALITY MATCHING RULE	    caseIgnoreMatch
    ORDERING MATCHING RULE	    caseIgnoreOrderingMatch
    SUBSTRINGS MATCHING RULE    caseIgnoreSubstringsMatch
    LDAP-SYNTAX				    directoryString.&id
    LDAP-NAME				    {"membershipTerm"}
    LDAP-DESC				    "The term used to describe membership, such as 'Brotherhood', 'Goobership', etc."
    ID						    id-at-membershipTerm
}

memberNoun ATTRIBUTE ::= {
    WITH SYNTAX				    UnboundedDirectoryString
    EQUALITY MATCHING RULE	    caseIgnoreMatch
    ORDERING MATCHING RULE	    caseIgnoreOrderingMatch
    SUBSTRINGS MATCHING RULE    caseIgnoreSubstringsMatch
    LDAP-SYNTAX				    directoryString.&id
    LDAP-NAME				    {"memberNoun"}
    LDAP-DESC				    "Term used to describe a member of a group, such as 'Wombat', 'Sister', 'Viking', etc."
    ID						    id-at-memberNoun
}

memberSingularNoun ATTRIBUTE ::= {
    SUBTYPE OF                  memberNoun
    LDAP-SYNTAX			        directoryString.&id
    LDAP-NAME			        {"memberSingularNoun"}
    LDAP-DESC			        "Singular noun used as a term for a member of this group, such as 'Goober'"
    ID					        id-at-memberSingularNoun
}

memberPluralNoun ATTRIBUTE ::= {
    SUBTYPE OF                  memberNoun
    LDAP-SYNTAX				    directoryString.&id
    LDAP-NAME				    {"memberPluralNoun"}
    LDAP-DESC				    "Plural noun used as a term for members of this group, such as 'Goobers'"
    ID						    id-at-memberPluralNoun
}

memberSlangNoun ATTRIBUTE ::= {
    SUBTYPE OF                  memberNoun
    LDAP-SYNTAX				    directoryString.&id
    LDAP-NAME				    {"memberSlangNoun"}
    LDAP-DESC				    "A slang term used for members of this group, such as 'Goobs'"
    ID						    id-at-memberSlangNoun
}

vettingProcedureDescription ATTRIBUTE ::= {
    WITH SYNTAX				    UnboundedDirectoryString
    SUBSTRINGS MATCHING RULE    caseIgnoreSubstringsMatch
    LDAP-SYNTAX				    directoryString.&id
    LDAP-NAME				    {"vettingProcedureDescription"}
    LDAP-DESC				    "A description of the vetting procedures for obtaining membership in a group"
    ID						    id-at-vettingProcedureDescription
}

onboardingProcedureDescription ATTRIBUTE ::= {
    WITH SYNTAX				    UnboundedDirectoryString
    SUBSTRINGS MATCHING RULE    caseIgnoreSubstringsMatch
    LDAP-SYNTAX				    directoryString.&id
    LDAP-NAME				    {"onboardingProcedureDescription"}
    LDAP-DESC				    "A description of the onboarding procedures for becoming a member of a group"
    ID						    id-at-onboardingProcedureDescription
}

offboardingProcedureDescription ATTRIBUTE ::= {
    WITH SYNTAX				    UnboundedDirectoryString
    SUBSTRINGS MATCHING RULE    caseIgnoreSubstringsMatch
    LDAP-SYNTAX				    directoryString.&id
    LDAP-NAME				    {"offboardingProcedureDescription"}
    LDAP-DESC				    "A description of the offboarding procedures for members leaving a group"
    ID						    id-at-offboardingProcedureDescription
}

renewalProcedureDescription ATTRIBUTE ::= {
    WITH SYNTAX				    UnboundedDirectoryString
    SUBSTRINGS MATCHING RULE    caseIgnoreSubstringsMatch
    LDAP-SYNTAX				    directoryString.&id
    LDAP-NAME				    {"renewalProcedureDescription"}
    LDAP-DESC				    "A description of the procedures for renewing membership in a group"
    ID						    id-at-renewalProcedureDescription
}

healthRequirementsDescription ATTRIBUTE ::= {
    WITH SYNTAX				    UnboundedDirectoryString
    SUBSTRINGS MATCHING RULE    caseIgnoreSubstringsMatch
    LDAP-SYNTAX				    directoryString.&id
    LDAP-NAME				    {"healthRequirementsDescription"}
    LDAP-DESC				    "A description of health requirements for membership in a group"
    ID						    id-at-healthRequirementsDescription
}

membershipOath ATTRIBUTE ::= {
    WITH SYNTAX				    UnboundedDirectoryString
    SUBSTRINGS MATCHING RULE    caseIgnoreSubstringsMatch
    LDAP-SYNTAX				    directoryString.&id
    LDAP-NAME				    {"membershipOath"}
    LDAP-DESC				    "The oath required of members to join a group"
    ID						    id-at-membershipOath
}

bylawsText ATTRIBUTE ::= {
    WITH SYNTAX				    UnboundedDirectoryString
    SUBSTRINGS MATCHING RULE    caseIgnoreSubstringsMatch
    LDAP-SYNTAX				    directoryString.&id
    LDAP-NAME				    {"bylawsText"}
    LDAP-DESC				    "The text of the bylaws of a group, organization, unit, team, etc"
    ID						    id-at-bylawsText
}

allowsMen ATTRIBUTE ::= {
    WITH SYNTAX				    BOOLEAN
    EQUALITY MATCHING RULE	    booleanMatch
    LDAP-SYNTAX				    boolean.&id
    LDAP-NAME				    {"allowsMen"}
    LDAP-DESC				    "Whether a group / organization allows men to join"
