-- Name Forms

organizationExtNameForm NAME-FORM ::= {
    NAMES			    organizationExt
    WITH ATTRIBUTES	    orgNameForm.&MandatoryAttributes -- organizationName
    LDAP-NAME		    {"organizationExtNameForm"}
    ID				    id-nf-organizationExtNameForm
}

organizationalRoleExtNameForm NAME-FORM ::= {
    NAMES			    organizationalRoleExt
    WITH ATTRIBUTES	    orgRoleNameForm.&MandatoryAttributes -- commonName
    LDAP-NAME		    {"organizationalRoleExtNameForm"}
    ID				    id-nf-organizationalRoleExtNameFo
}

groupOfNamesExtNameForm NAME-FORM ::= {
    NAMES			    groupOfNamesExt
    WITH ATTRIBUTES	    gONNameForm.&MandatoryAttributes -- commonName
    LDAP-NAME		    {"groupOfNamesExtNameForm"}
    ID				    id-nf-groupOfNamesExtNameForm
}

groupOfUniqueNamesExtNameForm NAME-FORM ::= {
    NAMES			    groupOfUniqueNamesExt
    WITH ATTRIBUTES	    {commonName}
    LDAP-NAME		    {"groupOfUniqueNamesExtNameForm"}
    ID				    id-nf-groupOfUniqueNamesExtNameFo
}

organizationalUnitExtNameForm NAME-FORM ::= {
    NAMES			    organizationalUnitExt
    WITH ATTRIBUTES	    orgUnitNameForm.&MandatoryAttributes -- organizationalUnitName
    LDAP-NAME		    {"organizationalUnitExtNameForm"}
    ID				    id-nf-organizationalUnitExtNameFo
}

END
