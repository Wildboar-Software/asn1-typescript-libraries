/* A filter used to evaluate an entry for its eligibility for membership. If the
entry matches this filter, that entry describes a person that is eligible for
membership. */
eligibilityFilter ATTRIBUTE ::= {
    WITH SYNTAX                 Filter
    ID                          id-at-eligibilityFilter
}

-- Like eligibilityFilter, except it does not match against attribute subtypes.
eligibilityNoSubtypesFilter ATTRIBUTE ::= {
    WITH SYNTAX                 Filter
    ID                          id-at-eligibilityNoSubtypesFilter
}

