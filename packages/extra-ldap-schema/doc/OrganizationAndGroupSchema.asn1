OrganizationAndGroupSchema {
    iso(1) identified-organization(3) dod(6) internet(1) private(4)
    enterprise(1) wildboar(56490) module(1) org-group-schema(166)
}
DEFINITIONS ::= BEGIN

EXPORTS ALL;

IMPORTS

    id-at, id-nf, id-oc, id-vetreq
        FROM Wildboar
        {iso(1) identified-organization(3) dod(6) internet(1) private(4)
        enterprise(1) wildboar(56490) module(1) wildboar(1)}
        WITH SUCCESSORS

    ATTRIBUTE, OBJECT-CLASS, NAME-FORM, objectIdentifierMatch, top
        FROM InformationFramework
        {joint-iso-itu-t ds(5) module(1) informationFramework(1) 9}
        WITH SUCCESSORS

    UnboundedDirectoryString, directoryString, caseIgnoreMatch,
    caseIgnoreOrderingMatch, caseIgnoreSubstringsMatch, integer, integerMatch,
    integerOrderingMatch, boolean, booleanMatch, dn, oid, octetString, member,
    uniqueMember, organizationIdentifier, owner, CountryName, countryString,
    distinguishedName, dnsName
        FROM SelectedAttributeTypes
        {joint-iso-itu-t ds(5) module(1) selectedAttributeTypes(5) 9}
        WITH SUCCESSORS

    organization, organizationalUnit, organizationalRole, groupOfNames,
    groupOfUniqueNames, orgNameForm, orgRoleNameForm, gONNameForm,
    orgUnitNameForm
        FROM SelectedObjectClasses
        {joint-iso-itu-t ds(5) module(1) selectedObjectClasses(6) 9}
        WITH SUCCESSORS

    BusinessCategoryTypes
        FROM BusinessCategorySubtypes
        {iso(1) identified-organization(3) dod(6) internet(1) private(4)
        enterprise(1) wildboar(56490) module(1) biz-cat-subtypes(85)}
        WITH SUCCESSORS

    OrganizationIdentifierTypes
        FROM OrganizationIdentifierSubtypes
        {iso(1) identified-organization(3) dod(6) internet(1) private(4)
        enterprise(1) wildboar(56490) module(1) org-id-subtypes(87)}
        WITH SUCCESSORS

    BillingPostalAttributeSet, HeadquartersPostalAttributeSet,
    MailingPostalAttributeSet, PrincipalPostalAttributeSet
        FROM PostalSubtypes
        {iso(1) identified-organization(3) dod(6) internet(1) private(4)
        enterprise(1) wildboar(56490) module(1) postal-subtypes(80)}
        WITH SUCCESSORS

    OrganizationalPhoneAttributeSet, OrganizationalFaxAttributeSet
        FROM TelephoneSubtypes
        {iso(1) identified-organization(3) dod(6) internet(1) private(4)
        enterprise(1) wildboar(56490) module(1) telephone-subtypes(81)}
        WITH SUCCESSORS

    OrganizationalEmailAttributeSet
        FROM EmailSubtypes
        {iso(1) identified-organization(3) dod(6) internet(1) private(4)
        enterprise(1) wildboar(56490) module(1) email-subtypes(79)}
        WITH SUCCESSORS

    OrganizationalUrls
        FROM UrlSubtypes
        {iso(1) identified-organization(3) dod(6) internet(1) private(4)
        enterprise(1) wildboar(56490) module(1) url-subtypes(89)}
        WITH SUCCESSORS

    OrganizationalDescriptionAttributes
        FROM DescriptionSubtypes
        {iso(1) identified-organization(3) dod(6) internet(1) private(4)
        enterprise(1) wildboar(56490) module(1) description-subtypes(99)}
        WITH SUCCESSORS

    ThemeColorAttributes
        FROM ThemeColorSchema
        {iso(1) identified-organization(3) dod(6) internet(1) private(4)
        enterprise(1) wildboar(56490) module(1) theme-color-schema(162)}

    timeToLiveDuration
        FROM ProtocolSchema
        {iso(1) identified-organization(3) dod(6) internet(1) private(4)
        enterprise(1) wildboar(56490) module(1) protocol-schema(116)}

    DrugTestPanels
        FROM DrugTestingSchema
        {iso(1) identified-organization(3) dod(6) internet(1) private(4)
        enterprise(1) wildboar(56490) module(1) drug-testing-schema(163)}

    Religions
        FROM ReligiousSchema
        {iso(1) identified-organization(3) dod(6) internet(1) private(4)
        enterprise(1) wildboar(56490) module(1) religious-schema(164)}

    Continent, UnitedNationsContinentalSubregion
        FROM RacialSchema
        {iso(1) identified-organization(3) dod(6) internet(1) private(4)
        enterprise(1) wildboar(56490) module(1) racial-schema(106)}

    requiredVaccinationAgainst
        FROM VaccinationSchema
        {iso(1) identified-organization(3) dod(6) internet(1) private(4)
        enterprise(1) wildboar(56490) module(1) vax-schema(177)}

    associatedDomain
        FROM Cosine
        {iso(1) identified-organization(3) dod(6) internet(1) private(4)
        enterprise(1) wildboar(56490) module(1) cosine(3)}

    FundingAttributes
        FROM FundingSchema
        {iso(1) identified-organization(3) dod(6) internet(1) private(4)
        enterprise(1) wildboar(56490) module(1) funding-schema(141)}

    BasicBalanceSheetAttributes, BasicIncomeStatementAttributes,
    FinanceAttributes, AccountingAttributes
        FROM MicroeconomicSchema
        {iso(1) identified-organization(3) dod(6) internet(1) private(4)
        enterprise(1) wildboar(56490) module(1) microecon-schema(104)}

    PositiveComplianceAttributes
        FROM ComplianceSchema
        {iso(1) identified-organization(3) dod(6) internet(1) private(4)
        enterprise(1) wildboar(56490) module(1) compliance-schema(139)}

    CreationAttributes
        FROM CreationSchema
        {iso(1) identified-organization(3) dod(6) internet(1) private(4)
        enterprise(1) wildboar(56490) module(1) creation-schema(153)}

    VerbalContentAttributes
        FROM LanguageSchema
        {iso(1) identified-organization(3) dod(6) internet(1) private(4)
        enterprise(1) wildboar(56490) module(1) language-schema(100)}

    TaxpayerAttributes
        FROM TaxationSchema
        {iso(1) identified-organization(3) dod(6) internet(1) private(4)
        enterprise(1) wildboar(56490) module(1) taxation-schema(161)}

    category, rules, keyword
        FROM Useful-Schema
        {iso(1) identified-organization(3) dod(6) internet(1) private(4)
        enterprise(1) wildboar(56490) module(1) useful-schema(20)}

    stakeholderDN, beneficiaryDN
        FROM PrincipalAgentSchema
        {iso(1) identified-organization(3) dod(6) internet(1) private(4)
        enterprise(1) wildboar(56490) module(1) principal-agent-schema(137)}

    real, realMatch, realOrderingMatch, BoundedPercentage
        FROM RealTypeSchema
        {iso(1) identified-organization(3) dod(6) internet(1) private(4)
        enterprise(1) wildboar(56490) module(1) real-type-schema(98)}
        WITH SUCCESSORS

    Currency, currencySyntax, currencyMatch, currencyOrderingMatch
        FROM CurrencySchema
        {iso(1) identified-organization(3) dod(6) internet(1) private(4)
        enterprise(1) wildboar(56490) module(1) currency-schema(105)}
        WITH SUCCESSORS

    ;

