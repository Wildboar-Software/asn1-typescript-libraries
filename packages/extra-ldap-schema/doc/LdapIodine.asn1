-- Object classes

-- OID written as i2OC:1 and expanded with this file's objectidentifier macros.
tjhsstStudent OBJECT-CLASS ::= {
  SUBCLASS OF               { inetOrgPerson }
  MUST CONTAIN              { graduationYear
                              | iodineUid
                              | commonName
                              | surname
                              | startpage
                              | iodineUidNumber
                              | style
                              | header
                              | chrome }
  MAY CONTAIN               { tjhsstStudentId
                              | perm-showpictures
                              | perm-showaddress
                              | perm-showtelephone
                              | perm-showbirthday
                              | perm-showschedule
                              | perm-showmap
                              | perm-showeighth
                              | perm-showlocker
                              | perm-showpictures-self
                              | perm-showaddress-self
                              | perm-showtelephone-self
                              | perm-showbirthday-self
                              | perm-showschedule-self
                              | perm-showmap-self
                              | perm-showeighth-self
                              | perm-showlocker-self
                              | friend
                              | perm-showtelephone-friend
