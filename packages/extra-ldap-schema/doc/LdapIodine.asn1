graduationYear ATTRIBUTE ::= {
  WITH SYNTAX               INTEGER
  EQUALITY MATCHING RULE    integerMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               integer.&id
  LDAP-NAME                 {"graduationYear", "gradYear", "year"}
  LDAP-DESC                 "A year of graduation"
  ID                        id-at-graduationYear }

