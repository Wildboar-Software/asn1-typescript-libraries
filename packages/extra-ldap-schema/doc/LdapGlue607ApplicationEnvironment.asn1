-- initial capital of "GLUE2ApplicationEnvironmentID" lowercased so the assignment is a valuereference.
gLUE2ApplicationEnvironmentID ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseExactMatch
  SUBSTRINGS MATCHING RULE  caseExactSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"GLUE2ApplicationEnvironmentID"}
  LDAP-DESC                 "Globally unique ID"
  ID                        id-at-gLUE2ApplicationEnvironmentID }

