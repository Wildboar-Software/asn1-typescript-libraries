-- 3 elements were omitted because another source file in this corpus defines the same OID.
Ldapmigration55imsIcal DEFINITIONS ::=
BEGIN

IMPORTS

  alias, ATTRIBUTE, DistinguishedName, OBJECT-CLASS, top
    FROM InformationFramework
      {joint-iso-itu-t ds(5) module(1) informationFramework(1) 9} WITH SUCCESSORS

  commonName, dc, description, directoryString, dn, ia5String, integer,
    organizationName, owner, UnboundedDirectoryString
    FROM SelectedAttributeTypes
      {joint-iso-itu-t ds(5) module(1) selectedAttributeTypes(5) 9} WITH SUCCESSORS

  inetOrgPerson
    FROM InetOrgPerson
      {iso(1) identified-organization(3) dod(6) internet(1) private(4) enterprise(1) wildboar(56490) module(1) inetorgperson(5)} WITH SUCCESSORS

  mailAlternateAddress
    FROM QMailSchema
      {iso(1) identified-organization(3) dod(6) internet(1) private(4) enterprise(1) wildboar(56490) module(1) qmail-schema(55)} WITH SUCCESSORS

  calCalURI, calFBURL
    FROM RFC2739Calendar
      {iso(1) identified-organization(3) dod(6) internet(1) private(4) enterprise(1) wildboar(56490) module(1) rfc-2739-calendar(8)} WITH SUCCESSORS

  nsdaModifiableBy
    FROM Ldapmigration50nsDelegatedAdmin

  vacationenddate, vacationstartdate
    FROM Ldapmigration50nsMail

  co
    FROM LdapSchema2ldifCosine ;

