id-oc-nswcalUser OBJECT IDENTIFIER ::= { 2 16 840 1 113730 3 2 83 }

-- Attribute types

-- X-ORIGIN: "iPlanet Web Calendaring"
nswcalCALID ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"nswcalCALID"}
  LDAP-DESC                 "iPlanet defined attribute type"
  ID                        id-at-nswcalCALID }

