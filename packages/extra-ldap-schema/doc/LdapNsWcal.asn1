-- Object classes

-- X-ORIGIN: "iPlanet Web Calendaring"
nswcalUser OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { objectClass }
  MAY CONTAIN               { commonName
                              | givenName
                              | mail
                              | preferredLanguage
                              | surname
                              | uid
                              | userPassword
                              | nswcalCALID
                              | nswcalDisallowAccess
                              | nswcalExtendedUserPrefs
                              | nsLicensedFor
                              | nswcalHost
                              | nswcalQuota }
  LDAP-NAME                 {"nswcalUser"}
