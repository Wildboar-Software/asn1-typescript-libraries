-- Object identifiers

id-at-gLUE2ShareID OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 6757 100 1 1 10 1 }
id-at-gLUE2ShareDescription OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 6757 100 1 1 10 2 }
id-at-gLUE2ShareEndpointForeignKey OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 6757 100 1 1 10 3 }
