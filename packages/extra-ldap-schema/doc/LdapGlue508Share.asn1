id-oc-gLUE2Share OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 6757 100 1 1 10 }

-- Attribute types

-- initial capital of "GLUE2ShareID" lowercased so the assignment is a valuereference.
gLUE2ShareID ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseExactMatch
  SUBSTRINGS MATCHING RULE  caseExactSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"GLUE2ShareID"}
  LDAP-DESC                 "Globally unique ID"
  ID                        id-at-gLUE2ShareID }

-- initial capital of "GLUE2ShareDescription" lowercased so the assignment is a valuereference.
gLUE2ShareDescription ATTRIBUTE ::= {
