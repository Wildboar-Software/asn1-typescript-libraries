  LDAP-NAME                 {"goFonConferenceTimeOut"}
  LDAP-DESC                 "Holds the queue goFonConferenceTimeOut definitions"
  ID                        id-at-goFonConferenceTimeOut }

-- LDAP syntax length {256} rendered as DirectoryString{256}.
goFonConferenceOwner ATTRIBUTE ::= {
  WITH SYNTAX               DirectoryString{256}
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"goFonConferenceOwner"}
  LDAP-DESC                 "Holds the queue goFonConferenceOwner definitions"
  ID                        id-at-goFonConferenceOwner }

goFonVoicemailPIN ATTRIBUTE ::= {
  WITH SYNTAX               IA5String
  EQUALITY MATCHING RULE    caseExactIA5Match
  SUBSTRINGS MATCHING RULE  caseExactIA5SubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               ia5String.&id
  LDAP-NAME                 {"goFonVoicemailPIN"}
  LDAP-DESC                 "defines voicemail delivery format"
  ID                        id-at-goFonVoicemailPIN }

goFonHomeServer ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseExactMatch
  SUBSTRINGS MATCHING RULE  caseExactSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"goFonHomeServer"}
  LDAP-DESC                 "defines voicemail delivery format"
  ID                        id-at-goFonHomeServer }

-- Object classes

goFonAccount OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MUST CONTAIN              { goFonDeliveryMode
                              | telephoneNumber
                              | uid }
  MAY CONTAIN               { goFonFormat
                              | goFonForwarding
                              | goFonHardware
                              | goFonPIN
                              | goFonVoicemailPIN
                              | goFonMacro
                              | goFonHomeServer }
  LDAP-NAME                 {"goFonAccount"}
  LDAP-DESC                 "GOFon Account objectclass (v2.7)"
  ID                        id-oc-goFonAccount }

-- disambiguated goFonHardware to goFonHardware-2 inside LdapGosaCoreGofon.
goFonHardware-2 OBJECT-CLASS ::= {
