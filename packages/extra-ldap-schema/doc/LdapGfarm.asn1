  LDAP-SYNTAX               ia5String.&id
  LDAP-NAME                 {"ctimensec"}
  ID                        id-at-ctimensec }

checksumType ATTRIBUTE ::= {
  WITH SYNTAX               IA5String
  EQUALITY MATCHING RULE    caseExactIA5Match
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               ia5String.&id
  LDAP-NAME                 {"checksumType"}
  ID                        id-at-checksumType }

