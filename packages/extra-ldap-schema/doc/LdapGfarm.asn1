  EQUALITY MATCHING RULE    caseExactIA5Match
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               ia5String.&id
  LDAP-NAME                 {"checksum"}
  ID                        id-at-checksum }

entryName ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseExactMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"entryName"}
  ID                        id-at-entryName }

entryINumber ATTRIBUTE ::= {
  WITH SYNTAX               IA5String
  EQUALITY MATCHING RULE    caseExactIA5Match
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               ia5String.&id
  LDAP-NAME                 {"entryINumber"}
  ID                        id-at-entryINumber }

sourcePath ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseExactMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"sourcePath"}
  ID                        id-at-sourcePath }

attrname ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseExactMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"attrname"}
  ID                        id-at-attrname }

-- LDAP binary syntax has no X.500 directory type here. Represented as OCTET STRING.
attrvalue ATTRIBUTE ::= {
  WITH SYNTAX               OCTET STRING
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               { 1 3 6 1 4 1 1466 115 121 1 5 }
  LDAP-NAME                 {"attrvalue"}
  ID                        id-at-attrvalue }

fsngroupname ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"fsngroupname"}
  ID                        id-at-fsngroupname }

authIDType ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"authIDType"}
  ID                        id-at-authIDType }

authUserId ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"authUserId"}
  ID                        id-at-authUserId }

-- Object classes

-- initial capital of "GFarmHost" lowercased so the assignment is a valuereference.
gFarmHost OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { hostname
                              | port
                              | architecture
                              | ncpu
                              | flags }
  MAY CONTAIN               { hostaliases
                              | fsngroupname }
  LDAP-NAME                 {"GFarmHost"}
  ID                        id-oc-gFarmHost }

-- initial capital of "GFarmUser" lowercased so the assignment is a valuereference.
gFarmUser OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { username
                              | homedir }
  MAY CONTAIN               { realname
                              | gsiDN }
  LDAP-NAME                 {"GFarmUser"}
  ID                        id-oc-gFarmUser }

-- initial capital of "GFarmGroup" lowercased so the assignment is a valuereference.
gFarmGroup OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { groupname }
  MAY CONTAIN               { groupusers }
  LDAP-NAME                 {"GFarmGroup"}
  ID                        id-oc-gFarmGroup }

-- initial capital of "GFarmINode" lowercased so the assignment is a valuereference.
gFarmINode OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { inumber
                              | igen
                              | nlink
                              | size-type
                              | mode
                              | username
                              | groupname
                              | atimesec
                              | atimensec
                              | mtimesec
                              | mtimensec
                              | ctimesec
                              | ctimensec }
  MAY CONTAIN               { checksumType
                              | checksum }
  LDAP-NAME                 {"GFarmINode"}
  ID                        id-oc-gFarmINode }

-- initial capital of "GFarmFileCopy" lowercased so the assignment is a valuereference.
gFarmFileCopy OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { inumber
                              | hostname }
  LDAP-NAME                 {"GFarmFileCopy"}
  ID                        id-oc-gFarmFileCopy }

-- initial capital of "GFarmDeadFileCopy" lowercased so the assignment is a valuereference.
gFarmDeadFileCopy OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { inumber
                              | igen
                              | hostname }
  LDAP-NAME                 {"GFarmDeadFileCopy"}
  ID                        id-oc-gFarmDeadFileCopy }

-- initial capital of "GFarmDirEntry" lowercased so the assignment is a valuereference.
gFarmDirEntry OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { inumber
                              | entryName
                              | entryINumber }
  LDAP-NAME                 {"GFarmDirEntry"}
  ID                        id-oc-gFarmDirEntry }

-- initial capital of "GFarmSymlink" lowercased so the assignment is a valuereference.
gFarmSymlink OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MUST CONTAIN              { sourcePath }
  LDAP-NAME                 {"GFarmSymlink"}
  ID                        id-oc-gFarmSymlink }

-- initial capital of "XAttr" lowercased so the assignment is a valuereference.
xAttr OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { inumber
                              | attrname
                              | attrvalue }
  LDAP-NAME                 {"XAttr"}
  ID                        id-oc-xAttr }

-- initial capital of "GFarmUserAuth" lowercased so the assignment is a valuereference.
gFarmUserAuth OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { username
                              | authIDType
                              | authUserId }
  LDAP-NAME                 {"GFarmUserAuth"}
  ID                        id-oc-gFarmUserAuth }
END