id-oc-xAttr OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 13122 2 1 2924 101 3 9 }
id-oc-gFarmUserAuth OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 13122 2 1 2924 101 3 10 }

-- Attribute types

hostname ATTRIBUTE ::= {
  WITH SYNTAX               IA5String
  EQUALITY MATCHING RULE    caseIgnoreIA5Match
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               ia5String.&id
  LDAP-NAME                 {"hostname"}
  ID                        id-at-hostname }

port ATTRIBUTE ::= {
  WITH SYNTAX               IA5String
  EQUALITY MATCHING RULE    caseExactIA5Match
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               ia5String.&id
  LDAP-NAME                 {"port"}
  ID                        id-at-port }

hostaliases ATTRIBUTE ::= {
  WITH SYNTAX               IA5String
  EQUALITY MATCHING RULE    caseIgnoreIA5Match
  LDAP-SYNTAX               ia5String.&id
  LDAP-NAME                 {"hostaliases"}
  ID                        id-at-hostaliases }

architecture ATTRIBUTE ::= {
  WITH SYNTAX               IA5String
  EQUALITY MATCHING RULE    caseExactIA5Match
