id-at-attrvalue OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 13122 2 1 2924 101 2 30 }
id-at-fsngroupname OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 13122 2 1 2924 101 2 31 }
