-- Derived from data/ldap-schema/gfarm.schema
-- Upstream: https://github.com/oss-tsukuba/gfarm/blob/6c4e78bced99602263718679324df0ffd6b12cdf/gftool/config-gfarm/gfarm.schema#L22
-- This module is a container for LDAP schema. It has no module identifier.
-- X- extension fields from the LDAP schema are comments. USAGE userApplications and structural KIND are omitted because they are the defaults.
LdapGfarm DEFINITIONS ::=
BEGIN

IMPORTS

  ATTRIBUTE, OBJECT-CLASS, top
    FROM InformationFramework
      {joint-iso-itu-t ds(5) module(1) informationFramework(1) 9} WITH SUCCESSORS

  caseExactIA5Match, caseExactMatch, caseIgnoreIA5Match, directoryString,
    ia5String, UnboundedDirectoryString
    FROM SelectedAttributeTypes
      {joint-iso-itu-t ds(5) module(1) selectedAttributeTypes(5) 9} WITH SUCCESSORS ;

-- Object identifiers

id-at-hostname OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 13122 2 1 2924 101 2 1 }
id-at-port OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 13122 2 1 2924 101 2 2 }
