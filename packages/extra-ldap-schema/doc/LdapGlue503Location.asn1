-- Attribute types

-- initial capital of "GLUE2LocationID" lowercased so the assignment is a valuereference.
gLUE2LocationID ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseExactMatch
  SUBSTRINGS MATCHING RULE  caseExactSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"GLUE2LocationID"}
  LDAP-DESC                 "Globally unique ID"
  ID                        id-at-gLUE2LocationID }

