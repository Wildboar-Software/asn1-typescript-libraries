-- Object classes

-- OID written as ftObId:1 and expanded with this file's objectidentifier macros.
ftRls OBJECT-CLASS ::= {
  SUBCLASS OF               { organizationalRole }
  MUST CONTAIN              { ftId
                              | ftRoleName }
  MAY CONTAIN               { description
                              | ftCstr
                              | ftParents }
  LDAP-NAME                 {"ftRls"}
  LDAP-DESC                 "Fortress Role Structural Object Class"
  ID                        id-oc-ftRls }

-- OID written as ftObId:2 and expanded with this file's objectidentifier macros.
ftObject OBJECT-CLASS ::= {
  SUBCLASS OF               { organizationalUnit }
  MUST CONTAIN              { ftId
                              | ftObjNm }
  MAY CONTAIN               { ftType }
  LDAP-NAME                 {"ftObject"}
  LDAP-DESC                 "Fortress Permission Object Class"
  ID                        id-oc-ftObject }

-- OID written as ftObId:3 and expanded with this file's objectidentifier macros.
ftOperation OBJECT-CLASS ::= {
  SUBCLASS OF               { organizationalRole }
  MUST CONTAIN              { ftId
                              | ftPermName
                              | ftObjNm
                              | ftOpNm }
  MAY CONTAIN               { ftObjId
                              | ftRoles
                              | ftUsers
                              | ftType
                              | ftPASet }
  LDAP-NAME                 {"ftOperation"}
  LDAP-DESC                 "Fortress Permission Operation Structural Object Class"
  ID                        id-oc-ftOperation }

