-- OID written as ftAtId:1 and expanded with this file's objectidentifier macros.
ftPermName ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"ftPermName"}
  LDAP-DESC                 "Fortress Permission Name"
  ID                        id-at-ftPermName }

