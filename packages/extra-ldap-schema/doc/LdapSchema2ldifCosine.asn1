-- Derived from data/ldap-schema/schema2ldif/cosine.schema
-- Upstream: http://www.openldap.org/
-- This module is a container for LDAP schema. It has no module identifier.
-- X- extension fields from the LDAP schema are comments. USAGE userApplications and structural KIND are omitted because they are the defaults.
-- 6 elements were omitted because their OIDs are already defined. See CONVERSION-REPORT.txt.
-- LDAP {length} bounds on directory strings are DirectoryString{n}. Bounds on IA5String, PrintableString, NumericString, and OCTET STRING are SIZE (1..n). Other bounds stay comments because the LDAP figure is an encoded-length hint.
LdapSchema2ldifCosine DEFINITIONS ::=
BEGIN

IMPORTS

  ATTRIBUTE, DistinguishedName, distinguishedNameMatch, OBJECT-CLASS, top
    FROM InformationFramework
      {joint-iso-itu-t ds(5) module(1) informationFramework(1) 9} WITH SUCCESSORS

  businessCategory, caseIgnoreIA5Match, caseIgnoreIA5SubstringsMatch,
    caseIgnoreListMatch, caseIgnoreListSubstringsMatch, caseIgnoreMatch,
    caseIgnoreSubstringsMatch, commonName, dc, description,
    destinationIndicator, directoryString, DirectoryString, dn,
    facsimileTelephoneNumber, fax, ia5String, integer, internationalISDNNumber,
    localityName, organizationalUnitName, organizationName,
    physicalDeliveryOfficeName, postalAddr, postalAddress, PostalAddress,
    postalCode, postOfficeBox, preferredDeliveryMethod, registeredAddress,
    searchGuide, seeAlso, stateOrProvinceName, streetAddress, surname,
    telephoneNr, telephoneNumber, TelephoneNumber, telephoneNumberMatch,
    telephoneNumberSubstringsMatch, telexNumber, uid, UnboundedDirectoryString,
    utcTime, x121Address
    FROM SelectedAttributeTypes
      {joint-iso-itu-t ds(5) module(1) selectedAttributeTypes(5) 9} WITH SUCCESSORS

  country, dSA, organization, organizationalUnit, person
    FROM SelectedObjectClasses
      {joint-iso-itu-t ds(5) module(1) selectedObjectClasses(6) 9} WITH SUCCESSORS

  userPassword
    FROM AuthenticationFramework
      {joint-iso-itu-t ds(5) module(1) authenticationFramework(7) 9} WITH SUCCESSORS

  aRecord, cNAMERecord, mDRecord, mxRecord, nSRecord, sOARecord
    FROM DNSFramework
      {iso(1) identified-organization(3) dod(6) internet(1) private(4) enterprise(1) wildboar(56490) module(1) dns(2)} WITH SUCCESSORS

  associatedDomain
    FROM MIXERAddressMapping
      {iso(1) identified-organization(3) dod(6) internet(1) private(4) enterprise(1) wildboar(56490) module(1) mixer-address-mapping(9)} WITH SUCCESSORS

  mail, teletexTerminalIdentifier
    FROM LdapSchema2ldifCore ;

