                              | bindTimeLimit
                              | credentialLevel
                              | defaultSearchBase
                              | defaultSearchScope
                              | defaultServerList
                              | followReferrals
                              | objectclassMap
                              | preferredServerList
                              | profileTTL
                              | searchTimeLimit
                              | serviceAuthenticationMethod
                              | serviceCredentialLevel
                              | serviceSearchDescriptor }
  LDAP-NAME                 {"DUAConfigProfile"}
  ID                        id-oc-invalid-dUAConfigProfile }
