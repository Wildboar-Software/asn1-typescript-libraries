-- Object identifiers

-- Thought to be invalid. Several LDAP schemas publish 1.3.6.1.4.1.11.1.3.1.2.4 for DUAConfigProfile, but that number does not appear on oid-base.com.
-- RFC 4876 defines DUAConfigProfile with the same name and an OID that ends in 5 instead of 4. That class is already duaConfigProfile in DUAConf.
-- The valuereference and this OID identifier were renamed to show the invalid status. The numeric arcs are the ones this source published and were not rewritten. LDAP-NAME keeps the original string.
id-oc-invalid-dUAConfigProfile OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 11 1 3 1 2 4 }

-- Object classes

-- X-ORIGIN: "user defined"
-- Thought to be invalid. Several LDAP schemas publish 1.3.6.1.4.1.11.1.3.1.2.4 for DUAConfigProfile, but that number does not appear on oid-base.com.
-- RFC 4876 defines DUAConfigProfile with the same name and an OID that ends in 5 instead of 4. That class is already duaConfigProfile in DUAConf.
-- The valuereference and this OID identifier were renamed to show the invalid status. The numeric arcs are the ones this source published and were not rewritten. LDAP-NAME keeps the original string.
invalid-dUAConfigProfile OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
