goXdmcpIsEnabled ATTRIBUTE ::= {
  WITH SYNTAX               IA5String
  EQUALITY MATCHING RULE    caseExactIA5Match
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               ia5String.&id
  LDAP-NAME                 {"goXdmcpIsEnabled"}
  LDAP-DESC                 "Indicates if the server is enabled for XDMCP queries"
  ID                        id-at-goXdmcpIsEnabled }

