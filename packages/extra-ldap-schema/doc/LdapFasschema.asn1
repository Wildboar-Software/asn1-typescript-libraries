-- Object classes

-- X-ORIGIN: "Fedora Account System"
-- SUP was absent. RFC 4512 treats that as a subclass of top, so SUBCLASS OF { top } was added.
fasUser OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MAY CONTAIN               { fasTimezone
                              | fasLocale
                              | fasIRCNick
                              | fasGPGKeyId
                              | fasCreationTime
                              | fasStatusNote
                              | fasRHBZEmail
                              | fasGitHubUsername
                              | fasGitLabUsername
                              | fasWebsiteUrl
                              | fasIsPrivate
                              | fasPronoun
                              | fasRssUrl
                              | countryName }
  LDAP-NAME                 {"fasUser"}
  LDAP-DESC                 "FAS user objectclass"
  ID                        id-oc-fasUser }

-- X-ORIGIN: "Fedora Account System"
fasGroup OBJECT-CLASS ::= {
  SUBCLASS OF               { ipaUserGroup }
  KIND                      auxiliary
  MAY CONTAIN               { fasURL
                              | fasMailingList
                              | fasIRCChannel
                              | fasDiscussionURL }
  LDAP-NAME                 {"fasGroup"}
  LDAP-DESC                 "FAS group objectclass"
  ID                        id-oc-fasGroup }

-- X-ORIGIN: "Fedora Account System"
fasAgreement OBJECT-CLASS ::= {
  SUBCLASS OF               { ipaAssociation }
  MAY CONTAIN               { member }
  LDAP-NAME                 {"fasAgreement"}
  LDAP-DESC                 "FAS agreement objectclass"
  ID                        id-oc-fasAgreement }
END