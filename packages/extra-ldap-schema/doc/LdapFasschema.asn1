  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"fasIRCNick"}
  ID                        id-at-fasIRCNick }

-- X-ORIGIN: "Fedora Account System"
-- LDAP syntax length {40} rendered as DirectoryString{40}.
fasGPGKeyId ATTRIBUTE ::= {
  WITH SYNTAX               DirectoryString{40}
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"fasGPGKeyId"}
  ID                        id-at-fasGPGKeyId }

-- X-ORIGIN: "Fedora Account System"
fasCreationTime ATTRIBUTE ::= {
  WITH SYNTAX               GeneralizedTime
  EQUALITY MATCHING RULE    generalizedTimeMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               generalizedTime.&id
  LDAP-NAME                 {"fasCreationTime"}
  ID                        id-at-fasCreationTime }

