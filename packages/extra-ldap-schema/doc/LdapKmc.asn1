  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"x-kmc-UniversityStatus"}
  LDAP-DESC                 "the status of the associated person in the university"
  ID                        id-at-x-kmc-UniversityStatus }

-- OID written as kmcAttributeType:9 and expanded with this file's objectidentifier macros.
x-kmc-UniversityMatricYear ATTRIBUTE ::= {
  WITH SYNTAX               INTEGER
  EQUALITY MATCHING RULE    integerMatch
  ORDERING MATCHING RULE    integerOrderingMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               integer.&id
  LDAP-NAME                 {"x-kmc-UniversityMatricYear"}
  LDAP-DESC                 "the year when the associated person entered the university"
  ID                        id-at-x-kmc-UniversityMatricYear }

-- OID written as kmcAttributeType:10 and expanded with this file's objectidentifier macros.
x-kmc-MailForwardingAddress ATTRIBUTE ::= {
  SUBTYPE OF                mail
  WITH SYNTAX               IA5String
  EQUALITY MATCHING RULE    caseIgnoreIA5Match
  SUBSTRINGS MATCHING RULE  caseIgnoreIA5SubstringsMatch
  LDAP-SYNTAX               ia5String.&id
  LDAP-NAME                 {"x-kmc-MailForwardingAddress"}
  LDAP-DESC                 "Email address to forward messages"
  ID                        id-at-x-kmc-MailForwardingAddress }

