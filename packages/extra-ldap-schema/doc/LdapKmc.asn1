  LDAP-DESC                 "Slack user id"
  ID                        id-at-x-kmc-SlackUserID }

-- OID written as kmcAttributeType:14 and expanded with this file's objectidentifier macros.
x-kmc-AddressIsPublic ATTRIBUTE ::= {
  WITH SYNTAX               BOOLEAN
  EQUALITY MATCHING RULE    booleanMatch
  LDAP-SYNTAX               boolean.&id
  LDAP-NAME                 {"x-kmc-AddressIsPublic"}
