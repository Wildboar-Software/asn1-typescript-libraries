-- Derived from data/ldap-schema/common389.ldif
-- This module is a container for LDAP schema. It has no module identifier.
-- X- extension fields from the LDAP schema are comments. USAGE userApplications and structural KIND are omitted because they are the defaults.
-- 17 elements were omitted because their OIDs are already defined. See CONVERSION-REPORT.txt.
-- 2 elements share a numeric OID with another element that was also kept. See the comments on those elements.
LdapCommon389 DEFINITIONS ::=
BEGIN

IMPORTS

  ATTRIBUTE, DistinguishedName, distinguishedNameMatch, OBJECT-CLASS, top
    FROM InformationFramework
      {joint-iso-itu-t ds(5) module(1) informationFramework(1) 9} WITH SUCCESSORS

  boolean, booleanMatch, businessCategory, commonName, description,
    directoryString, dn, generalizedTime, ia5String, integer, localityName,
    organizationalUnitName, organizationName, owner, seeAlso, uid,
    UnboundedDirectoryString
    FROM SelectedAttributeTypes
      {joint-iso-itu-t ds(5) module(1) selectedAttributeTypes(5) 9} WITH SUCCESSORS

  userPassword
    FROM AuthenticationFramework
      {joint-iso-itu-t ds(5) module(1) authenticationFramework(7) 9} WITH SUCCESSORS

  aci
    FROM LdapAci

  multiLineDescription, nsds50ruv, nsds5BeginReplicaRefresh,
    nsds5debugreplicatimeout, nsDS5ReplicaBindDN, nsDS5ReplicaBindMethod,
    nsds5replicaBusyWaitTime, nsds5replicaChangesSentSinceStartup,
    nsDS5ReplicaCredentials, nsds5ReplicaEnabled, nsDS5ReplicaHost,
    nsds5replicaLastInitEnd, nsds5replicaLastInitStart,
    nsds5replicaLastInitStatus, nsds5replicaLastUpdateEnd,
    nsds5replicaLastUpdateStart, nsds5replicaLastUpdateStatus,
    nsDS5ReplicaPort, nsDS5ReplicaRoot, nsds5replicaSessionPauseTime,
    nsDS5ReplicatedAttributeList, nsds5replicaTimeout,
    nsDS5ReplicaTransportInfo, nsds5replicaUpdateInProgress,
    nsDS5ReplicaUpdateSchedule, nsruvReplicaLastModified
    FROM LdapCore389

  ldapSubEntry
    FROM LdapSubentry ;

