-- Object classes

-- initial capital of "GLUE2Domain" lowercased so the assignment is a valuereference.
gLUE2Domain OBJECT-CLASS ::= {
  SUBCLASS OF               { gLUE2Entity }
  MUST CONTAIN              { gLUE2DomainID }
  MAY CONTAIN               { gLUE2DomainDescription
                              | gLUE2DomainWWW }
  LDAP-NAME                 {"GLUE2Domain"}
  LDAP-DESC                 "A Domain"
  ID                        id-oc-gLUE2Domain }

-- initial capital of "GLUE2AdminDomain" lowercased so the assignment is a valuereference.
gLUE2AdminDomain OBJECT-CLASS ::= {
  SUBCLASS OF               { gLUE2Domain }
  MAY CONTAIN               { gLUE2AdminDomainDistributed
                              | gLUE2AdminDomainOwner
                              | gLUE2AdminDomainAdminDomainForeignKey }
  LDAP-NAME                 {"GLUE2AdminDomain"}
  LDAP-DESC                 "A collection of actors that can be assigned with administrative roles and privileges to services via policies. An AdminDomain manages services that can be geographically distributed, nevertheless a primary location should be identified."
  ID                        id-oc-gLUE2AdminDomain }

-- initial capital of "GLUE2UserDomain" lowercased so the assignment is a valuereference.
gLUE2UserDomain OBJECT-CLASS ::= {
  SUBCLASS OF               { gLUE2Domain }
  MAY CONTAIN               { gLUE2UserDomainLevel
                              | gLUE2UserDomainUserManager
                              | gLUE2UserDomainMember
                              | gLUE2UserDomainUserDomainForeignKey }
  LDAP-NAME                 {"GLUE2UserDomain"}
  LDAP-DESC                 "A collection of actors that can be assigned with user roles and privileges to services or shares via policies"
  ID                        id-oc-gLUE2UserDomain }
END