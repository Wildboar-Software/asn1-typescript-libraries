    UnboundedDirectoryString
    FROM SelectedAttributeTypes
      {joint-iso-itu-t ds(5) module(1) selectedAttributeTypes(5) 9} WITH SUCCESSORS

  gLUE2Entity
    FROM LdapGlue501Entity ;

-- Object identifiers

id-at-gLUE2DomainID OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 6757 100 1 1 5 1 }
id-at-gLUE2DomainDescription OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 6757 100 1 1 5 2 }
id-at-gLUE2DomainWWW OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 6757 100 1 1 5 3 }
id-oc-gLUE2Domain OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 6757 100 1 1 5 }
id-at-gLUE2AdminDomainDistributed OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 6757 100 1 1 6 1 }
id-at-gLUE2AdminDomainOwner OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 6757 100 1 1 6 2 }
id-at-gLUE2AdminDomainAdminDomainForeignKey OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 6757 100 1 1 6 4 }
