-- Attribute types

-- initial capital of "GLUE2DomainID" lowercased so the assignment is a valuereference.
gLUE2DomainID ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseExactMatch
  SUBSTRINGS MATCHING RULE  caseExactSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"GLUE2DomainID"}
  LDAP-DESC                 "A description of the domain"
  ID                        id-at-gLUE2DomainID }

-- initial capital of "GLUE2DomainDescription" lowercased so the assignment is a valuereference.
gLUE2DomainDescription ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseExactMatch
  SUBSTRINGS MATCHING RULE  caseExactSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"GLUE2DomainDescription"}
  LDAP-DESC                 "A description of the domain"
  ID                        id-at-gLUE2DomainDescription }

-- initial capital of "GLUE2DomainWWW" lowercased so the assignment is a valuereference.
gLUE2DomainWWW ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseExactMatch
  SUBSTRINGS MATCHING RULE  caseExactSubstringsMatch
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"GLUE2DomainWWW"}
  LDAP-DESC                 "The URL identifying a web page with more information about the domain"
  ID                        id-at-gLUE2DomainWWW }

-- initial capital of "GLUE2AdminDomainDistributed" lowercased so the assignment is a valuereference.
gLUE2AdminDomainDistributed ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseExactMatch
  SUBSTRINGS MATCHING RULE  caseExactSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"GLUE2AdminDomainDistributed"}
  LDAP-DESC                 "True if the services managed by the AdminDomain are considered geographically distributed by the administrators themselves"
  ID                        id-at-gLUE2AdminDomainDistributed }

-- initial capital of "GLUE2AdminDomainOwner" lowercased so the assignment is a valuereference.
gLUE2AdminDomainOwner ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseExactMatch
  SUBSTRINGS MATCHING RULE  caseExactSubstringsMatch
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"GLUE2AdminDomainOwner"}
  LDAP-DESC                 "Owner of the managed resources"
  ID                        id-at-gLUE2AdminDomainOwner }

-- initial capital of "GLUE2AdminDomainAdminDomainForeignKey" lowercased so the assignment is a valuereference.
gLUE2AdminDomainAdminDomainForeignKey ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseExactMatch
  SUBSTRINGS MATCHING RULE  caseExactSubstringsMatch
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"GLUE2AdminDomainAdminDomainForeignKey"}
  LDAP-DESC                 "ForeignKey"
  ID                        id-at-gLUE2AdminDomainAdminDomainForeignKey }

-- initial capital of "GLUE2UserDomainLevel" lowercased so the assignment is a valuereference.
gLUE2UserDomainLevel ATTRIBUTE ::= {
  WITH SYNTAX               INTEGER
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               integer.&id
  LDAP-NAME                 {"GLUE2UserDomainLevel"}
  LDAP-DESC                 "The number of hops to reach the root for hierarchically organized domains described by the composed by association (0 is for the root)."
  ID                        id-at-gLUE2UserDomainLevel }

-- initial capital of "GLUE2UserDomainUserManager" lowercased so the assignment is a valuereference.
gLUE2UserDomainUserManager ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseExactMatch
  SUBSTRINGS MATCHING RULE  caseExactSubstringsMatch
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"GLUE2UserDomainUserManager"}
  LDAP-DESC                 "The Endpoint ID managing the users part of the domain and the related attributes such as groups or roles"
  ID                        id-at-gLUE2UserDomainUserManager }

-- initial capital of "GLUE2UserDomainMember" lowercased so the assignment is a valuereference.
gLUE2UserDomainMember ATTRIBUTE ::= {
