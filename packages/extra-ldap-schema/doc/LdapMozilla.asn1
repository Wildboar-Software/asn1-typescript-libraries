-- Derived from data/ldap-schema/mozilla.ldif
-- Upstream: https://github.com/389ds/389-ds-base/blob/main/ldap/schema/60mozilla.ldif
-- This module is a container for LDAP schema. It has no module identifier.
-- X- extension fields from the LDAP schema are comments. USAGE userApplications and structural KIND are omitted because they are the defaults.
-- LDAP {length} bounds on directory strings are DirectoryString{n}. Bounds on IA5String, PrintableString, NumericString, and OCTET STRING are SIZE (1..n). Other bounds stay comments because the LDAP figure is an encoded-length hint.
LdapMozilla DEFINITIONS ::=
BEGIN

IMPORTS

  ATTRIBUTE, OBJECT-CLASS, top
    FROM InformationFramework
      {joint-iso-itu-t ds(5) module(1) informationFramework(1) 9} WITH SUCCESSORS

  boolean, caseIgnoreIA5Match, caseIgnoreIA5SubstringsMatch, caseIgnoreMatch,
    caseIgnoreSubstringsMatch, commonName, countryName, description,
    directoryString, DirectoryString, facsimileTelephoneNumber, givenName,
    ia5String, localityName, organizationalUnitName, organizationName,
    postalCode, postOfficeBox, stateOrProvinceName, streetAddress, surname,
    telephoneNr, telephoneNumber, TelephoneNumber, telephoneNumberMatch,
    telephoneNumberSubstringsMatch, title
    FROM SelectedAttributeTypes
      {joint-iso-itu-t ds(5) module(1) selectedAttributeTypes(5) 9} WITH SUCCESSORS

  displayName
    FROM InetOrgPerson
      {iso(1) identified-organization(3) dod(6) internet(1) private(4) enterprise(1) wildboar(56490) module(1) inetorgperson(5)} WITH SUCCESSORS

  mail
    FROM LdapSchema2ldifCore

  homePhone, mobile, pager
    FROM LdapSchema2ldifCosine ;

-- Object identifiers

id-at-mozillaCustom1 OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 13769 4 1 }
