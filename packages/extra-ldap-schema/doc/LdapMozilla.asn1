id-oc-mozillaAbPersonAlpha OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 13769 9 1 }

-- Attribute types

-- X-ORIGIN: "Mozilla Address Book"
-- LDAP syntax length {128} rendered as DirectoryString{128}.
mozillaCustom1 ATTRIBUTE ::= {
  WITH SYNTAX               DirectoryString{128}
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"mozillaCustom1"}
  ID                        id-at-mozillaCustom1 }

