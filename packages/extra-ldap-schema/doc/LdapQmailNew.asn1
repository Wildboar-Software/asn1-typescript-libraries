  LDAP-SYNTAX               ia5String.&id
  LDAP-NAME                 {"qlaMailHostList"}
  ID                        id-at-qlaMailHostList }

-- Object classes

qldapAdmin OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MUST CONTAIN              { qladnmanager
                              | qlaDomainList
                              | qlaMailMStorePrefix
                              | qlaMailHostList }
  MAY CONTAIN               { qlaUidPrefix
                              | qlaQmailUid
                              | qlaQmailGid
                              | qlaMailQuotaSize
                              | qlaMailQuotaCount
                              | qlaMailSizeMax }
  LDAP-NAME                 {"qldapAdmin"}
  LDAP-DESC                 "QMail-LDAP Subtree Admin"
  ID                        id-oc-qldapAdmin }
