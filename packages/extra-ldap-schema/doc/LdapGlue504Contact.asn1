-- initial capital of "GLUE2ContactServiceForeignKey" lowercased so the assignment is a valuereference.
gLUE2ContactServiceForeignKey ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseExactMatch
