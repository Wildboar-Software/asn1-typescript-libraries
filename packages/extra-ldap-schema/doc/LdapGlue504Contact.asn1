  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"GLUE2ContactDetail"}
  LDAP-DESC                 "URL embedding the contact information. The syntax of URI depends on the communication channel"
  ID                        id-at-gLUE2ContactDetail }

-- initial capital of "GLUE2ContactType" lowercased so the assignment is a valuereference.
gLUE2ContactType ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseExactMatch
