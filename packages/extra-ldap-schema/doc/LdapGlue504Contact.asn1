-- Object identifiers

id-at-gLUE2ContactID OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 6757 100 1 1 4 1 }
id-at-gLUE2ContactDetail OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 6757 100 1 1 4 2 }
id-at-gLUE2ContactType OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 6757 100 1 1 4 3 }
id-at-gLUE2ContactServiceForeignKey OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 6757 100 1 1 4 4 }
id-at-gLUE2ContactDomainForeignKey OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 6757 100 1 1 4 5 }
id-oc-gLUE2Contact OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 6757 100 1 1 4 }

-- Attribute types

-- initial capital of "GLUE2ContactID" lowercased so the assignment is a valuereference.
gLUE2ContactID ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseExactMatch
  SUBSTRINGS MATCHING RULE  caseExactSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"GLUE2ContactID"}
  LDAP-DESC                 "Globally unique ID"
  ID                        id-at-gLUE2ContactID }

-- initial capital of "GLUE2ContactDetail" lowercased so the assignment is a valuereference.
gLUE2ContactDetail ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseExactMatch
