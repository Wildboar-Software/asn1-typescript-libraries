-- Attribute types

-- OID written as RBACattributeType:1 and expanded with this file's objectidentifier macros.
rbacSessid ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"rbacSessid"}
  LDAP-DESC                 "RBAC Session ID"
  ID                        id-at-rbacSessid }

-- OID written as RBACattributeType:2 and expanded with this file's objectidentifier macros.
