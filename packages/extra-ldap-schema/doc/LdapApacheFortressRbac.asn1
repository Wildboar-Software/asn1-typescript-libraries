-- Object classes

-- OID written as RBACobjectClass:1 and expanded with this file's objectidentifier macros.
-- SUP was absent. RFC 4512 treats that as a subclass of top, so SUBCLASS OF { top } was added.
rbacSession OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { rbacSessid
                              | uid
                              | tenantid }
  MAY CONTAIN               { rbacUserDN
                              | rbacRoles
                              | rbacRoleConstraints }
  LDAP-NAME                 {"rbacSession"}
  LDAP-DESC                 "RBAC Session Object Class"
  ID                        id-oc-rbacSession }

-- OID written as RBACobjectClass:2 and expanded with this file's objectidentifier macros.
-- SUP was absent. RFC 4512 treats that as a subclass of top, so SUBCLASS OF { top } was added.
rbacPermission OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MAY CONTAIN               { rbacRoles
                              | rbacObjName
                              | rbacOpName
                              | uid }
  LDAP-NAME                 {"rbacPermission"}
  LDAP-DESC                 "RBAC Permission Object Class"
  ID                        id-oc-rbacPermission }

-- OID written as RBACobjectClass:3 and expanded with this file's objectidentifier macros.
-- SUP was absent. RFC 4512 treats that as a subclass of top, so SUBCLASS OF { top } was added.
rbacAudit OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MAY CONTAIN               { uid
                              | rbacAuditId
                              | rbacSessid
                              | rbacAuditOp
                              | rbacAuditRoles
                              | rbacAuditRequestedRoles
                              | rbacAuditObjects
                              | rbacAuditOperations
                              | rbacAuditResult
                              | rbacAuditResources
                              | rbacAuditProperties
                              | rbacAuditTimestamp
                              | rbacAuditMessages }
  LDAP-NAME                 {"rbacAudit"}
  LDAP-DESC                 "RBAC Audit Object Class"
  ID                        id-oc-rbacAudit }

-- OID written as RBACobjectClass:4 and expanded with this file's objectidentifier macros.
-- SUP was absent. RFC 4512 treats that as a subclass of top, so SUBCLASS OF { top } was added.
rbacContainer OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MAY CONTAIN               { commonName }
  LDAP-NAME                 {"rbacContainer"}
  LDAP-DESC                 "RBAC Container Object Class"
  ID                        id-oc-rbacContainer }
