-- Object classes

kopano-user OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MUST CONTAIN              { commonName }
  MAY CONTAIN               { kopanoQuotaOverride
                              | kopanoQuotaWarn
                              | kopanoQuotaSoft
                              | kopanoSendAsPrivilege
                              | kopanoQuotaHard
                              | kopanoAdmin
                              | kopanoSharedStoreOnly
                              | kopanoResourceType
                              | kopanoResourceCapacity
                              | kopanoAccount
                              | kopanoHidden
                              | kopanoAliases
                              | kopanoUserServer
                              | kopanoEnabledFeatures
                              | kopanoDisabledFeatures
                              | kopanoUserArchiveServers
                              | kopanoUserArchiveCouplings
                              | uidNumber }
  LDAP-NAME                 {"kopano-user"}
  LDAP-DESC                 "KOPANO: an user of Kopano"
  ID                        id-oc-kopano-user }

kopano-contact OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MUST CONTAIN              { commonName
                              | uidNumber }
  MAY CONTAIN               { kopanoSendAsPrivilege
                              | kopanoHidden
                              | kopanoAliases
                              | kopanoAccount }
  LDAP-NAME                 {"kopano-contact"}
  LDAP-DESC                 "KOPANO: a contact of Kopano"
  ID                        id-oc-kopano-contact }

kopano-group OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MUST CONTAIN              { commonName }
  MAY CONTAIN               { kopanoAccount
                              | kopanoHidden
                              | mail
                              | kopanoAliases
                              | kopanoSecurityGroup
                              | kopanoSendAsPrivilege
                              | gidNumber }
  LDAP-NAME                 {"kopano-group"}
  LDAP-DESC                 "KOPANO: a group of Kopano"
  ID                        id-oc-kopano-group }

kopano-company OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MUST CONTAIN              { organizationalUnitName }
  MAY CONTAIN               { kopanoAccount
                              | kopanoHidden
                              | kopanoViewPrivilege
                              | kopanoAdminPrivilege
                              | kopanoSystemAdmin
                              | kopanoQuotaOverride
                              | kopanoQuotaWarn
                              | kopanoUserDefaultQuotaOverride
                              | kopanoUserDefaultQuotaWarn
                              | kopanoUserDefaultQuotaSoft
                              | kopanoUserDefaultQuotaHard
                              | kopanoQuotaUserWarningRecipients
                              | kopanoQuotaCompanyWarningRecipients
                              | kopanoCompanyServer }
  LDAP-NAME                 {"kopano-company"}
  LDAP-DESC                 "KOPANO: a company of Kopano"
  ID                        id-oc-kopano-company }

kopano-server OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MUST CONTAIN              { commonName }
  MAY CONTAIN               { kopanoAccount
                              | kopanoHidden
                              | kopanoHttpPort
                              | kopanoSslPort
                              | kopanoFilePath
                              | kopanoContainsPublic
                              | kopanoProxyURL }
  LDAP-NAME                 {"kopano-server"}
  LDAP-DESC                 "KOPANO: a Kopano server"
  ID                        id-oc-kopano-server }

kopano-addresslist OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { commonName }
  MAY CONTAIN               { kopanoAccount
                              | kopanoHidden
                              | kopanoFilter
                              | kopanoBase }
  LDAP-NAME                 {"kopano-addresslist"}
  LDAP-DESC                 "KOPANO: a Kopano Addresslist"
  ID                        id-oc-kopano-addresslist }

kopano-dynamicgroup OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { commonName }
  MAY CONTAIN               { kopanoAccount
                              | kopanoHidden
                              | mail
                              | kopanoAliases
                              | kopanoFilter
                              | kopanoBase }
  LDAP-NAME                 {"kopano-dynamicgroup"}
  LDAP-DESC                 "KOPANO: a Kopano dynamic group"
  ID                        id-oc-kopano-dynamicgroup }
END