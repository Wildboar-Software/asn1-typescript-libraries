kopanoQuotaOverride ATTRIBUTE ::= {
  WITH SYNTAX               INTEGER
  EQUALITY MATCHING RULE    integerMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               integer.&id
  LDAP-NAME                 {"kopanoQuotaOverride"}
  LDAP-DESC                 "KOPANO: Override child quota"
  ID                        id-at-kopanoQuotaOverride }

