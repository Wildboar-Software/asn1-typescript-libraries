  WITH SYNTAX               UnboundedDirectoryString
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"gotoLastSystemLogin"}
  LDAP-DESC                 "Timestamp for a Users last System Login"
  ID                        id-at-gotoLastSystemLogin }

gotoLastSystem ATTRIBUTE ::= {
  WITH SYNTAX               DistinguishedName
  EQUALITY MATCHING RULE    distinguishedNameMatch
  LDAP-SYNTAX               dn.&id
  LDAP-NAME                 {"gotoLastSystem"}
  LDAP-DESC                 "The DN of the System where the Login was performed"
  ID                        id-at-gotoLastSystem }

-- This attribute declares neither a supertype nor a syntax.
gosaLoginRestriction ATTRIBUTE ::= {
  LDAP-NAME                 {"gosaLoginRestriction"}
  LDAP-DESC                 "Multivalue attribute to carry a number of allowed ips/subnets"
  ID                        id-at-gosaLoginRestriction }

gosaUserDefinedFilter ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"gosaUserDefinedFilter"}
  LDAP-DESC                 "A user defined filter"
  ID                        id-at-gosaUserDefinedFilter }

gosaWebDAVQuota ATTRIBUTE ::= {
  WITH SYNTAX               INTEGER
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               integer.&id
  LDAP-NAME                 {"gosaWebDAVQuota"}
  LDAP-DESC                 "Webdav share quota in KB"
  ID                        id-at-gosaWebDAVQuota }

academicTitle ATTRIBUTE ::= {
  WITH SYNTAX               UnboundedDirectoryString
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SUBSTRINGS MATCHING RULE  caseIgnoreSubstringsMatch
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"academicTitle"}
  LDAP-DESC                 "Field to represent the academic title"
  ID                        id-at-academicTitle }

gender ATTRIBUTE ::= {
  WITH SYNTAX               IA5String(SIZE (1..1))
  EQUALITY MATCHING RULE    caseIgnoreIA5Match
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               ia5String.&id
  LDAP-NAME                 {"gender", "sex"}
  LDAP-DESC                 "Gender: M for male, F for female"
  ID                        id-at-gender }

-- LDAP syntax length {10} rendered as DirectoryString{10}.
dateOfBirth ATTRIBUTE ::= {
  WITH SYNTAX               DirectoryString{10}
  EQUALITY MATCHING RULE    caseIgnoreMatch
  SINGLE VALUE              TRUE
  LDAP-SYNTAX               directoryString.&id
  LDAP-NAME                 {"dateOfBirth", "dob"}
  LDAP-DESC                 "Date of birth in ISO 8601 format"
  ID                        id-at-dateOfBirth }

acl ATTRIBUTE ::= {
  WITH SYNTAX               IA5String(SIZE (1..256))
  EQUALITY MATCHING RULE    caseIgnoreIA5Match
  SUBSTRINGS MATCHING RULE  caseIgnoreIA5SubstringsMatch
  LDAP-SYNTAX               ia5String.&id
  LDAP-NAME                 {"acl"}
  ID                        id-at-acl }

-- Object classes

-- disambiguated gosaObject to gosaObject-2 inside LdapGosaCoreGosaSamba3.
gosaObject-2 OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MUST CONTAIN              { gosaSubtreeACL }
  LDAP-NAME                 {"gosaObject"}
  LDAP-DESC                 "Class for GOsa settings (v2.7)"
  ID                        id-oc-gosaObject-2 }

gosaLockEntry OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { gosaUser
                              | gosaObject
                              | commonName }
  LDAP-NAME                 {"gosaLockEntry"}
  LDAP-DESC                 "Class for GOsa locking (v2.7)"
  ID                        id-oc-gosaLockEntry }

gosaCacheEntry OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { commonName }
  MAY CONTAIN               { gosaUser }
  LDAP-NAME                 {"gosaCacheEntry"}
  LDAP-DESC                 "Class for GOsa caching (v2.7)"
  ID                        id-oc-gosaCacheEntry }

gosaDepartment OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MUST CONTAIN              { organizationalUnitName
                              | description }
  MAY CONTAIN               { manager }
  LDAP-NAME                 {"gosaDepartment"}
  LDAP-DESC                 "Class to mark Departments for GOsa (v2.7)"
  ID                        id-oc-gosaDepartment }

gosaMailAccount OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MUST CONTAIN              { mail
                              | gosaMailServer
                              | gosaMailDeliveryMode }
  MAY CONTAIN               { gosaMailQuota
                              | gosaMailAlternateAddress
                              | gosaMailForwardingAddress
                              | gosaMailMaxSize
                              | gosaSpamSortLevel
                              | gosaSpamMailbox
                              | gosaVacationMessage
                              | gosaVacationStart
                              | gosaVacationStop
                              | gosaSharedFolderTarget
                              | acl }
  LDAP-NAME                 {"gosaMailAccount"}
  LDAP-DESC                 "Class to mark MailAccounts for GOsa (v2.7)"
  ID                        id-oc-gosaMailAccount }

gosaAccount OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MUST CONTAIN              { uid }
  MAY CONTAIN               { sambaLMPassword
                              | sambaNTPassword
                              | sambaPwdLastSet
                              | gosaDefaultPrinter
                              | gosaDefaultLanguage
                              | academicTitle
                              | personalTitle
                              | gosaHostACL
                              | dateOfBirth
                              | sambaBadPasswordCount
                              | sambaBadPasswordTime
                              | gender
                              | gotoLastSystemLogin
                              | gotoLastSystem
                              | gosaLoginRestriction }
  LDAP-NAME                 {"gosaAccount"}
  LDAP-DESC                 "Class for GOsa Accounts (v2.7)"
  ID                        id-oc-gosaAccount }

gosaHost OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MUST CONTAIN              { commonName }
  MAY CONTAIN               { description
                              | gosaService }
  LDAP-NAME                 {"gosaHost"}
  LDAP-DESC                 "Class for GOsa Hosts (v2.7)"
  ID                        id-oc-gosaHost }

gosaProxyAccount OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MUST CONTAIN              { gosaProxyAcctFlags }
  MAY CONTAIN               { gosaProxyID
                              | gosaProxyWorkingStart
                              | gosaProxyWorkingStop
                              | gosaProxyQuota
                              | gosaProxyQuotaPeriod }
  LDAP-NAME                 {"gosaProxyAccount"}
  LDAP-DESC                 "Class for GOsa Proxy settings (v2.7)"
  ID                        id-oc-gosaProxyAccount }

gosaApplication OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { commonName
                              | gosaApplicationExecute }
  MAY CONTAIN               { gosaApplicationName
                              | gosaApplicationIcon
                              | gosaApplicationFlags
                              | gosaApplicationMimeType
                              | gosaApplicationParameter
                              | gotoLogonScript
                              | description
                              | gosaApplicationCategory }
  LDAP-NAME                 {"gosaApplication"}
  LDAP-DESC                 "Class for GOsa applications (v2.7)"
  ID                        id-oc-gosaApplication }

gosaApplicationGroup OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MUST CONTAIN              { commonName }
  MAY CONTAIN               { gosaMemberApplication
                              | gosaApplicationParameter }
  LDAP-NAME                 {"gosaApplicationGroup"}
  LDAP-DESC                 "Class for GOsa application groups (v2.7)"
  ID                        id-oc-gosaApplicationGroup }

gosaUserTemplate OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MUST CONTAIN              { commonName }
  LDAP-NAME                 {"gosaUserTemplate"}
  LDAP-DESC                 "Class for GOsa User Templates (v2.7)"
  ID                        id-oc-gosaUserTemplate }

gosaGroupOfNames OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { commonName
                              | gosaGroupObjects }
  MAY CONTAIN               { member
                              | description }
  LDAP-NAME                 {"gosaGroupOfNames"}
  LDAP-DESC                 "GOsa object grouping (v2.7)"
  ID                        id-oc-gosaGroupOfNames }

gosaWebDAVAccount OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MUST CONTAIN              { commonName
                              | uid }
  MAY CONTAIN               { gosaWebDAVQuota }
  LDAP-NAME                 {"gosaWebDAVAccount"}
  LDAP-DESC                 "GOsa webdav enabling account (v2.7)"
  ID                        id-oc-gosaWebDAVAccount }

gosaIntranetAccount OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MUST CONTAIN              { commonName
                              | uid }
  MAY CONTAIN               { gosaDefaultLanguage }
  LDAP-NAME                 {"gosaIntranetAccount"}
  LDAP-DESC                 "GOsa Inatrent enabling account (v2.7)"
  ID                        id-oc-gosaIntranetAccount }

gosaAdministrativeUnit OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MUST CONTAIN              { gosaUnitTag }
  LDAP-NAME                 {"gosaAdministrativeUnit"}
  LDAP-DESC                 "Marker for administrational units (v2.7)"
  ID                        id-oc-gosaAdministrativeUnit }

gosaAdministrativeUnitTag OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MUST CONTAIN              { gosaUnitTag }
  LDAP-NAME                 {"gosaAdministrativeUnitTag"}
  LDAP-DESC                 "Marker for objects below administrational units (v2.7)"
  ID                        id-oc-gosaAdministrativeUnitTag }

gosaRole OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { gosaAclTemplate
                              | commonName }
  MAY CONTAIN               { description }
  LDAP-NAME                 {"gosaRole"}
  LDAP-DESC                 "ACL container to define roles (v2.7)"
  ID                        id-oc-gosaRole }

gosaAcl OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MUST CONTAIN              { gosaAclEntry }
  LDAP-NAME                 {"gosaAcl"}
  LDAP-DESC                 "ACL container to define single ACLs (v2.7)"
  ID                        id-oc-gosaAcl }

gosaSnapshotObject OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { gosaSnapshotType
                              | gosaSnapshotTimestamp
                              | gosaSnapshotDN
                              | gosaSnapshotData }
  MAY CONTAIN               { description }
  LDAP-NAME                 {"gosaSnapshotObject"}
  LDAP-DESC                 "Container object for undo and snapshot data (v2.7)"
  ID                        id-oc-gosaSnapshotObject }

gosaConfig OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { commonName }
  MAY CONTAIN               { gosaSetting }
  LDAP-NAME                 {"gosaConfig"}
  LDAP-DESC                 "Settings for gosa. Replaces parts of the gosa.conf. (v2.7)"
  ID                        id-oc-gosaConfig }

gotoSubmenuEntry OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { commonName }
  MAY CONTAIN               { gosaApplicationIcon
                              | gosaApplicationPriority }
  LDAP-NAME                 {"gotoSubmenuEntry"}
  LDAP-DESC                 "GOto - contains environment settings (v2.7)"
  ID                        id-oc-gotoSubmenuEntry }

gotoMenuEntry OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  MUST CONTAIN              { commonName }
  MAY CONTAIN               { gosaApplicationParameter
                              | gosaApplicationPriority }
  LDAP-NAME                 {"gotoMenuEntry"}
  LDAP-DESC                 "GOto - defines a menu entry (v2.7)"
  ID                        id-oc-gotoMenuEntry }

gosaProperties OBJECT-CLASS ::= {
  SUBCLASS OF               { top }
  KIND                      auxiliary
  MAY CONTAIN               { gosaUserDefinedFilter }
  LDAP-NAME                 {"gosaProperties"}
  LDAP-DESC                 "Store GOsa properties (v2.7)"
  ID                        id-oc-gosaProperties }
END