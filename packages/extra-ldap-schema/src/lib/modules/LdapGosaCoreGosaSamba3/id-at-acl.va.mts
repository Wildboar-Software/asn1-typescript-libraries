import {
    ObjectIdentifier as _OID,
    type OBJECT_IDENTIFIER
} from "@wildboar/asn1";

/**
 * @summary id_at_acl
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * id-at-acl OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 19414 2 1 651 }
 * ```
 * 
 * @constant
 */
export
const id_at_acl: OBJECT_IDENTIFIER = _OID.fromParts([
    1,
    3,
    6,
    1,
    4,
    1,
    19414,
    2,
    1,
    651,
]);

