import {
    ObjectIdentifier as _OID,
    type OBJECT_IDENTIFIER
} from "@wildboar/asn1";



/**
 * @summary id_igh
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * id-igh OBJECT IDENTIFIER ::= { id-pen 15347 }
 * ```
