import {
    ObjectIdentifier as _OID,
    type OBJECT_IDENTIFIER
} from "@wildboar/asn1";



/**
 * @summary id_oc_nationalObject
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * id-oc-nationalObject OBJECT IDENTIFIER ::= { 2 6 6 5 2 6 19 }
 * ```
 * 
 * @constant
 */
export
const id_oc_nationalObject: OBJECT_IDENTIFIER = _OID.fromParts([
    2,
    6,
    6,
    5,
    2,
    6,
    19,
]);

