import {
    ObjectIdentifier as _OID,
    type OBJECT_IDENTIFIER
} from "@wildboar/asn1";



/**
 * @summary id_at_iat
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * id-at-iat OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 48710 1 3 142 }
 * ```
 * 
 * @constant
 */
export
const id_at_iat: OBJECT_IDENTIFIER = _OID.fromParts([
    1,
    3,
    6,
    1,
    4,
    1,
    48710,
    1,
    3,
    142,
]);

