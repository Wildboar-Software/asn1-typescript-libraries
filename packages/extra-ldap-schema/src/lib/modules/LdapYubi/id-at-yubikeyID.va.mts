import {
    ObjectIdentifier as _OID,
    type OBJECT_IDENTIFIER
} from "@wildboar/asn1";



/**
 * @summary id_at_yubikeyID
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * id-at-yubikeyID OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 31622 999 1 1 }
 * ```
 * 
 * @constant
 */
export
const id_at_yubikeyID: OBJECT_IDENTIFIER = _OID.fromParts([
    1,
    3,
    6,
    1,
    4,
    1,
    31622,
    999,
    1,
    1,
]);

