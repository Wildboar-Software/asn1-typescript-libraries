import {
    ObjectIdentifier as _OID,
    type OBJECT_IDENTIFIER
} from "@wildboar/asn1";

/**
 * @summary id_at_rdn
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * id-at-rdn OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 4203 666 100 121 }
 * ```
 * 
 * @constant
 */
export
const id_at_rdn: OBJECT_IDENTIFIER = _OID.fromParts([
    1,
    3,
    6,
    1,
    4,
    1,
    4203,
    666,
    100,
    121,
]);

