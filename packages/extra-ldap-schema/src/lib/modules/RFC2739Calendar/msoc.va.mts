import {
    ObjectIdentifier as _OID,
    type OBJECT_IDENTIFIER
} from "@wildboar/asn1";



/**
 * @summary msoc
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * msoc OBJECT IDENTIFIER ::= { 1 2 840 113556 1 5 }
 * ```
 * 
 * @constant
 */
export
const msoc: OBJECT_IDENTIFIER = _OID.fromParts([
    1,
    2,
    840,
    113556,
    1,
    5,
]);

