import {
    ObjectIdentifier as _OID,
    type OBJECT_IDENTIFIER
} from "@wildboar/asn1";

/**
 * @summary msat
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * msat OBJECT IDENTIFIER ::= { 1 2 840 113556 1 4 }
 * ```
 * 
 * @constant
 */
export
const msat: OBJECT_IDENTIFIER = _OID.fromParts([
    1,
    2,
    840,
    113556,
    1,
    4,
]);

