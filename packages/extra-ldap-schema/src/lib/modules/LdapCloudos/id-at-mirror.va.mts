import {
    ObjectIdentifier as _OID,
    type OBJECT_IDENTIFIER
} from "@wildboar/asn1";



/**
 * @summary id_at_mirror
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * id-at-mirror OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 46577 100 15 }
 * ```
 * 
 * @constant
 */
export
const id_at_mirror: OBJECT_IDENTIFIER = _OID.fromParts([
    1,
    3,
    6,
    1,
    4,
    1,
    46577,
    100,
    15,
]);

