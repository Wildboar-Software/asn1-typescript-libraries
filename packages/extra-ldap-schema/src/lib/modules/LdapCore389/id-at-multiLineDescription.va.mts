import {
    ObjectIdentifier as _OID,
    type OBJECT_IDENTIFIER
} from "@wildboar/asn1";



/**
 * @summary id_at_multiLineDescription
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * id-at-multiLineDescription OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 250 1 2 }
 * ```
 * 
 * @constant
 */
export
const id_at_multiLineDescription: OBJECT_IDENTIFIER = _OID.fromParts([
    1,
    3,
    6,
    1,
    4,
    1,
    250,
    1,
    2,
]);

