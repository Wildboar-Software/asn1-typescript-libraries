import {
    ObjectIdentifier as _OID,
    type OBJECT_IDENTIFIER
} from "@wildboar/asn1";



/**
 * @summary id_at_serialNumber
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * id-at-serialNumber                        OBJECT IDENTIFIER ::= {id-at 5}
 * ```
 * 
 * @constant
 */
export
const id_at_serialNumber: OBJECT_IDENTIFIER = _OID.fromParts([
    5,
], id_at);

