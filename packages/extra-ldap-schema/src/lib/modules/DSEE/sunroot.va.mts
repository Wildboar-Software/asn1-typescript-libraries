import {
    ObjectIdentifier as _OID,
    type OBJECT_IDENTIFIER
} from "@wildboar/asn1";

/**
 * @summary sunroot
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * sunroot         OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 42 }
 * ```
 * 
 * @constant
 */
export
const sunroot: OBJECT_IDENTIFIER = _OID.fromParts([
    1,
    3,
    6,
    1,
    4,
    1,
    42,
]);

