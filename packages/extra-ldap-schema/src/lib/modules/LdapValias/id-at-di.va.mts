import {
    ObjectIdentifier as _OID,
    type OBJECT_IDENTIFIER
} from "@wildboar/asn1";

/**
 * @summary id_at_di
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * id-at-di OBJECT IDENTIFIER ::= { 1 3 6 4 1 31234 1 1 2 }
 * ```
 * 
 * @constant
 */
export
const id_at_di: OBJECT_IDENTIFIER = _OID.fromParts([
    1,
    3,
    6,
    4,
    1,
    31234,
    1,
    1,
    2,
]);

/* eslint-enable */
