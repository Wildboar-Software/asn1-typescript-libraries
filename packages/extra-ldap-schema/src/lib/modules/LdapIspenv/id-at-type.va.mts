import {
    ObjectIdentifier as _OID,
    type OBJECT_IDENTIFIER
} from "@wildboar/asn1";



/**
 * @summary id_at_type
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * id-at-type OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 11048 1 1 1 15 }
 * ```
 * 
 * @constant
 */
export
const id_at_type: OBJECT_IDENTIFIER = _OID.fromParts([
    1,
    3,
    6,
    1,
    4,
    1,
    11048,
    1,
    1,
    1,
    15,
]);

