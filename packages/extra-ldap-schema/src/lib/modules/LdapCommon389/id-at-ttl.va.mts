/* eslint-disable */
import {
    ObjectIdentifier as _OID,
    type OBJECT_IDENTIFIER
} from "@wildboar/asn1";

/**
 * @summary id_at_ttl
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * id-at-ttl OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 250 1 60 }
 * ```
 * 
 * @constant
 */
export
const id_at_ttl: OBJECT_IDENTIFIER = _OID.fromParts([
    1,
    3,
    6,
    1,
    4,
    1,
    250,
    1,
    60,
]);

/* eslint-enable */
