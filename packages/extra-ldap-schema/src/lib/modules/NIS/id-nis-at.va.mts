import {
    ObjectIdentifier as _OID,
    type OBJECT_IDENTIFIER
} from "@wildboar/asn1";

/**
 * @summary id_nis_at
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * id-nis-at       OBJECT IDENTIFIER ::= { 1 3 6 1 1 1 1 }
 * ```
 * 
 * @constant
 */
export
const id_nis_at: OBJECT_IDENTIFIER = _OID.fromParts([
    1,
    3,
    6,
    1,
    1,
    1,
    1,
]);

