import {
    ObjectIdentifier as _OID,
    type OBJECT_IDENTIFIER
} from "@wildboar/asn1";



/**
 * @summary id_nisSchema
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * id-nisSchema    OBJECT IDENTIFIER ::= {
 *     iso(1) org(3) dod(6) internet(1) directory(1) nisSchema(1) }
 * ```
 * 
 * @constant
 */
export
const id_nisSchema: OBJECT_IDENTIFIER = _OID.fromParts([
    /* iso */ 1,
    /* org */ 3,
    /* dod */ 6,
    /* internet */ 1,
    /* directory */ 1,
    /* nisSchema */ 1,
]);

