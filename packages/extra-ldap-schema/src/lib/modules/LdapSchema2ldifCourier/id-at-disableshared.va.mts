import {
    ObjectIdentifier as _OID,
    type OBJECT_IDENTIFIER
} from "@wildboar/asn1";



/**
 * @summary id_at_disableshared
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * id-at-disableshared OBJECT IDENTIFIER ::= { 1 3 6 1 4 1 10018 1 1 13 }
 * ```
 * 
 * @constant
 */
export
const id_at_disableshared: OBJECT_IDENTIFIER = _OID.fromParts([
    1,
    3,
    6,
    1,
    4,
    1,
    10018,
    1,
    1,
    13,
]);

