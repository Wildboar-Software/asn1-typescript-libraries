{
  "name": "gn",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/gn/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "dependsOn": ["^build"],
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/packages/gn",
        "tsConfig": "packages/gn/tsconfig.lib.json",
        "packageJson": "packages/gn/package.json",
        "main": "packages/gn/src/index.ts",
        "assets": [
          "packages/gn/*.md",
          "packages/gn/LICENSE.txt",
          "packages/gn/package.json"
        ]
      }
    }
  }
}
