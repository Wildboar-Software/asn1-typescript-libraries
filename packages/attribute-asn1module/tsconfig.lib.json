{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "isolatedDeclarations": true,
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "types": [
      "node"
    ],
    "strictNullChecks": true,
    "rootDir": "."
  },
  "exclude": ["**/*.spec.mts"],
  "include": [
    "**/*.mts"
  ],
  "references": [
    {
      "path": "../acse/tsconfig.lib.json"
    },
    {
      "path": "../cmip/tsconfig.lib.json"
    },
    {
      "path": "../dn/tsconfig.lib.json"
    }
  ]
}
