{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "rootDir": ".",
    "strictNullChecks": true
  },
  "exclude": [
    "**/*.spec.mts",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx"
  ],
  "include": [
    "**/*.mts"
  ],
  "references": [
    {
      "path": "../presentation-address/tsconfig.lib.json"
    },
    {
      "path": "../or-address/tsconfig.lib.json"
    },
    {
      "path": "../dn/tsconfig.lib.json"
    },
    {
      "path": "../gn/tsconfig.lib.json"
    }
  ]
}
