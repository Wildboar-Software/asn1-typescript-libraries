import {
    ObjectIdentifier as _OID,
    OBJECT_IDENTIFIER
} from "@wildboar/asn1";



/**
 * @summary id_icao
 * @description
 * 
 * ### ASN.1 Definition:
 * 
 * ```asn1
 * id-icao                                 OBJECT IDENTIFIER ::= {2 23 136 }
 * ```
 * 
 * @constant
 */
export
const id_icao: OBJECT_IDENTIFIER = _OID.fromParts([
    2,
    23,
    136,
]);

/* eslint-enable */
