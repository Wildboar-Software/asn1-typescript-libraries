{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "types": [
      "node"
    ],
    "strictNullChecks": true,
    "erasableSyntaxOnly": true,
    "rootDir": "."
  },
  "include": [
    "src/**/*.mts",
  ],
  "references": [
    {
      "path": "../presentation-address/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.mts",
    "src/**/*.spec.mts",
    "src/**/*.test.mjs",
    "src/**/*.spec.mjs",
  ]
}