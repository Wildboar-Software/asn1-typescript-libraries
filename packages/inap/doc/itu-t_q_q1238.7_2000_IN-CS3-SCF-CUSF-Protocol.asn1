-- Operation package definition
-- activityTestPackage   OPERATION-PACKAGE
-- This package is described in Q.1238.2.
cusfTDPSpecificInvocationPackage OPERATION-PACKAGE ::=
{
  CONSUMER INVOKES
    {activationReceivedAndAuthorized | componentReceived |
      associationReleaseRequested}
  ID                id-package-cusfTDPSpecificInvocation
}

cusfTDPGenericInvocationPackage OPERATION-PACKAGE ::= {
  CONSUMER INVOKES  {initialAssociationDP}
  ID                id-package-cusfTDPGenericInvocation
}

cusfDPSpecificEventHandlingPackage OPERATION-PACKAGE ::=
{
  CONSUMER INVOKES  {requestReportBCUSMEvent}
  SUPPLIER INVOKES
    {componentReceived | associationReleaseRequested}
  ID                id-package-cusfDPSpecificEventHandling
}

cusfGenericEventHandlingPackage OPERATION-PACKAGE ::=
{
  CONSUMER INVOKES  {requestReportBCUSMEvent}
  SUPPLIER INVOKES  {eventReportBCUSM}
  ID                id-package-cusfGenericEventHandling
}

cusfComponentHandlingPackage OPERATION-PACKAGE ::= {
  CONSUMER INVOKES  {sendComponent}
  ID                id-package-cusfComponentHandling
}

cusfSCFInitiationPackage OPERATION-PACKAGE ::= {
  CONSUMER INVOKES  {initiateAssociation}
  ID                id-package-cusfSCFInitiation
}

cusfContinuePackage OPERATION-PACKAGE ::= {
  CONSUMER INVOKES  {continueAssociation}
  ID                id-package-cusfContinue
}

cusfConnectPackage OPERATION-PACKAGE ::= {
  CONSUMER INVOKES  {connectAssociation}
  ID                id-package-cusfConnect
}

cusfReleasePackage OPERATION-PACKAGE ::= {
  CONSUMER INVOKES  {releaseAssociation}
  ID                id-package-cusfRelease
}

