-- Contracts definition
cs3scfcusfDPSpecificContract CONTRACT ::= {
  INITIATOR CONSUMER OF
    {cusfSCFInitiationPackage |
      activityTestPackage |
      cusfDPSpecificEventHandlingPackage
      | cusfComponentHandlingPackage |
      cusfContinuePackage |
      cusfConnectPackage |
      cusfReleasePackage |
      uSIHandlingPackage}
  ID                     id-contract-cs3scfcusfDPSpecific
}

cs3cusfscfDPSpecificContract CONTRACT ::= {
  INITIATOR CONSUMER OF
    {cusfTDPSpecificInvocationPackage}
  RESPONDER CONSUMER OF
    {activityTestPackage |
      cusfDPSpecificEventHandlingPackage
      | cusfComponentHandlingPackage |
      cusfContinuePackage |
      cusfConnectPackage |
      cusfReleasePackage |
      uSIHandlingPackage}
  ID                     id-contract-cs3cusfscfDPSpecific
}

