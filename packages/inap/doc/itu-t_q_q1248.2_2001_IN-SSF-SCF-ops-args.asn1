  routeList                    [9]  RouteList OPTIONAL,
  travellingClassMark          [10]  TravellingClassMark OPTIONAL,
  extensions                   [11]  Extensions OPTIONAL,
  carrier                      [12]  Carrier OPTIONAL,
  ...
}

